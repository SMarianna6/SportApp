@model SportLab.Models.ProductCategoryViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Products</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <form asp-controller="Products" asp-action="Index" method="get" class="card card-body mb-4 bg-light">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Category:</label>
                <select asp-for="ProductCategory" asp-items="Model.Categories" class="form-select">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Name:</label>
                <input type="text" asp-for="SearchString" class="form-control" placeholder="Search by product name..." />
            </div>
            <div class="col-md-2">
                <input type="submit" value="Filter" class="btn btn-dark w-100" />
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].Category)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].Price)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].StockQuantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].Rating)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Products![0].PhotoUrl)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products != null && Model.Products.Any())
                {
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td class="fw-bold">
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Category)</span>
                            </td>
                            <td class="text-truncate" style="max-width: 250px;">
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.StockQuantity)
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark">@Html.DisplayFor(modelItem => item.Rating)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PhotoUrl))
                                {
                                    <img src="@item.PhotoUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            No products found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

