@{
    ViewData["Title"] = "SportLab Shop";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>SportLab Shop</h2>
        <p class="text-muted">Premium nutrition, gear, and accessories.</p>
        <span class="badge bg-warning text-dark">Promo: SPORT10 for 10% off</span>
    </div>

    <div class="mb-4">
        <button class="btn btn-dark">All Products</button>
        <button class="btn btn-outline-dark">Nutrition</button>
        <button class="btn btn-outline-dark">Accessories</button>
        <button class="btn btn-outline-dark">Apparel</button>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1579722821273-0f6c7d44362f?w=400&h=300&fit=crop" class="card-img-top" alt="Protein">
                <div class="card-body text-center">
                    <p class="text-muted small mb-1">Nutrition</p>
                    <h5 class="card-title">Whey Protein Isolate</h5>
                    <p class="card-text small">Vanilla flavor, 30 servings.</p>
                    <h4 class="fw-bold">$45.00</h4>
                    <button class="btn btn-primary w-100" onclick="alert('Added!')">Add to Cart</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1693996045838-980674653385?w=400&h=300&fit=crop" class="card-img-top" alt="Classic Shaker">
                <div class="card-body text-center">
                    <p class="text-muted small mb-1">Accessories</p>
                    <h5 class="card-title">SportLab Classic Shaker</h5>
                    <p class="card-text small">BPA-free shaker with a leak-proof lid.</p>
                    <h4 class="fw-bold">$12.50</h4>
                    <button class="btn btn-primary w-100" onclick="alert('Added!')">Add to Cart</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1593095948071-474c5cc2989d?w=400&h=300&fit=crop" class="card-img-top" alt="BCAA">
                <div class="card-body text-center">
                    <p class="text-muted small mb-1">Nutrition</p>
                    <h5 class="card-title">Essential BCAA Aminos</h5>
                    <p class="card-text small">Berry blast flavor hydration.</p>
                    <h4 class="fw-bold">$29.99</h4>
                    <button class="btn btn-primary w-100" onclick="alert('Added!')">Add to Cart</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=400&h=300&fit=crop" class="card-img-top" alt="Gym Bag">
                <div class="card-body text-center">
                    <p class="text-muted small mb-1">Apparel</p>
                    <h5 class="card-title">Elite Duffel Gym Bag</h5>
                    <p class="card-text small">Water-resistant bag for gear.</p>
                    <h4 class="fw-bold">$42.00</h4>
                    <button class="btn btn-primary w-100" onclick="alert('Added!')">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</div>