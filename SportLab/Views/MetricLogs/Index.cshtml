@model IEnumerable<SportLab.Models.MetricLog>
@using System.Globalization

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Progress";
}

<div class="container p-4 text-white">
    <h2>My Progress</h2>
    <hr class="border-secondary" />

    <div class="row mt-4">
        <div class="col-lg-7 mb-4">
            <div class="card bg-dark p-4 shadow-sm border-secondary h-100">
                <h4 class="mb-4">Weight Chart</h4>
                <div style="height: 250px; border-left: 2px solid #6c757d; border-bottom: 2px solid #6c757d; padding: 10px;">
                    @{
                        var pointsList = new List<string>();
                        if (Model != null && Model.Any())
                        {
                            List<SportLab.Models.MetricLog> logsList = Model.ToList();
                            float maxW = logsList.Max(m => m.Weight);
                            float minW = logsList.Min(m => m.Weight);
                            float diff = (maxW - minW) == 0 ? 1 : (maxW - minW);
            
                            int width = 300;
                            int height = 230;
            
                            for (int i = 0; i < logsList.Count; i++)
                            {
                                int x = logsList.Count == 1 ? width / 2 : (i * width) / (logsList.Count - 1);
                                float normalizedY = (logsList[i].Weight - minW) / diff;
                                int y = 10 + (int)((1 - normalizedY) * height);
                                pointsList.Add($"{x},{y}");
                            }
                        }
                        var pointsString = string.Join(" ", pointsList);
                    }

                    <svg viewBox="0 0 300 250" width="100%" height="100%" preserveAspectRatio="none">
                        @if (Model != null && Model.Any())
                        {
                            <polyline fill="none" stroke="#AAFF00" stroke-width="3" points="@pointsString" />
                        }
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-lg-5 mb-4">
            <div class="card bg-dark p-4 shadow-sm border-secondary h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">History</h4>
                    <a asp-controller="MetricLogs" asp-action="Create" class="btn btn-primary btn-sm fw-bold px-3">+ Log Weight</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mt-2">
                        <thead>
                            <tr class="text-secondary">
                                <th>Date</th>
                                <th>Weight</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No progress logged yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td class="text-nowrap">@log.RecordDate.ToString("MMM d", new CultureInfo("en-US"))</td>
                                        <td class="fw-bold text-nowrap">@log.Weight kg</td>
                                        <td class="text-white small">@(string.IsNullOrEmpty(log.Notes) ? "-" : log.Notes)</td>
                                        <td>
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-controller="MetricLogs" asp-action="Edit" asp-route-id="@log.Id" class="btn btn-sm btn-outline-light">Edit</a>
                                                <form asp-controller="MetricLogs" asp-action="Delete" asp-route-id="@log.Id" method="post" onsubmit="return confirm('Delete this record?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>