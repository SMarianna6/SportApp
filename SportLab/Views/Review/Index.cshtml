@{
    ViewData["Title"] = "Client Reviews";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">What Our Clients Say</h2>
    <p class="text-center text-muted mb-5">Real stories from our fitness community.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <div class="text-warning mb-2">★★★★★</div>
                    <h5 class="fw-bold">Best gym in the city!</h5>
                    <p class="card-text text-muted">Spacious, clean, and never feels overcrowded even during peak hours. The equipment is top-notch.</p>
                    <p class="mb-0 fw-bold small">- Anton P.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <div class="text-warning mb-2">★★★★★</div>
                    <h5 class="fw-bold">Amazing trainers</h5>
                    <p class="card-text text-muted">Iryna Boyko is a phenomenal powerlifting coach. She completely transformed my approach to heavy weights.</p>
                    <p class="mb-0 fw-bold small">- Olena M.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <div class="text-warning mb-2">★★★★☆</div>
                    <h5 class="fw-bold">Great shop selection</h5>
                    <p class="card-text text-muted">Love that I can buy protein and aminos right at the front desk. Very convenient after a hard workout.</p>
                    <p class="mb-0 fw-bold small">- Dmytro S.</p>
                </div>
            </div>
        </div>
    </div>
</div>