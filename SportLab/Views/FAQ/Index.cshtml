@model IEnumerable<SportLab.Models.FAQ>

@{
    ViewData["Title"] = "FAQ - Frequently Asked Questions";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container my-5">
    <!-- Header Hero -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-2 rounded-pill mb-2">
            <i class="bi bi-question-circle me-1"></i> Help & Support Center
        </span>
        <h1 class="display-5 fw-bold text-dark mb-3">Frequently Asked Questions</h1>
        <p class="lead text-muted mx-auto" style="max-width: 680px;">
            Everything you need to know about SportLab memberships, club rules, personal training, and our athletic store.
        </p>

        <!-- Live FAQ Search Box -->
        <div class="row justify-content-center mt-4">
            <div class="col-md-7 col-lg-6">
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="faqSearchInput" class="form-control border-0 ps-2" placeholder="Search questions or keywords (e.g. freeze, towel, 24/7)..." />
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Accordion Section -->
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="accordion accordion-flush bg-white rounded-4 border shadow-sm p-3 p-md-4" id="faqAccordion">
                @{
                    int index = 0;
                    foreach (var item in Model)
                    {
                        var collapseId = $"faqCollapse{item.Id}";
                        var headingId = $"faqHeading{item.Id}";
                        var isFirst = index == 0;
                        index++;

                        <div class="accordion-item border-0 mb-3 rounded-3 overflow-hidden faq-item" data-text="@item.Question.ToLower() @item.Answer.ToLower()">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(isFirst ? "" : "collapsed") fw-bold text-dark bg-light rounded-3 py-3 px-4 shadow-none" 
                                        type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#@collapseId" 
                                        aria-expanded="@(isFirst ? "true" : "false")" 
                                        aria-controls="@collapseId">
                                    <i class="bi bi-patch-question-fill text-primary me-3 fs-5"></i>
                                    @item.Question
                                </button>
                            </h2>
                            <div id="@collapseId" 
                                 class="accordion-collapse collapse @(isFirst ? "show" : "")" 
                                 aria-labelledby="@headingId" 
                                 data-bs-parent="#faqAccordion">
                                <div class="accordion-body px-4 py-3 text-muted" style="line-height: 1.65; font-size: 0.98rem;">
                                    @item.Answer
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Empty Search Results State -->
            <div class="text-center py-5 d-none" id="faqNoResults">
                <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold">No matching questions found</h5>
                <p class="text-muted small">Try searching for other keywords or reach out to our team directly.</p>
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4" onclick="document.getElementById('faqSearchInput').value=''; document.getElementById('faqSearchInput').dispatchEvent(new Event('input'));">
                    Clear Search
                </button>
            </div>

            <!-- Support Banner -->
            <div class="card mt-5 border-0 shadow-sm rounded-4 text-center p-4 p-md-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
                <div class="display-6 text-warning mb-2"><i class="bi bi-headset"></i></div>
                <h3 class="fw-bold mb-2">Still have questions?</h3>
                <p class="text-white-50 mx-auto mb-4" style="max-width: 500px;">
                    Our friendly fitness desk team is available every day to assist you with workouts, memberships, and facility tours.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="mailto:support@sportlab.ua" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-envelope me-1"></i> Contact Support
                    </a>
                    <a asp-controller="Tariff" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-card-checklist me-1"></i> View Tariffs
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("faqSearchInput");
        const items = document.querySelectorAll(".faq-item");
        const noResults = document.getElementById("faqNoResults");
        const accordion = document.getElementById("faqAccordion");

        searchInput.addEventListener("input", function () {
            const query = this.value.trim().toLowerCase();
            let matches = 0;

            items.forEach(item => {
                const text = item.getAttribute("data-text") || "";
                if (query === "" || text.includes(query)) {
                    item.classList.remove("d-none");
                    matches++;
                } else {
                    item.classList.add("d-none");
                }
            });

            if (matches === 0) {
                noResults.classList.remove("d-none");
                accordion.classList.add("d-none");
            } else {
                noResults.classList.add("d-none");
                accordion.classList.remove("d-none");
            }
        });
    });
</script>
}