@{
    ViewData["Title"] = "FAQ";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4 text-center">Frequently Asked Questions</h2>
            <hr class="mb-5">

            <div class="mb-4">
                <h5 class="fw-bold">What are your opening hours?</h5>
                <p class="text-muted">We are open from 8:00 AM to 10:00 PM for Basic members. Pro and Elite members have 24/7 access using their smart cards.</p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Do I need to bring my own towel?</h5>
                <p class="text-muted">No, complimentary fresh towels are provided at the reception for all members upon entry.</p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Can I pause my membership?</h5>
                <p class="text-muted">Yes. Pro and Elite members can freeze their membership for up to 30 days per year for free through the client dashboard.</p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Are group classes included in the basic tariff?</h5>
                <p class="text-muted">The Basic tariff includes gym access only. Group classes are fully included in the Pro and Elite memberships.</p>
            </div>
            
            <div class="text-center mt-5">
                <p class="text-muted">Still have questions?</p>
                <a href="mailto:support@sportlab.ua" class="btn btn-outline-dark">Contact Support</a>
            </div>
        </div>
    </div>
</div>