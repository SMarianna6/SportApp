@model SportLab.Models.User

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="min-h-screen bg-[#1a1a1a] font-sans text-[#F2F2F4]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

            <aside class="lg:col-span-3">
                <div class="relative overflow-hidden bg-[#333333] px-6 pb-6 pt-9 text-center ring-1 ring-white/10 lg:sticky lg:top-6">
                    <div class="absolute inset-x-0 top-0 h-1 bg-[#AAFF00]"></div>

                    <div class="relative mx-auto h-28 w-28">
                        <div class="absolute -inset-1 rounded-full bg-[#AAFF00]/30 blur-md"></div>
                        <img id="profile-avatar" src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/images/default-avatar.png") : Url.Content(Model.AvatarUrl))" alt="Profile photo" class="relative h-28 w-28 rounded-full object-cover ring-2 ring-[#AAFF00] ring-offset-4 ring-offset-[#333333]">
                    </div>

                    <div class="mt-6 flex flex-col items-center">
                        <!-- INLINE NAME EDIT -->
                        <div class="flex items-center gap-2 max-w-full">
                            <h2 id="profile-name" class="max-w-full break-words text-2xl font-black uppercase leading-none tracking-tighter text-white">@Model.Name</h2>
                            <button id="name-edit-btn" type="button" aria-label="Edit name" class="shrink-0 rounded-md p-1.5 text-white/50 transition-colors hover:text-[#AAFF00] focus:outline-none focus:ring-2 focus:ring-[#AAFF00]">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                                </svg>
                            </button>
                        </div>
                        <!-- INLINE NAME EDITOR (hidden by default) -->
                        <div id="name-editor" class="hidden mt-2 w-full">
                            <input id="name-input" type="text" value="@Model.Name" maxlength="100" class="w-full border border-white/15 bg-[#1a1a1a] px-3 py-2 text-sm text-white outline-none transition-colors focus:border-[#AAFF00]">
                            <div class="mt-2 flex gap-2">
                                <button id="save-name-btn" type="button" class="flex-1 bg-[#AAFF00] px-3 py-2 text-xs font-black uppercase tracking-widest text-[#1a1a1a] transition-colors hover:bg-[#c1ff4d] disabled:cursor-not-allowed disabled:opacity-50">Save</button>
                                <button id="cancel-name-btn" type="button" class="flex-1 border border-white/20 px-3 py-2 text-xs font-black uppercase tracking-widest text-white transition-colors hover:border-white/60">Cancel</button>
                            </div>
                        </div>
                        <p id="name-message" class="mt-2 min-h-4 text-xs font-bold" aria-live="polite"></p>
                        <p id="subscription-plan-sidebar" class="mt-3 bg-[#7D51FE] px-2 py-1 text-[11px] font-bold uppercase leading-none tracking-widest text-white">Loading membership...</p>
                        <span class="mt-3 inline-flex items-center gap-2 bg-[#AAFF00]/10 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-[#AAFF00] ring-1 ring-[#AAFF00]/30">
                            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#AAFF00]"></span>
                            Account: Active
                        </span>
                    </div>

                    <div class="border-t border-white/10 pt-5">
                        @Html.AntiForgeryToken()
                        <div class="mt-2">
                            <input type="file" id="avatar-input" accept=".jpg,.jpeg,.png,.webp" hidden>
                            <div class="flex flex-col gap-2 sm:flex-row lg:flex-col">
                                <button type="button" id="change-avatar-btn" class="flex-1 border border-[#AAFF00] px-4 py-3 text-xs font-black uppercase tracking-widest text-[#AAFF00] transition-colors hover:bg-[#AAFF00]/10 disabled:cursor-not-allowed disabled:opacity-50">Change photo</button>
                                <button type="button" id="remove-avatar-btn" class="flex-1 border border-transparent px-4 py-3 text-xs font-black uppercase tracking-widest text-[#FF4D4D] transition-colors hover:bg-[#FF4D4D]/10 disabled:cursor-not-allowed disabled:opacity-50 @(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "hidden" : "")">Remove photo</button>
                            </div>
                            <p id="avatar-message" class="mt-3 min-h-4 text-xs font-bold uppercase tracking-wider" aria-live="polite"></p>
                        </div>
                    </div>
                </div>
            </aside>

            <main class="space-y-6 lg:col-span-9">
                <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl">Client Dashboard</h1>

                <section aria-label="Membership" class="relative overflow-hidden border-l-4 border-[#AAFF00] bg-gradient-to-r from-[#AAFF00]/15 via-[#333333] to-[#333333] p-6 ring-1 ring-white/10">
                    <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[#AAFF00]/10 blur-3xl"></div>
                    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center bg-[#7D51FE]/20 text-[#7D51FE] ring-1 ring-[#7D51FE]/40">
                                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7z"/><path d="M5 20h14"/></svg>
                            </div>
                            <div>
                                <h2 id="subscription-plan" class="text-xl font-black uppercase tracking-tighter text-white">Loading membership...</h2>
                                <p id="subscription-valid-until" class="mt-1 text-xs uppercase tracking-widest text-[#F2F2F4]/60">Checking subscription...</p>
                            </div>
                        </div>
                        <!-- Added ID here for dynamic text changes -->
                        <a id="renew-btn" asp-controller="Tariff" asp-action="Index" class="inline-block bg-[#AAFF00] px-8 py-3 text-center text-xs font-black uppercase tracking-widest text-[#1a1a1a] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(170,255,0,0.3)]">Renew</a>
                    </div>
                </section>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <section aria-labelledby="next-workout" class="flex flex-col bg-[#333333] p-6 ring-1 ring-white/10 transition-all duration-300 hover:ring-[#AAFF00]/40">
                        <h2 id="next-workout" class="text-lg font-black uppercase tracking-tighter text-white">Next Workout</h2>
                        <div id="next-workout-content" class="mt-5 flex-1">
                            <p class="text-sm text-[#F2F2F4]/50">Loading your next workout...</p>
                        </div>
                        <button type="button" id="cancel-booking-btn" class="mt-6 hidden w-full border border-[#FF4D4D]/50 px-4 py-3 text-xs font-black uppercase tracking-widest text-[#FF4D4D] transition-all duration-300 hover:bg-[#FF4D4D] hover:text-white disabled:cursor-not-allowed disabled:opacity-50">Cancel Booking</button>
                        <p id="booking-message" class="mt-3 min-h-4 text-xs font-bold" aria-live="polite"></p>
                    </section>

                    <section aria-labelledby="recent-orders" class="bg-[#333333] p-6 ring-1 ring-white/10 transition-all duration-300 hover:ring-[#AAFF00]/40">
                        <h2 id="recent-orders" class="text-lg font-black uppercase tracking-tighter text-white">Recent Orders</h2>
                        <ul id="recent-orders-list" class="mt-5 divide-y divide-white/10">
                            <li class="py-4 text-sm text-[#F2F2F4]/50">Loading your orders...</li>
                        </ul>
                    </section>
                </div>

                <section aria-labelledby="weight-tracker" class="bg-[#333333] p-6 ring-1 ring-white/10">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <h2 id="weight-tracker" class="text-lg font-black uppercase tracking-tighter text-white">Weight Tracker</h2>
                        <div class="flex flex-col gap-2 sm:flex-row">
                            <input id="weight-input" type="number" min="1" max="500" step="0.1" placeholder="Weight (kg)" class="w-full border border-white/20 bg-[#1a1a1a] px-4 py-2 text-sm text-white outline-none focus:border-[#AAFF00] sm:w-36">
                            <button type="button" id="add-weight-btn" class="inline-flex items-center justify-center gap-2 border border-[#AAFF00] px-4 py-2 text-xs font-bold uppercase tracking-widest text-[#AAFF00] transition-all duration-300 hover:bg-[#AAFF00]/10 disabled:cursor-not-allowed disabled:opacity-50">
                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>
                                Log Weight
                            </button>
                        </div>
                    </div>
                    <p id="weight-message" class="mt-3 min-h-4 text-xs font-bold" aria-live="polite"></p>
                    <div class="-mx-2 mt-4 overflow-x-auto px-2">
                        <table class="w-full min-w-[420px] text-left text-sm">
                            <thead>
                                <tr class="border-b border-white/10 text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">
                                    <th scope="col" class="py-3 pr-4">Date</th>
                                    <th scope="col" class="py-3 pr-4">Weight</th>
                                    <th scope="col" class="py-3 text-right">Progress</th>
                                </tr>
                            </thead>
                            <tbody id="weight-table-body" class="divide-y divide-white/5">
                                <tr><td colspan="3" class="py-4 text-center text-[#F2F2F4]/50">Loading weight records...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const defaultAvatar = '@Url.Content("~/images/default-avatar.png")';

    const avatarInput = document.getElementById('avatar-input');
    const changeAvatarBtn = document.getElementById('change-avatar-btn');
    const removeAvatarBtn = document.getElementById('remove-avatar-btn');
    const avatarImage = document.getElementById('profile-avatar');
    const avatarMessage = document.getElementById('avatar-message');

    const nameDisplay = document.getElementById('profile-name');
    const nameRow = document.getElementById('profile-name').parentElement;
    const nameEditor = document.getElementById('name-editor');
    const nameEditBtn = document.getElementById('name-edit-btn');
    const cancelNameBtn = document.getElementById('cancel-name-btn');
    const nameInput = document.getElementById('name-input');
    const saveNameBtn = document.getElementById('save-name-btn');
    const nameMessage = document.getElementById('name-message');

    const nextWorkoutContent = document.getElementById('next-workout-content');
    const cancelBookingBtn = document.getElementById('cancel-booking-btn');
    const bookingMessage = document.getElementById('booking-message');

    const ordersList = document.getElementById('recent-orders-list');
    const weightInput = document.getElementById('weight-input');
    const addWeightBtn = document.getElementById('add-weight-btn');
    const weightMessage = document.getElementById('weight-message');
    const weightTableBody = document.getElementById('weight-table-body');

    let currentBookingId = null;

    function showMessage(element, message, success) {
        element.textContent = message;
        element.classList.remove('text-green-400', 'text-red-400');
        element.classList.add(success ? 'text-green-400' : 'text-red-400');
    }

    function getHeaders() {
        return { 'Content-Type': 'application/json', 'RequestVerificationToken': token };
    }

    function formatDate(value) {
        return new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function formatDateTime(value) {
        return new Date(value).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    async function loadDashboard() {
        try {
            const response = await fetch('/Profile/GetDashboardData');
            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Failed to load profile data.');
            }

            renderSubscription(data.subscription);
            renderNextWorkout(data.nextWorkout);
            renderOrders(data.orders);
            renderWeights(data.weights);
        } catch (error) {
            console.error('Dashboard loading error:', error);
            nextWorkoutContent.innerHTML = '<p class="text-sm text-red-400">Unable to load your next workout.</p>';
            ordersList.innerHTML = '<li class="py-4 text-sm text-red-400">Unable to load orders.</li>';
            weightTableBody.innerHTML = '<tr><td colspan="3" class="py-4 text-center text-red-400">Unable to load weight records.</td></tr>';
        }
    }

    function renderSubscription(subscription) {
        const plan = document.getElementById('subscription-plan');
        const sidebarPlan = document.getElementById('subscription-plan-sidebar');
        const validUntil = document.getElementById('subscription-valid-until');
        const renewBtn = document.getElementById('renew-btn');

        if (!subscription) {
            plan.textContent = 'No active membership';
            sidebarPlan.textContent = 'No membership';
            validUntil.textContent = 'Choose a membership plan to get started.';
            renewBtn.textContent = 'Choose Plan';
            return;
        }

        plan.textContent = subscription.planName;
        sidebarPlan.textContent = subscription.planName;
        renewBtn.textContent = 'Renew';
        const price = Number(subscription.price || 0).toFixed(2);
        const days = subscription.duration ? subscription.duration + ' days' : '';
        validUntil.textContent = [
            subscription.type,
            days,
            price + ' USD',
            subscription.description,
            'Valid until: ' + formatDate(subscription.endDate)
        ].filter(Boolean).join(' · ');
    }

    function renderNextWorkout(workout) {
        if (!workout) {
            currentBookingId = null;
            cancelBookingBtn.classList.add('hidden');
            nextWorkoutContent.innerHTML = '<div class="flex h-full flex-col justify-center"><p class="text-sm font-bold text-white">No upcoming workouts.</p><p class="mt-2 text-xs text-[#F2F2F4]/50">You do not have any scheduled sessions. Visit the schedule to book your next workout.</p><a href="/Schedule" class="mt-4 inline-block text-xs font-black uppercase tracking-widest text-[#AAFF00] hover:underline">View Schedule</a></div>';
            return;
        }

        currentBookingId = workout.id;
        cancelBookingBtn.classList.remove('hidden');

        nextWorkoutContent.innerHTML = `
            <dl class="space-y-4">
                <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    </span>
                    <div><dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Date</dt><dd class="text-sm font-bold text-white">${formatDateTime(workout.startTime)}</dd></div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/></svg>
                    </span>
                    <div><dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Type</dt><dd class="text-sm font-bold text-white">${escapeHtml(workout.activityName || 'Workout')}</dd></div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                    <div><dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Trainer</dt><dd class="text-sm font-bold text-white">${escapeHtml(workout.trainerName || 'Not assigned')}</dd></div>
                </div>
            </dl>`;
    }

    function renderOrders(orders) {
        if (!orders || orders.length === 0) {
            ordersList.innerHTML = '<li class="py-4 text-sm text-[#F2F2F4]/50">You have not placed any orders yet.</li>';
            return;
        }

        ordersList.innerHTML = orders.map(order => {
            const products = order.products.map(product => `${escapeHtml(product.name)} × ${product.quantity}`).join(', ');
            const status = order.status || 'Processing';
            const photo = (order.products.find(product => product.photoUrl) || {}).photoUrl;
            const thumb = photo
                ? `<img src="${escapeHtml(photo)}" alt="" class="h-10 w-10 shrink-0 object-cover">`
                : `<span class="flex h-10 w-10 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg></span>`;

            return `
                <li class="flex items-center gap-3 py-4">
                    ${thumb}
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-bold text-white">${products || `Order #${order.id}`}</p>
                        <p class="text-xs uppercase tracking-widest text-[#F2F2F4]/50">${formatDate(order.orderDate)}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-black text-white">${Number(order.totalAmount).toFixed(2)}</p>
                        <span class="mt-1 inline-block bg-[#AAFF00]/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#AAFF00]">${escapeHtml(status)}</span>
                    </div>
                </li>`;
        }).join('');
    }

    function renderWeights(weights) {
        if (!weights || weights.length === 0) {
            weightTableBody.innerHTML = '<tr><td colspan="3" class="py-4 text-center text-[#F2F2F4]/50">No weight records yet. Add your first measurement above.</td></tr>';
            return;
        }

        const sorted = [...weights].sort((a, b) => new Date(b.recordDate) - new Date(a.recordDate));

        weightTableBody.innerHTML = sorted.map((record, index) => {
            let progress = '<span class="text-xs font-bold uppercase tracking-widest text-[#F2F2F4]/50">Baseline</span>';

            if (index > 0) {
                const difference = Number(record.weight) - Number(sorted[index - 1].weight);
                const isDecrease = difference < 0;
                const color = isDecrease ? 'text-[#AAFF00]' : difference > 0 ? 'text-[#FF4D4D]' : 'text-[#F2F2F4]/50';
                const sign = difference > 0 ? '+' : '';

                progress = `<span class="inline-flex items-center gap-1 bg-white/5 px-2.5 py-1 text-xs font-black ${color}">${sign}${difference.toFixed(1)} kg</span>`;
            }

            return `
                <tr class="transition-colors duration-300 hover:bg-white/5">
                    <td class="py-4 pr-4 text-[#F2F2F4]/70">${formatDate(record.recordDate)}</td>
                    <td class="py-4 pr-4 font-black text-white">${Number(record.weight).toFixed(1)} kg</td>
                    <td class="py-4 text-right">${progress}</td>
                </tr>`;
        }).join('');
    }

    function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, character => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
        })[character]);
    }

    function openNameEditor() {
        nameInput.value = nameDisplay.textContent.trim();
        nameRow.classList.add('hidden');
        nameEditor.classList.remove('hidden');
        nameInput.focus();
    }

    function closeNameEditor() {
        nameEditor.classList.add('hidden');
        nameRow.classList.remove('hidden');
    }

    nameEditBtn.addEventListener('click', openNameEditor);
    cancelNameBtn.addEventListener('click', function () {
        nameMessage.textContent = '';
        closeNameEditor();
    });

    saveNameBtn.addEventListener('click', async function () {
        const name = nameInput.value.trim();

        if (name.length < 2 || name.length > 100) {
            showMessage(nameMessage, 'Name must be between 2 and 100 characters.', false);
            return;
        }

        saveNameBtn.disabled = true;

        try {
            const response = await fetch('/Profile/UpdateName', {
                method: 'POST',
                headers: getHeaders(),
                body: JSON.stringify({ name })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                showMessage(nameMessage, result.message || 'Failed to update name.', false);
                return;
            }

            nameInput.value = result.name;
            document.getElementById('profile-name').textContent = result.name;
            closeNameEditor();
            showMessage(nameMessage, 'Name updated successfully.', true);
            setTimeout(() => { nameMessage.textContent = ''; }, 3000);
        } catch (error) {
            console.error('Name update error:', error);
            showMessage(nameMessage, 'An error occurred while updating your name.', false);
        } finally {
            saveNameBtn.disabled = false;
        }
    });

    cancelBookingBtn.addEventListener('click', async function () {
        if (!currentBookingId || !confirm('Are you sure you want to cancel this booking?')) {
            return;
        }

        cancelBookingBtn.disabled = true;

        try {
            const response = await fetch('/Profile/CancelBooking', {
                method: 'POST',
                headers: getHeaders(),
                body: JSON.stringify({ bookingId: currentBookingId })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                showMessage(bookingMessage, result.message || 'Failed to cancel booking.', false);
                return;
            }

            showMessage(bookingMessage, result.message, true);
            renderNextWorkout(null);
            await loadDashboard();
        } catch (error) {
            console.error('Booking cancellation error:', error);
            showMessage(bookingMessage, 'An error occurred while cancelling the booking.', false);
        } finally {
            cancelBookingBtn.disabled = false;
        }
    });

    addWeightBtn.addEventListener('click', async function () {
        const weight = Number(weightInput.value);

        if (!weight || weight <= 0 || weight > 500) {
            showMessage(weightMessage, 'Enter a valid weight.', false);
            return;
        }

        addWeightBtn.disabled = true;

        try {
            const response = await fetch('/Profile/AddWeight', {
                method: 'POST',
                headers: getHeaders(),
                body: JSON.stringify({ weight })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                showMessage(weightMessage, result.message || 'Failed to save weight.', false);
                return;
            }

            weightInput.value = '';
            showMessage(weightMessage, 'Weight record saved successfully.', true);
            await loadDashboard();
        } catch (error) {
            console.error('Weight save error:', error);
            showMessage(weightMessage, 'An error occurred while saving your weight.', false);
        } finally {
            addWeightBtn.disabled = false;
        }
    });

    changeAvatarBtn.addEventListener('click', function () {
        avatarInput.click();
    });

    avatarInput.addEventListener('change', async function () {
        if (!avatarInput.files || avatarInput.files.length === 0) return;

        const file = avatarInput.files[0];
        const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

        if (!allowedTypes.includes(file.type)) {
            showMessage(avatarMessage, 'Only JPG, PNG and WEBP images are allowed.', false);
            avatarInput.value = '';
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            showMessage(avatarMessage, 'Image size must not exceed 5 MB.', false);
            avatarInput.value = '';
            return;
        }

        const formData = new FormData();
        formData.append('avatar', file);
        changeAvatarBtn.disabled = true;

        try {
            const response = await fetch('/Profile/UploadAvatar', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                showMessage(avatarMessage, result.message || 'Failed to upload image.', false);
                return;
            }

            const updatedUrl = result.avatarUrl + '?t=' + Date.now();
            avatarImage.src = updatedUrl;

            const navbarAvatar = document.getElementById('navbar-user-avatar');
            const navbarAvatarMenu = document.getElementById('navbar-user-avatar-menu');
            const mobileAvatar = document.getElementById('mobile-user-avatar');

            if (navbarAvatar) navbarAvatar.src = updatedUrl;
            if (navbarAvatarMenu) navbarAvatarMenu.src = updatedUrl;
            if (mobileAvatar) mobileAvatar.src = updatedUrl;

            removeAvatarBtn.classList.remove('hidden');
            showMessage(avatarMessage, 'Profile photo updated successfully.', true);
        } catch (error) {
            console.error('Avatar upload error:', error);
            showMessage(avatarMessage, 'An error occurred while uploading the image.', false);
        } finally {
            changeAvatarBtn.disabled = false;
            avatarInput.value = '';
        }
    });

    removeAvatarBtn.addEventListener('click', async function () {
        if (!confirm('Are you sure you want to remove your profile photo?')) return;

        removeAvatarBtn.disabled = true;

        try {
            const response = await fetch('/Profile/DeleteAvatar', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                showMessage(avatarMessage, result.message || 'Failed to remove image.', false);
                return;
            }

            avatarImage.src = defaultAvatar;

            const navbarAvatar = document.getElementById('navbar-user-avatar');
            const navbarAvatarMenu = document.getElementById('navbar-user-avatar-menu');
            const mobileAvatar = document.getElementById('mobile-user-avatar');

            if (navbarAvatar) navbarAvatar.src = defaultAvatar;
            if (navbarAvatarMenu) navbarAvatarMenu.src = defaultAvatar;
            if (mobileAvatar) mobileAvatar.src = defaultAvatar;

            removeAvatarBtn.classList.add('hidden');
            showMessage(avatarMessage, 'Profile photo removed successfully.', true);
        } catch (error) {
            console.error('Avatar deletion error:', error);
            showMessage(avatarMessage, 'An error occurred while removing the image.', false);
        } finally {
            removeAvatarBtn.disabled = false;
        }
    });

    loadDashboard();
});
</script>