@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="min-h-screen bg-[#1a1a1a] font-sans text-[#F2F2F4]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

            @* ===== Sidebar / profile card ===== *@
            <aside class="lg:col-span-3">
                <div class="relative overflow-hidden bg-[#333333] p-6 text-center ring-1 ring-white/10 lg:sticky lg:top-6">
                    <div class="absolute inset-x-0 top-0 h-1 bg-[#AAFF00]"></div>

                    <div class="relative mx-auto mb-5 h-28 w-28">
                        <div class="absolute -inset-1 rounded-full bg-[#AAFF00]/30 blur-md"></div>
                        <img src="https://plus.unsplash.com/premium_photo-1690407617542-2f210cf20d7e?w=400&h=400&fit=crop&crop=faces"
                             alt="Viktoria Kravchuk"
                             class="relative h-28 w-28 rounded-full object-cover ring-2 ring-[#AAFF00] ring-offset-4 ring-offset-[#333333]" />
                    </div>

                    <h2 class="text-xl font-black uppercase tracking-tighter text-white">Viktoria Kravchuk</h2>
                    <p class="mt-1 text-xs font-bold uppercase tracking-widest text-[#7D51FE]">Pro Membership</p>

                    <span class="mt-4 inline-flex items-center gap-2 bg-[#AAFF00]/10 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-[#AAFF00] ring-1 ring-[#AAFF00]/30">
                        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#AAFF00]"></span>
                        Account: Active
                    </span>
                </div>
            </aside>

            @* ===== Main column ===== *@
            <main class="space-y-6 lg:col-span-9">
                <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl">Client Dashboard</h1>

                @* Membership banner *@
                <section aria-label="Membership" class="relative overflow-hidden border-l-4 border-[#AAFF00] bg-gradient-to-r from-[#AAFF00]/15 via-[#333333] to-[#333333] p-6 ring-1 ring-white/10">
                    <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[#AAFF00]/10 blur-3xl"></div>
                    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center bg-[#7D51FE]/20 text-[#7D51FE] ring-1 ring-[#7D51FE]/40">
                                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7z" /><path d="M5 20h14" /></svg>
                            </div>
                            <div>
                                <h2 class="text-xl font-black uppercase tracking-tighter text-white">Pro Membership</h2>
                                <p class="mt-1 text-xs uppercase tracking-widest text-[#F2F2F4]/60">Valid until: Dec 31, 2026</p>
                            </div>
                        </div>
                        <button type="button"
                                class="bg-[#AAFF00] px-8 py-3 text-xs font-black uppercase tracking-widest text-[#1a1a1a] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(170,255,0,0.3)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                            Renew
                        </button>
                    </div>
                </section>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

                    @* Next workout *@
                    <section aria-labelledby="next-workout" class="flex flex-col bg-[#333333] p-6 ring-1 ring-white/10 transition-all duration-300 hover:ring-[#AAFF00]/40">
                        <h2 id="next-workout" class="text-lg font-black uppercase tracking-tighter text-white">Next Workout</h2>
                        <dl class="mt-5 flex-1 space-y-4">
                            <div class="flex items-center gap-3">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                </span>
                                <div>
                                    <dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Date</dt>
                                    <dd class="text-sm font-bold text-white">Tomorrow, 12:00 PM</dd>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11" /></svg>
                                </span>
                                <div>
                                    <dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Type</dt>
                                    <dd class="text-sm font-bold text-white">Powerlifting</dd>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                </span>
                                <div>
                                    <dt class="text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">Trainer</dt>
                                    <dd class="text-sm font-bold text-white">Iryna Boyko</dd>
                                </div>
                            </div>
                        </dl>
                        <button type="button"
                                class="mt-6 w-full border border-[#FF4D4D]/50 px-4 py-3 text-xs font-black uppercase tracking-widest text-[#FF4D4D] transition-all duration-300 hover:bg-[#FF4D4D] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4D4D]">
                            Cancel Booking
                        </button>
                    </section>

                    @* Recent orders *@
                    <section aria-labelledby="recent-orders" class="bg-[#333333] p-6 ring-1 ring-white/10 transition-all duration-300 hover:ring-[#AAFF00]/40">
                        <h2 id="recent-orders" class="text-lg font-black uppercase tracking-tighter text-white">Recent Orders</h2>
                        <ul class="mt-5 divide-y divide-white/10">
                            <li class="flex items-center gap-3 pb-4">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15" /><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5M12 22V12" /></svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-bold text-white">Whey Protein Isolate</p>
                                    <p class="text-xs uppercase tracking-widest text-[#F2F2F4]/50">Oct 5</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-black text-white">$45.00</p>
                                    <span class="mt-1 inline-block bg-[#AAFF00]/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#AAFF00]">Delivered</span>
                                </div>
                            </li>
                            <li class="flex items-center gap-3 pt-4">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-white/5 text-[#7D51FE]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-bold text-white">SportLab Gym Bag</p>
                                    <p class="text-xs uppercase tracking-widest text-[#F2F2F4]/50">Sep 28</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-black text-white">$42.00</p>
                                    <span class="mt-1 inline-block bg-[#AAFF00]/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#AAFF00]">Delivered</span>
                                </div>
                            </li>
                        </ul>
                    </section>
                </div>

                @* Weight tracker *@
                <section aria-labelledby="weight-tracker" class="bg-[#333333] p-6 ring-1 ring-white/10">
                    <div class="flex items-center justify-between gap-4">
                        <h2 id="weight-tracker" class="text-lg font-black uppercase tracking-tighter text-white">Weight Tracker</h2>
                        <button type="button"
                                class="inline-flex items-center gap-2 border border-white/20 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white transition-all duration-300 hover:border-[#AAFF00] hover:text-[#AAFF00] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AAFF00]">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
                            Log Weight
                        </button>
                    </div>

                    <div class="-mx-2 mt-4 overflow-x-auto px-2">
                        <table class="w-full min-w-[420px] text-left text-sm">
                            <thead>
                                <tr class="border-b border-white/10 text-[10px] font-bold uppercase tracking-widest text-[#F2F2F4]/50">
                                    <th scope="col" class="py-3 pr-4">Date</th>
                                    <th scope="col" class="py-3 pr-4">Weight</th>
                                    <th scope="col" class="py-3 text-right">Progress</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <tr class="transition-colors duration-300 hover:bg-white/5">
                                    <td class="py-4 pr-4 text-[#F2F2F4]/70">Oct 5, 2026</td>
                                    <td class="py-4 pr-4 font-black text-white">65.5 kg</td>
                                    <td class="py-4 text-right">
                                        <span class="inline-flex items-center gap-1 bg-[#AAFF00]/10 px-2.5 py-1 text-xs font-black text-[#AAFF00]">
                                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
                                            0.5 kg
                                        </span>
                                    </td>
                                </tr>
                                <tr class="transition-colors duration-300 hover:bg-white/5">
                                    <td class="py-4 pr-4 text-[#F2F2F4]/70">Sep 1, 2026</td>
                                    <td class="py-4 pr-4 font-black text-white">66.0 kg</td>
                                    <td class="py-4 text-right text-xs font-bold uppercase tracking-widest text-[#F2F2F4]/50">Baseline</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </div>
    </div>
</div>
