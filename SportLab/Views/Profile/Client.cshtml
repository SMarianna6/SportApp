@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row g-4">
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <img src="https://plus.unsplash.com/premium_photo-1690407617542-2f210cf20d7e?w=400&h=400&fit=crop&crop=faces" 
                     class="rounded-circle mx-auto mb-3" alt="Avatar" style="width: 120px; height: 120px; object-fit: cover;">
                
                <h5 class="fw-bold mb-1">Viktoria Kravchuk</h5>
                <p class="text-muted small mb-2">Pro Membership</p>
                <span class="badge bg-success mb-3">Account: Active</span>
                
                <ul class="nav flex-column text-start border-top pt-3">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-bold px-0" href="#">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-muted px-0" href="#">Settings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger px-0" href="#">Logout</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-md-9">
            <h3 class="mb-4">Client Dashboard</h3>

            <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Pro Membership</h5>
                        <p class="text-muted mb-0 small">Valid until: Dec 31, 2026</p>
                    </div>
                    <button class="btn btn-success">Renew</button>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white pt-3">
                            <h5 class="fw-bold my-0">Next Workout</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Date:</strong> Tomorrow, 12:00 PM</p>
                            <p class="mb-1"><strong>Type:</strong> Powerlifting</p>
                            <p class="mb-3"><strong>Trainer:</strong> Iryna Boyko</p>
                            <button class="btn btn-sm btn-outline-danger w-100">Cancel Booking</button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white pt-3">
                            <h5 class="fw-bold my-0">Recent Orders</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-2 border-bottom pb-2 small">
                                <span class="text-muted">Oct 5</span> - Whey Protein Isolate<br>
                                <strong>$45.00</strong> <span class="badge bg-success ms-1">Delivered</span>
                            </p>
                            <p class="mb-0 small">
                                <span class="text-muted">Sep 28</span> - SportLab Gym Bag<br>
                                <strong>$42.00</strong> <span class="badge bg-success ms-1">Delivered</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white pt-3 pb-2 d-flex justify-content-between align-items-center border-bottom-0">
                    <h5 class="fw-bold my-0">Weight Tracker</h5>
                    <button class="btn btn-sm btn-outline-primary">+ Log Weight</button>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0 small">
                            <thead class="border-bottom">
                                <tr class="text-muted">
                                    <th>Date</th>
                                    <th>Weight</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Oct 5, 2026</td>
                                    <td class="fw-bold">65.5 kg</td>
                                    <td class="text-success fw-bold">↓ 0.5 kg</td>
                                </tr>
                                <tr>
                                    <td>Sep 1, 2026</td>
                                    <td class="fw-bold">66.0 kg</td>
                                    <td class="text-muted">Baseline</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>