@{
    ViewData["Title"] = "Client Profile";
}

<div class="py-4">
    <!-- Header Profile Bar -->
    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 mb-4 bg-white">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-4">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200&auto=format&fit=crop&q=80" 
                         alt="Alex Smith" class="rounded-circle shadow object-fit-cover" width="96" height="96">
                    <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-white rounded-circle"></span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold mb-0">Alex Smith</h2>
                        <span class="badge bg-primary rounded-pill px-3">Pro Member</span>
                    </div>
                    <p class="text-muted mb-1"><i class="bi bi-envelope me-1"></i>alex.smith@example.com &bull; Member #10842</p>
                    <p class="text-muted small mb-0"><i class="bi bi-calendar3 me-1"></i>Joined March 2026 &bull; Active until Dec 31, 2026 (84 days left)</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-dark rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#qrModal">
                    <i class="bi bi-qr-code me-1"></i> Digital Pass
                </button>
                <a asp-action="Trainer" class="btn btn-light rounded-pill px-3 text-secondary border">
                    <i class="bi bi-person-badge me-1"></i> Switch to Trainer View
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Upcoming Sessions & Pass Info -->
        <div class="col-lg-7">
            <!-- Booked Sessions -->
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>My Upcoming Workouts</h5>
                    <a asp-controller="Schedule" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                        + Book New
                    </a>
                </div>

                <div class="d-flex flex-column gap-3" id="bookedList">
                    <!-- Session 1 -->
                    <div class="p-3 rounded-3 bg-light d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white text-center rounded-3 p-2 px-3">
                                <div class="fw-bold" style="font-size: 1.1rem;">12</div>
                                <div class="small text-uppercase" style="font-size: 0.65rem;">Oct</div>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Morning Metabolic Blast</h6>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>08:00 - 09:00 &bull; Coach Sarah Jenkins &bull; CrossFit Zone</small>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="cancelSession(this)">Cancel</button>
                        </div>
                    </div>

                    <!-- Session 2 -->
                    <div class="p-3 rounded-3 bg-light d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-dark text-white text-center rounded-3 p-2 px-3">
                                <div class="fw-bold" style="font-size: 1.1rem;">15</div>
                                <div class="small text-uppercase" style="font-size: 0.65rem;">Oct</div>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Powerlifting Biomechanics</h6>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>10:30 - 11:45 &bull; Coach Alex Mercer &bull; Iron Zone</small>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="cancelSession(this)">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Metric Progress Tracker -->
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Body Metrics & Weight Log</h5>
                    <button class="btn btn-sm btn-dark rounded-pill" onclick="logNewWeight()">
                        <i class="bi bi-plus-lg me-1"></i> Log Weight
                    </button>
                </div>

                <div class="row g-3 text-center mb-3">
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small">Current Weight</span>
                            <h4 class="fw-bold mb-0 mt-1" id="currentWeightVal">78.4 kg</h4>
                            <span class="small text-success"><i class="bi bi-arrow-down"></i> -1.8 kg</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small">Body Fat</span>
                            <h4 class="fw-bold mb-0 mt-1">14.8 %</h4>
                            <span class="small text-success"><i class="bi bi-arrow-down"></i> -1.2 %</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small">Workouts Done</span>
                            <h4 class="fw-bold mb-0 mt-1">36</h4>
                            <span class="small text-primary">This Year</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="text-muted small">
                            <tr>
                                <th>Date</th>
                                <th>Weight (kg)</th>
                                <th>Notes / Focus</th>
                            </tr>
                        </thead>
                        <tbody id="metricsBody">
                            <tr>
                                <td>Today (Oct 08)</td>
                                <td class="fw-bold">78.4 kg</td>
                                <td class="text-muted small">Post morning cardio fasted weigh-in</td>
                            </tr>
                            <tr>
                                <td>Oct 01, 2026</td>
                                <td class="fw-bold">79.0 kg</td>
                                <td class="text-muted small">End of week 3 block</td>
                            </tr>
                            <tr>
                                <td>Sep 24, 2026</td>
                                <td class="fw-bold">79.6 kg</td>
                                <td class="text-muted small">Starting deficit phase</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Membership Card & Orders -->
        <div class="col-lg-5">
            <!-- Digital Membership Card Preview -->
            <div class="card border-0 rounded-4 text-white shadow-sm p-4 mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="badge bg-primary px-3 py-1 rounded-pill">SPORTLAB PASS</span>
                    <i class="bi bi-wifi fs-4 text-white-50"></i>
                </div>
                <div class="text-center my-3">
                    <div class="bg-white p-2 rounded-3 d-inline-block shadow">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=SPORTLAB-MEMBER-10842-ALEX" alt="QR Code" width="130" height="130">
                    </div>
                    <div class="mt-2 text-white-50 small">Scan at gym turnstile to enter</div>
                </div>
                <div class="d-flex justify-content-between align-items-end mt-3 border-top border-secondary pt-3">
                    <div>
                        <div class="small text-white-50">CARDHOLDER</div>
                        <div class="fw-bold">ALEX SMITH</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-white-50">EXPIRES</div>
                        <div class="fw-bold">12 / 2026</div>
                    </div>
                </div>
            </div>

            <!-- Shop Order History -->
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-bag-check me-2 text-primary"></i>Store Purchases</h5>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-link text-muted p-0">Shop More</a>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small">Order #ORD-7402</span>
                            <span class="badge bg-success-subtle text-success">Completed</span>
                        </div>
                        <div class="text-muted small mb-2">100% Whey Protein Isolate &bull; $45.00</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Picked up at reception &bull; Oct 06, 2026</div>
                    </div>
                    <div class="p-3 rounded-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small">Order #ORD-7311</span>
                            <span class="badge bg-success-subtle text-success">Completed</span>
                        </div>
                        <div class="text-muted small mb-2">SportLab Pro Stainless Shaker &bull; $18.50</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Front desk express &bull; Sep 28, 2026</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QR Modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow text-center p-4">
            <h4 class="fw-bold mb-1">Member Contactless Pass</h4>
            <p class="text-muted small mb-3">Hold against the optical scanner at the gym turnstile gate.</p>
            <div class="bg-light p-3 rounded-4 d-inline-block mx-auto mb-3">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=SPORTLAB-MEMBER-10842-ALEX" alt="Turnstile QR" width="220" height="220">
            </div>
            <div class="fw-bold text-primary">#10842 &bull; Alex Smith</div>
            <div class="text-muted small mt-1">Status: Active (Access to all areas & lockers)</div>
            <button type="button" class="btn btn-dark rounded-pill mt-4" data-bs-dismiss="modal">Close</button>
        </div>
    </div>
</div>

<script>
    function cancelSession(btn) {
        if (confirm('Cancel this workout reservation? The spot will be freed for other members.')) {
            const card = btn.closest('.d-flex.p-3');
            card.remove();
            alert('Workout reservation cancelled.');
        }
    }

    function logNewWeight() {
        const val = prompt('Enter today\'s body weight (in kg):', '78.2');
        if (val && !isNaN(val)) {
            document.getElementById('currentWeightVal').innerText = parseFloat(val).toFixed(1) + ' kg';
            const tbody = document.getElementById('metricsBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>Today (${new Date().toLocaleDateString()})</td>
                <td class="fw-bold">${parseFloat(val).toFixed(1)} kg</td>
                <td class="text-muted small">Logged via Client Dashboard</td>
            `;
            tbody.insertBefore(tr, tbody.firstChild);
        }
    }
</script>
