@model SportLab.Models.User
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Client Dashboard";

    var activeSubscription = ViewBag.ActiveSubscription as SportLab.Models.Subscription;
    var nextBooking = ViewBag.NextBooking as SportLab.Models.WorkoutSlot;
    var bookingCount = ViewBag.BookingCount is int count ? count : 0;
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-5xl">

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Client Area</p>
                <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">@(Model?.Name ?? "Client")</h1>
                <p class="mt-1 text-sm text-white/50">@Model?.Email</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a asp-controller="Schedule" asp-action="Index" class="rounded-md bg-neon px-4 py-2.5 text-xs font-extrabold uppercase tracking-widest text-black transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neon/30">
                    Book a Workout
                </a>
                <a asp-controller="Tariff" asp-action="Index" class="rounded-md border border-white/20 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">
                    Buy Membership
                </a>
            </div>
        </div>

        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Membership</p>
                <p class="mt-1 text-lg font-black uppercase tracking-tight @(activeSubscription != null ? "text-neon" : "text-white/50")">
                    @(activeSubscription?.Plan?.Name ?? "No active plan")
                </p>
                @if (activeSubscription != null)
                {
                    <p class="mt-1 text-xs text-white/40">Valid until @activeSubscription.EndDate.ToString("dd.MM.yyyy")</p>
                }
            </div>

            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Upcoming sessions</p>
                <p class="mt-1 text-3xl font-black text-neon">@bookingCount</p>
                <a asp-controller="Schedule" asp-action="MyBookings" class="mt-1 inline-block text-xs font-bold uppercase tracking-widest text-white/50 hover:text-neon">My bookings &rarr;</a>
            </div>

            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Account role</p>
                <p class="mt-1 text-lg font-black uppercase tracking-tight">@(Model?.Role ?? "Client")</p>
                <p class="mt-1 text-xs text-white/40">@(Model?.IsBlocked == true ? "Blocked" : "Active")</p>
            </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-xs font-extrabold uppercase tracking-widest text-white/60">Next Workout</h2>
                    <a asp-controller="Schedule" asp-action="MyBookings" class="text-[10px] font-bold uppercase tracking-widest text-neon hover:underline">All bookings</a>
                </div>

                @if (nextBooking == null)
                {
                    <p class="py-6 text-center text-sm text-white/30">
                        No upcoming workout.
                        <a asp-controller="Schedule" asp-action="Index" class="text-neon hover:underline">Find a session</a>
                    </p>
                }
                else
                {
                    <p class="text-lg font-black uppercase tracking-tight">@(nextBooking.ActivityName ?? "Workout")</p>
                    <p class="mt-1 text-sm text-white/50">@nextBooking.StartTime.ToString("dddd, dd MMMM · HH:mm") – @nextBooking.EndTime.ToString("HH:mm")</p>
                    <p class="mt-2 text-xs text-white/40">Trainer: @(nextBooking.Trainer?.Name ?? "To be confirmed")</p>
                    <form asp-controller="Schedule" asp-action="CancelBooking" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@nextBooking.Id" />
                        <button type="submit" class="rounded-md bg-red-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-red-400 transition-colors hover:bg-red-500/20">
                            Cancel Booking
                        </button>
                    </form>
                }
            </div>

            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-xs font-extrabold uppercase tracking-widest text-white/60">Membership</h2>
                    <a asp-controller="Subscriptions" asp-action="My" class="text-[10px] font-bold uppercase tracking-widest text-neon hover:underline">History</a>
                </div>

                @if (activeSubscription == null)
                {
                    <p class="py-6 text-center text-sm text-white/30">
                        No active membership.
                        <a asp-controller="Tariff" asp-action="Index" class="text-neon hover:underline">Choose a tariff</a>
                    </p>
                }
                else
                {
                    <p class="text-lg font-black uppercase tracking-tight">@activeSubscription.Plan?.Name</p>
                    <p class="mt-1 text-sm text-white/50">@activeSubscription.StartDate.ToString("dd.MM.yyyy") – @activeSubscription.EndDate.ToString("dd.MM.yyyy")</p>
                    <p class="mt-2 text-xs text-white/40">@activeSubscription.Plan?.Price.ToString("0.00") UAH · @activeSubscription.Plan?.Duration days</p>
                }
            </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
            <a asp-controller="MetricLogs" asp-action="Index" class="rounded-md border border-white/20 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">My Progress</a>
            <a asp-controller="Review" asp-action="Index" class="rounded-md border border-white/20 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">Leave a Review</a>
            <a asp-controller="Profile" asp-action="Settings" class="rounded-md border border-white/20 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">Settings</a>
        </div>

    </div>
</div>
