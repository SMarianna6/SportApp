@inject IViewLocalizer Localizer
@inject IStringLocalizer<SportLab.SharedResource> SharedLocalizer

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = Localizer["PageTitle"];
}

<div class="mb-6">
    <h2 class="text-3xl font-black uppercase tracking-tighter sm:text-4xl">@Localizer["PageTitle"]</h2>
    <p class="mt-1 text-sm text-mono/60">@Localizer["Header.Subtitle"]</p>
</div>

<div class="flex flex-col gap-5 lg:flex-row">
    <nav class="flex shrink-0 gap-1 overflow-x-auto rounded-lg bg-card p-2 lg:w-60 lg:flex-col" aria-label="@Localizer["Aria.SettingsSections"]" role="tablist" aria-orientation="vertical">
        <button type="button" role="tab" data-tab="account" class="settings-tab whitespace-nowrap rounded-md px-4 py-3 text-left text-xs font-bold uppercase tracking-widest">@Localizer["Tab.Account"]</button>
        <button type="button" role="tab" data-tab="security" class="settings-tab whitespace-nowrap rounded-md px-4 py-3 text-left text-xs font-bold uppercase tracking-widest">@Localizer["Tab.Security"]</button>
        <button type="button" role="tab" data-tab="notifications" class="settings-tab whitespace-nowrap rounded-md px-4 py-3 text-left text-xs font-bold uppercase tracking-widest">@Localizer["Tab.Notifications"]</button>
    </nav>

    <div class="min-w-0 flex-1 rounded-lg bg-card p-5 sm:p-7">
        @Html.AntiForgeryToken()

        <!-- Account Tab -->
        <section id="tab-account" data-tab-panel role="tabpanel">
            <h3 class="text-lg font-extrabold uppercase tracking-tight">@Localizer["Tab.Account"]</h3>
            <p class="mt-1 text-sm text-mono/60">@Localizer["Account.Desc"]</p>
            
            <form id="account-form" class="mt-6 grid max-w-xl gap-4 sm:grid-cols-2">
                <div>
                    <label for="acc-name" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">@SharedLocalizer["Common.FullName"]</label>
                    <input id="acc-name" type="text" required class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div>
                    <label for="acc-email" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">@SharedLocalizer["Common.Email"]</label>
                    <input id="acc-email" type="email" required class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div class="sm:col-span-2">
                    <button type="submit" id="btn-save-account" class="rounded-md bg-neon px-6 py-3 text-xs font-extrabold uppercase tracking-widest text-shell transition-transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed">@SharedLocalizer["Common.SaveChanges"]</button>
                    <p id="account-msg" class="mt-3 text-sm font-bold hidden"></p>
                </div>
            </form>

            <!-- Danger Zone (Delete Account) -->
            <div class="mt-10 border-t border-white/10 pt-6">
                <h4 class="text-sm font-black text-red-500 uppercase tracking-widest mb-2 flex items-center gap-2">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    @Localizer["DangerZone.Title"]
                </h4>
                <p class="text-xs text-mono/50 mb-4 max-w-md">@Localizer["DangerZone.Desc"]</p>
                <button type="button" id="btn-delete-account" class="rounded-md border border-red-500/50 bg-red-500/10 px-6 py-3 text-xs font-extrabold uppercase tracking-widest text-red-500 transition-colors hover:bg-red-500 hover:text-white disabled:opacity-50 disabled:cursor-not-allowed">
                    @Localizer["Btn.DeleteAccount"]
                </button>
                <p id="delete-msg" class="mt-3 text-sm font-bold hidden"></p>
            </div>
        </section>

        <!-- Security Tab -->
        <section id="tab-security" data-tab-panel role="tabpanel" class="hidden">
            <h3 class="text-lg font-extrabold uppercase tracking-tight">@Localizer["Tab.Security"]</h3>
            <p class="mt-1 text-sm text-mono/60">@Localizer["Security.Desc"]</p>
            
            <form id="password-form" class="mt-6 max-w-md space-y-4">
                <div>
                    <label for="pw-current" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">@Localizer["Field.CurrentPassword"]</label>
                    <input id="pw-current" type="password" required autocomplete="current-password" class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div>
                    <label for="pw-new" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">@Localizer["Field.NewPassword"]</label>
                    <input id="pw-new" type="password" required autocomplete="new-password" class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div>
                    <label for="pw-confirm" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">@Localizer["Field.ConfirmPassword"]</label>
                    <input id="pw-confirm" type="password" required autocomplete="new-password" class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div>
                    <button type="submit" id="btn-save-password" class="rounded-md bg-neon px-6 py-3 text-xs font-extrabold uppercase tracking-widest text-shell transition-transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed">@Localizer["Btn.UpdatePassword"]</button>
                    <p id="password-msg" class="mt-3 text-sm font-bold hidden"></p>
                </div>
            </form>
        </section>

        <!-- Notifications Tab -->
        <section id="tab-notifications" data-tab-panel role="tabpanel" class="hidden">
            <h3 class="text-lg font-extrabold uppercase tracking-tight">@Localizer["Tab.Notifications"]</h3>
            <p class="mt-1 text-sm text-mono/60">@Localizer["Notifications.Desc"]</p>
            <ul class="mt-6 max-w-xl divide-y divide-white/10">
                <li class="flex items-center justify-between gap-4 py-4">
                    <div>
                        <p id="sw-email-label" class="text-sm font-bold">@Localizer["Notification.EmailAlerts"]</p>
                        <p class="text-xs text-mono/50">@Localizer["Notification.EmailAlertsDesc"]</p>
                    </div>
                    <button type="button" role="switch" aria-checked="true" aria-labelledby="sw-email-label" class="switch relative h-6 w-11 shrink-0 rounded-full bg-neon transition-colors focus:outline-none">
                        <span class="knob absolute left-0.5 top-0.5 h-5 w-5 translate-x-5 transform-gpu rounded-full bg-shell transition-transform"></span>
                    </button>
                </li>
                <li class="flex items-center justify-between gap-4 py-4">
                    <div>
                        <p id="sw-chat-label" class="text-sm font-bold">@Localizer["Notification.ChatMessages"]</p>
                        <p class="text-xs text-mono/50">@Localizer["Notification.ChatMessagesDesc"]</p>
                    </div>
                    <button type="button" role="switch" aria-checked="false" aria-labelledby="sw-chat-label" class="switch relative h-6 w-11 shrink-0 rounded-full bg-shell transition-colors focus:outline-none">
                        <span class="knob absolute left-0.5 top-0.5 h-5 w-5 transform-gpu rounded-full bg-mono/60 transition-transform"></span>
                    </button>
                </li>
            </ul>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            var locStrings = {
                msgAccountUpdated: @Html.Raw(Json.Serialize(Localizer["Msg.AccountUpdated"].Value)),
                msgAccountFailed: @Html.Raw(Json.Serialize(Localizer["Msg.AccountFailed"].Value)),
                msgNetworkError: @Html.Raw(Json.Serialize(Localizer["Msg.NetworkError"].Value)),
                msgPasswordsMismatch: @Html.Raw(Json.Serialize(Localizer["Msg.PasswordsMismatch"].Value)),
                msgPasswordUpdated: @Html.Raw(Json.Serialize(Localizer["Msg.PasswordUpdated"].Value)),
                msgPasswordFailed: @Html.Raw(Json.Serialize(Localizer["Msg.PasswordFailed"].Value)),
                confirmDelete: @Html.Raw(Json.Serialize(Localizer["Msg.ConfirmDelete"].Value)),
                btnDeleting: @Html.Raw(Json.Serialize(Localizer["Btn.Deleting"].Value)),
                msgDeleteFailed: @Html.Raw(Json.Serialize(Localizer["Msg.DeleteFailed"].Value)),
                btnDeleteAccount: @Html.Raw(Json.Serialize(Localizer["Btn.DeleteAccount"].Value))
            };

            function setTab(name) {
                document.querySelectorAll('[data-tab-panel]').forEach(function (p) { p.classList.toggle('hidden', p.id !== 'tab-' + name); });
                document.querySelectorAll('.settings-tab').forEach(function (t) {
                    var on = t.dataset.tab === name;
                    t.setAttribute('aria-selected', String(on));
                    t.className = 'settings-tab whitespace-nowrap rounded-md px-4 py-3 text-left text-xs font-bold uppercase tracking-widest transition-colors ' +
                        (on ? 'bg-shell text-neon' : 'text-mono hover:text-neon');
                    t.style.boxShadow = on ? 'inset 3px 0 0 #AAFF00' : '';
                });
            }
            document.querySelectorAll('.settings-tab').forEach(function (t) {
                t.addEventListener('click', function () { setTab(t.dataset.tab); });
            });
            setTab('account');

            document.querySelectorAll('.switch').forEach(function (sw) {
                sw.addEventListener('click', function () {
                    var on = sw.getAttribute('aria-checked') !== 'true';
                    var knob = sw.querySelector('.knob');
                    sw.setAttribute('aria-checked', String(on));
                    sw.classList.toggle('bg-neon', on); sw.classList.toggle('bg-shell', !on);
                    knob.classList.toggle('translate-x-5', on); knob.classList.toggle('bg-shell', on); knob.classList.toggle('bg-mono/60', !on);
                });
            });

            async function loadAccount() {
                try {
                    const res = await fetch('/Profile/GetAccount');
                    const data = await res.json();
                    if (data.success) {
                        document.getElementById('acc-name').value = data.name;
                        document.getElementById('acc-email').value = data.email;
                    }
                } catch(e) { console.error('Failed to load account', e); }
            }

            function showMsg(elId, text, isSuccess) {
                const el = document.getElementById(elId);
                el.textContent = text;
                el.className = 'mt-3 text-sm font-bold ' + (isSuccess ? 'text-green-400' : 'text-[#FF5252]');
                el.classList.remove('hidden');
                setTimeout(() => el.classList.add('hidden'), 4000);
            }

            document.getElementById('account-form').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-save-account');
                btn.disabled = true;

                const payload = {
                    name: document.getElementById('acc-name').value.trim(),
                    email: document.getElementById('acc-email').value.trim()
                };

                try {
                    const res = await fetch('/Profile/UpdateAccountSettings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        showMsg('account-msg', locStrings.msgAccountUpdated, true);

                        const newName = data.name;
                        const firstName = newName.split(' ')[0];

                        const dashNameEl = document.getElementById('nav-user-name');
                        if (dashNameEl) dashNameEl.textContent = firstName;

                        const mainNameEl = document.getElementById('nav-user-name');
                        if (mainNameEl) mainNameEl.textContent = firstName;

                        const dropdownNameEl = document.getElementById('nav-user-name-dropdown');
                        if (dropdownNameEl) dropdownNameEl.textContent = firstName;

                        const mobileNameEl = document.getElementById('mobile-user-name');
                        if (mobileNameEl) mobileNameEl.textContent = firstName;
                    } else {
                        showMsg('account-msg', data.message || locStrings.msgAccountFailed, false);
                    }
                } catch(err) {
                    showMsg('account-msg', locStrings.msgNetworkError, false);
                } finally {
                    btn.disabled = false;
                }
            });

            document.getElementById('password-form').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-save-password');
                const newPw = document.getElementById('pw-new').value;
                const confirmPw = document.getElementById('pw-confirm').value;

                if (newPw !== confirmPw) {
                    showMsg('password-msg', locStrings.msgPasswordsMismatch, false);
                    return;
                }

                btn.disabled = true;
                const payload = {
                    currentPassword: document.getElementById('pw-current').value,
                    newPassword: newPw,
                    confirmPassword: confirmPw
                };

                try {
                    const res = await fetch('/Profile/UpdatePassword', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        showMsg('password-msg', locStrings.msgPasswordUpdated, true);
                        document.getElementById('password-form').reset();
                    } else {
                        showMsg('password-msg', data.message || locStrings.msgPasswordFailed, false);
                    }
                } catch(err) {
                    showMsg('password-msg', locStrings.msgNetworkError, false);
                } finally {
                    btn.disabled = false;
                }
            });

            // --- DELETE ACCOUNT LOGIC 
            document.getElementById('btn-delete-account').addEventListener('click', async function() {
                if (!confirm(locStrings.confirmDelete)) return;

                const btn = this;
                btn.disabled = true;
                btn.innerHTML = locStrings.btnDeleting;

                try {
                    const res = await fetch('/Profile/DeleteAccount', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token }
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        window.location.href = '/';
                    } else {
                        showMsg('delete-msg', data.message || locStrings.msgDeleteFailed, false);
                        btn.disabled = false;
                        btn.innerHTML = locStrings.btnDeleteAccount;
                    }
                } catch(err) {
                    showMsg('delete-msg', locStrings.msgNetworkError, false);
                    btn.disabled = false;
                    btn.innerHTML = locStrings.btnDeleteAccount;
                }
            });

            // Init
            loadAccount();
        })();
    </script>
}