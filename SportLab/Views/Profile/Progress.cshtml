@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Progress";

    var weights = new[]
    {
        new { Date = "Sep 1", Val = 66.0f },
        new { Date = "Sep 10", Val = 65.8f },
        new { Date = "Sep 20", Val = 65.2f },
        new { Date = "Oct 5", Val = 65.5f }
    };
}

<div class="container p-4 text-white">
    <h2>My Progress</h2>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card bg-dark p-3">
                <h4>Weight Chart</h4>
                <div style="height: 200px; border-left: 2px solid white; border-bottom: 2px solid white; padding: 10px;">
                    <svg width="100%" height="100%">
                        <polyline fill="none" stroke="lime" stroke-width="2" points="0,20 100,60 200,150 300,100" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-dark p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>History</h4>
                    <button class="btn btn-primary btn-sm">+ Log Weight</button>
                </div>
                <table class="table table-dark">
                    @foreach (var w in weights)
                    {
                        <tr>
                            <td>@w.Date</td>
                            <td>@w.Val kg</td>
                            <td><button class="btn btn-sm btn-light">Edit</button></td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>