@using System.Text.Json
@model IEnumerable<SportLab.Models.WorkoutSlot>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Schedule";

    bool isTrainer = User.IsInRole(SportLab.Models.Roles.Trainer);
    bool isClient = User.IsInRole(SportLab.Models.Roles.Client);

    var scheduleData = Model.Select(slot => new
    {
        id = slot.Id,
        date = slot.StartTime.ToString("yyyy-MM-dd"),
        day = slot.StartTime.DayOfWeek == DayOfWeek.Sunday
            ? 7
            : (int)slot.StartTime.DayOfWeek,
        timeStart = slot.StartTime.ToString("HH:mm"),
        timeEnd = slot.EndTime.ToString("HH:mm"),
        type = slot.ActivityName ?? "Workout",
        coach = slot.Trainer?.Name ?? "TBA",
        booked = slot.Bookings.Count,
        capacity = slot.Capacity,
        status = slot.Status,
        clients = isTrainer
            ? slot.Bookings.Select(b => b.User?.Name ?? "Unknown client").ToList()
            : new List<string>()
    }).ToList();
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page" data-sh-page="profile-schedule">
    <div class="sh-head">
        <div>
            <h1 class="sh-title">Schedule</h1>
            <p class="sh-sub">
                @if (isTrainer)
                {
                    <text>Manage your workouts and view registered clients.</text>
                }
                else
                {
                    <text>View the workouts you have booked.</text>
                }
            </p>
        </div>

        @if (isTrainer)
        {
            <button type="button" class="sh-btn sh-btn-primary" id="sh-schedule-add">
                <span>+</span> Create workout
            </button>
        }
    </div>

    <div class="sh-legend" id="sh-schedule-legend" role="group" aria-label="Filter workouts by type"></div>

    <div class="sh-card sh-scroll-x">
        <div class="sh-cal" id="sh-cal"></div>
    </div>
</div>

<div class="sh-modal-backdrop" id="sh-schedule-modal" hidden>
    <div class="sh-modal" role="dialog" aria-modal="true" aria-labelledby="sh-schedule-modal-title">
        <div class="sh-modal-bar"></div>
        <div class="sh-modal-head">
            <h2 class="sh-modal-title" id="sh-schedule-modal-title">Workout details</h2>
            <button type="button" class="sh-modal-close" data-sh-close aria-label="Close">
                <svg class="sh-ico sh-ico-lg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </button>
        </div>

        <div class="sh-modal-body">
            <form class="sh-form" id="sh-schedule-form" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="sh-form-grid">
                    <label class="sh-field">
                        Activity Type
                        <div class="sh-field-body">
                            <select class="sh-input" name="Type" id="sh-schedule-type" required>
                                <option value="HIIT">HIIT</option>
                                <option value="Pilates">Pilates</option>
                                <option value="Yoga">Yoga</option>
                                <option value="Strength">Strength</option>
                                <option value="Cycling">Cycling</option>
                                <option value="Boxing">Boxing</option>
                            </select>
                        </div>
                    </label>
                    <label class="sh-field">
                        Date
                        <div class="sh-field-body">
                            <input class="sh-input" type="date" name="Date" id="sh-schedule-date" required />
                        </div>
                    </label>
                    <label class="sh-field">
                        Start Time
                        <div class="sh-field-body">
                            <input class="sh-input" type="time" name="TimeStart" id="sh-schedule-start" min="08:00" max="20:00" step="900" required />
                        </div>
                    </label>
                    <label class="sh-field">
                        End Time
                        <div class="sh-field-body">
                            <input class="sh-input" type="time" name="TimeEnd" id="sh-schedule-end" min="08:00" max="20:00" step="900" required />
                        </div>
                    </label>
                    <label class="sh-field">
                        Capacity
                        <div class="sh-field-body">
                            <input class="sh-input" type="number" name="Capacity" id="sh-schedule-capacity" min="1" max="1000" value="15" required />
                        </div>
                    </label>
                </div>
                <p class="sh-form-error" id="sh-schedule-error" role="alert" hidden></p>
                <div class="sh-form-actions sh-between">
                    <button type="button" class="sh-btn sh-btn-outline-danger" id="sh-schedule-delete" hidden>Delete</button>
                    <div class="sh-form-actions-right">
                        <button type="button" class="sh-btn sh-btn-ghost" data-sh-close>Close</button>
                        <button type="submit" class="sh-btn sh-btn-primary">Save</button>
                    </div>
                </div>
            </form>
            
            <div id="sh-schedule-details" hidden>
                <!-- Added flex classes to fix the clumping text issue -->
                <div class="grid grid-cols-2 gap-y-5 gap-x-4">
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Activity</span>
                        <strong id="sh-detail-type" class="text-sm font-extrabold text-white"></strong>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Date</span>
                        <strong id="sh-detail-date" class="text-sm font-extrabold text-white"></strong>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Time</span>
                        <strong id="sh-detail-time" class="text-sm font-extrabold text-white"></strong>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Trainer</span>
                        <strong id="sh-detail-coach" class="text-sm font-extrabold text-white"></strong>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Bookings</span>
                        <strong id="sh-detail-capacity" class="text-sm font-extrabold text-white"></strong>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Status</span>
                        <strong id="sh-detail-status" class="text-sm font-extrabold text-white"></strong>
                    </div>
                </div>

                @if (isTrainer)
                {
                    <div class="mt-6 border-t border-white/5 pt-5">
                        <span class="mb-2 block text-[10px] font-bold uppercase tracking-widest text-mono/50">Registered clients</span>
                        <div id="sh-detail-clients" class="text-sm text-mono"></div>
                    </div>
                }
                <p class="sh-form-error" id="sh-detail-error" role="alert" hidden></p>
                <div class="sh-form-actions sh-between">
                    @if (isTrainer)
                    {
                        <button type="button" class="sh-btn sh-btn-outline-danger" id="sh-schedule-cancel-slot">Cancel workout</button>
                        <button type="button" class="sh-btn sh-btn-primary" id="sh-schedule-edit">Edit</button>
                    }
                    else
                    {
                        <button type="button" class="sh-btn sh-btn-outline-danger" id="sh-schedule-cancel-booking">Cancel booking</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.PROFILE_SCHEDULE = {
        isTrainer: @JsonSerializer.Serialize(isTrainer),
        isClient: @JsonSerializer.Serialize(isClient),
        initialSlots: @Html.Raw(JsonSerializer.Serialize(scheduleData))
    };
</script>

<script src="~/js/admin/sh-common.js" asp-append-version="true"></script>
<script src="~/js/profile/profile-schedule.js" asp-append-version="true"></script>