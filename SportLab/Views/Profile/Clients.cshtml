@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Clients";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="text-3xl font-black uppercase tracking-tighter sm:text-4xl">Clients</h2>
        <p class="mt-1 text-sm text-mono/60">Goals, activity and subscription status at a glance.</p>
    </div>
    <label class="relative block">
        <span class="sr-only">Search clients</span>
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mono/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="table-search" type="search" placeholder="Search clients" class="w-full rounded-md bg-card py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-mono/40 focus:outline-none focus:ring-2 focus:ring-neon sm:w-64" />
    </label>
</div>

<div class="overflow-x-auto rounded-lg bg-card">
    <table class="w-full min-w-[760px] text-left text-sm">
        <thead>
            <tr class="border-b border-white/10 text-[11px] font-bold uppercase tracking-widest text-mono/50">
                <th scope="col" class="px-5 py-4">Client</th>
                <th scope="col" class="px-5 py-4">Primary goal</th>
                <th scope="col" class="px-5 py-4">Last workout</th>
                <th scope="col" class="px-5 py-4">Subscription</th>
                <th scope="col" class="px-5 py-4 text-right">Actions</th>
            </tr>
        </thead>
        <tbody id="clients-table-body" class="divide-y divide-white/5"></tbody>
    </table>
    <p id="table-empty" class="hidden p-8 text-center text-sm text-mono/60">No clients match your search.</p>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var $ = function (id) { return document.getElementById(id); };
            var CLIENTS = [
                { name: 'Kateryna Melnyk', goal: 'Weight Loss', last: 'Oct 20, 2026', sub: 'Active' },
                { name: 'Arsen Vyshnevetskyi', goal: 'Strength', last: 'Oct 19, 2026', sub: 'Active' },
                { name: 'Oksana Paliichuk', goal: 'Flexibility', last: 'Oct 17, 2026', sub: 'Expiring' },
                { name: 'Taras Zymohliad', goal: 'Endurance', last: 'Oct 15, 2026', sub: 'Active' },
                { name: 'Yuliia Nestorenko', goal: 'Weight Maintenance', last: 'Oct 12, 2026', sub: 'Expiring' },
                { name: 'Ivan Moroz', goal: 'Weight Loss', last: 'Oct 10, 2026', sub: 'Active' }
            ];
            function initials(n) { return n.split(' ').map(function (x) { return x[0]; }).join('').slice(0, 2); }
            
            var searchInput = $('table-search'), tbody = $('clients-table-body'), empty = $('table-empty');
            if (searchInput && tbody && empty) {
                function renderTable() {
                    var q = searchInput.value.trim().toLowerCase();
                    var rows = CLIENTS.filter(function (c) { return c.name.toLowerCase().indexOf(q) !== -1; });
                    empty.classList.toggle('hidden', rows.length > 0);
                    tbody.innerHTML = rows.map(function (c) {
                        var active = c.sub === 'Active';
                        var badge = active ? 'bg-neon/15 text-neon' : 'bg-[#FFD93D]/15 text-[#FFD93D]';
                        var dot = active ? 'bg-neon' : 'bg-[#FFD93D]';
                        return '<tr class="transition-colors hover:bg-shell/60">' +
                            '<td class="px-5 py-4"><div class="flex items-center gap-3">' +
                                '<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-violet text-xs font-extrabold text-white">' + initials(c.name) + '</span>' +
                                '<span class="font-extrabold">' + c.name + '</span></div></td>' +
                            '<td class="px-5 py-4 text-mono">' + c.goal + '</td>' +
                            '<td class="px-5 py-4 text-mono/70">' + c.last + '</td>' +
                            '<td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ' + badge + '"><span class="h-1.5 w-1.5 rounded-full ' + dot + '"></span>' + c.sub + '</span></td>' +
                            '<td class="px-5 py-4"><div class="flex items-center justify-end gap-3">' +
                                '<button type="button" class="flex h-9 w-9 items-center justify-center rounded-md bg-shell text-white transition-colors hover:text-neon"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>' +
                                '<a href="#" class="text-xs font-bold uppercase tracking-widest text-neon underline-offset-4 hover:underline">View History</a>' +
                            '</div></td></tr>';
                    }).join('');
                }
                searchInput.addEventListener('input', renderTable);
                renderTable();
            }
        })();
    </script>
}