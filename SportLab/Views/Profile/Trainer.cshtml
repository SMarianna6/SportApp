@{
    ViewData["Title"] = "Trainer Dashboard & Workouts";
}

<div class="py-4">
    <!-- Trainer Header Bar -->
    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 mb-4 bg-white">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-4">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1567013127542-490d757e51fc?w=200&auto=format&fit=crop&q=80" 
                         alt="Alex Mercer" class="rounded-circle shadow object-fit-cover" width="96" height="96">
                    <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-white rounded-circle"></span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold mb-0">Coach Alex Mercer</h2>
                        <span class="badge bg-dark rounded-pill px-3">Senior Coach</span>
                    </div>
                    <p class="text-muted mb-1"><i class="bi bi-award me-1"></i>Head Strength & Conditioning &bull; CSCS Certified</p>
                    <p class="text-muted small mb-0"><i class="bi bi-star-fill text-warning me-1"></i>4.98 Rating (124 client reviews) &bull; 8 Active Trainees</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newSlotModal">
                    <i class="bi bi-plus-circle me-1"></i> Open New Class Slot
                </button>
                <a asp-action="Client" class="btn btn-outline-dark rounded-pill px-3">
                    <i class="bi bi-person me-1"></i> Client View
                </a>
            </div>
        </div>
    </div>

    <!-- Trainer Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 rounded-4 shadow-sm p-3 p-md-4 text-center bg-light">
                <span class="text-muted small">Today's Sessions</span>
                <h3 class="fw-bold my-1 text-dark">4 Classes</h3>
                <span class="badge bg-primary-subtle text-primary">3 Group / 1 Private</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 rounded-4 shadow-sm p-3 p-md-4 text-center bg-light">
                <span class="text-muted small">Total Trainees Today</span>
                <h3 class="fw-bold my-1 text-dark">28 Athletes</h3>
                <span class="badge bg-success-subtle text-success">92% Occupancy</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 rounded-4 shadow-sm p-3 p-md-4 text-center bg-light">
                <span class="text-muted small">Monthly Hours</span>
                <h3 class="fw-bold my-1 text-dark">64.5 hrs</h3>
                <span class="badge bg-info-subtle text-info">Target: 80 hrs</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 rounded-4 shadow-sm p-3 p-md-4 text-center bg-light">
                <span class="text-muted small">Coaching Payout</span>
                <h3 class="fw-bold my-1 text-dark">$2,580</h3>
                <span class="badge bg-success-subtle text-success">Updated Today</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Today's Schedule -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Today's Assigned Sessions</h5>
                    <span class="badge bg-dark rounded-pill px-3">Thursday, Oct 08</span>
                </div>

                <div class="d-flex flex-column gap-3" id="trainerSlotsList">
                    <!-- Slot 1 -->
                    <div class="p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary-subtle text-primary text-center rounded-3 p-2 px-3 fw-bold">
                                10:30<br><small class="fw-normal">11:45</small>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Powerlifting Biomechanics</h6>
                                <small class="text-muted">Iron Zone &bull; 8 / 10 Participants Booked</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-success">Confirmed</span>
                            <button class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="alert('Roster: Alex Smith, Daria Kovalchuk, Taras Boyko, +5 others')">Roster</button>
                        </div>
                    </div>

                    <!-- Slot 2 -->
                    <div class="p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light text-dark text-center rounded-3 p-2 px-3 fw-bold">
                                15:00<br><small class="fw-normal">16:00</small>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">1-on-1 Personal Training</h6>
                                <small class="text-muted">Private Studio 2 &bull; Client: Dmytro Romanov (#10621)</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-info">1-on-1 VIP</span>
                            <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-chat me-1"></i>Message</a>
                        </div>
                    </div>

                    <!-- Slot 3 -->
                    <div class="p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-dark text-white text-center rounded-3 p-2 px-3 fw-bold">
                                20:15<br><small class="fw-normal">21:15</small>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Upper Body Sculpt & Pump</h6>
                                <small class="text-muted">Hypertrophy Lab &bull; 12 / 12 Capacity (Full)</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-warning text-dark">Full Capacity</span>
                            <button class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="alert('Full capacity reached! 12 members confirmed.')">Roster</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainee Management -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-people-fill me-2 text-primary"></i>My Assigned Athletes</h5>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=60&auto=format&fit=crop&q=80" class="rounded-circle object-fit-cover" width="36" height="36" alt="Alex Smith">
                            <div>
                                <div class="fw-bold small">Alex Smith</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Goal: Powerlifting Total</div>
                            </div>
                        </div>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-light border rounded-circle"><i class="bi bi-chat-dots"></i></a>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=60&auto=format&fit=crop&q=80" class="rounded-circle object-fit-cover" width="36" height="36" alt="Dmytro R.">
                            <div>
                                <div class="fw-bold small">Dmytro Romanov</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Goal: Body Composition</div>
                            </div>
                        </div>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-light border rounded-circle"><i class="bi bi-chat-dots"></i></a>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=60&auto=format&fit=crop&q=80" class="rounded-circle object-fit-cover" width="36" height="36" alt="Daria K.">
                            <div>
                                <div class="fw-bold small">Daria Kovalchuk</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Goal: Strength & Mobility</div>
                            </div>
                        </div>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-light border rounded-circle"><i class="bi bi-chat-dots"></i></a>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100 rounded-pill btn-sm">
                        View Club Schedule
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal to Add New Workout Slot -->
<div class="modal fade" id="newSlotModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Open New Workout Slot</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="newSlotForm" onsubmit="createSlot(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Class / Session Title</label>
                        <input type="text" id="slotTitle" class="form-control rounded-3" placeholder="e.g. Deadlift Precision Workshop" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Start Time</label>
                            <input type="time" id="slotStart" class="form-control rounded-3" value="16:00" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">End Time</label>
                            <input type="time" id="slotEnd" class="form-control rounded-3" value="17:15" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Zone / Room</label>
                        <select id="slotZone" class="form-select rounded-3">
                            <option>Iron Zone & Racks</option>
                            <option>CrossFit Zone</option>
                            <option>Hypertrophy Lab</option>
                            <option>Combat Arena</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Max Capacity</label>
                        <input type="number" id="slotCap" class="form-control rounded-3" value="12" min="1" max="30">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
                        Publish Slot to Club Schedule
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function createSlot(e) {
        e.preventDefault();
        const title = document.getElementById('slotTitle').value;
        const start = document.getElementById('slotStart').value;
        const end = document.getElementById('slotEnd').value;
        const zone = document.getElementById('slotZone').value;

        const list = document.getElementById('trainerSlotsList');
        const card = document.createElement('div');
        card.className = 'p-3 rounded-4 border bg-white d-flex flex-wrap justify-content-between align-items-center gap-3 table-success';
        card.innerHTML = `
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white text-center rounded-3 p-2 px-3 fw-bold">
                    ${start}<br><small class="fw-normal">${end}</small>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">${title}</h6>
                    <small class="text-muted">${zone} &bull; 0 Participants (Just Published)</small>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-success">Published</span>
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="alert('Session opened for bookings!')">Manage</button>
            </div>
        `;
        list.appendChild(card);

        const modalEl = document.getElementById('newSlotModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
        alert('🎉 New workout slot published and available for members in the schedule!');
    }
</script>
