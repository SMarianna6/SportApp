@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Trainer Profile";
}

<div class="mb-6">
    <h2 class="text-3xl font-black uppercase tracking-tighter sm:text-4xl">Welcome back, <span class="text-neon">Alex</span></h2>
    <p class="mt-1 text-sm text-mono/60">Manage your profile, clients and sessions.</p>
</div>

<div class="grid grid-cols-1 gap-5 xl:grid-cols-5">
    <!-- Professional information -->
    <section class="rounded-lg bg-card p-5 xl:col-span-3" aria-labelledby="pro-title">
        <h3 id="pro-title" class="mb-4 text-lg font-extrabold uppercase tracking-tight">Professional Information</h3>
        <div class="grid gap-6 md:grid-cols-5">
            <figure class="relative overflow-hidden rounded-lg bg-shell md:col-span-2">
                <img src="~/images/trainer.png" alt="Portrait of trainer" class="aspect-[4/5] h-full w-full object-cover" loading="lazy" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-shell via-shell/80 to-transparent p-4 pt-12">
                    <p class="text-lg font-black uppercase leading-none tracking-tighter">Alex Morgan</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-widest text-neon">Head Trainer</p>
                </figcaption>
            </figure>
            <div class="space-y-4 md:col-span-3">
                <div class="editable" data-multiline="false" data-field="name">
                    <p class="mb-1 text-[11px] font-semibold uppercase tracking-widest text-mono/50">Full name</p>
                    <div class="flex items-start justify-between gap-2">
                        <p class="editable-text text-sm font-semibold">Alex Morgan</p>
                        <button type="button" class="edit-btn shrink-0 rounded-md p-1.5 text-mono/60 transition-colors hover:text-neon" aria-label="Edit full name">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="editable" data-multiline="false" data-field="dob">
                    <p class="mb-1 text-[11px] font-semibold uppercase tracking-widest text-mono/50">Date of birth</p>
                    <div class="flex items-start justify-between gap-2">
                        <p class="editable-text text-sm font-semibold">April 15, 1994</p>
                        <button type="button" class="edit-btn shrink-0 rounded-md p-1.5 text-mono/60 transition-colors hover:text-neon" aria-label="Edit date of birth">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="editable" data-multiline="false" data-field="exp">
                    <p class="mb-1 text-[11px] font-semibold uppercase tracking-widest text-mono/50">Experience</p>
                    <div class="flex items-start justify-between gap-2">
                        <p class="editable-text text-sm font-semibold">8 years, NASM certified</p>
                        <button type="button" class="edit-btn shrink-0 rounded-md p-1.5 text-mono/60 transition-colors hover:text-neon" aria-label="Edit experience">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="editable" data-multiline="true" data-field="about">
                    <p class="mb-1 text-[11px] font-semibold uppercase tracking-widest text-mono/50">About me</p>
                    <div class="flex items-start justify-between gap-2">
                        <p class="editable-text text-sm leading-relaxed text-mono">I help busy people build strength and confidence with short, focused programs. My sessions blend functional training with mobility work.</p>
                        <button type="button" class="edit-btn shrink-0 rounded-md p-1.5 text-mono/60 transition-colors hover:text-neon" aria-label="Edit about me">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        </button>
                    </div>
                </div>
                <div>
                    <p id="spec-label" class="mb-1 text-[11px] font-semibold uppercase tracking-widest text-mono/50">Specializations</p>
                    <div class="relative" id="spec-wrap">
                        <button id="spec-trigger" type="button" class="flex w-full items-center justify-between rounded-md bg-shell px-3 py-2.5 text-left text-sm font-semibold text-mono transition-colors hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon" aria-haspopup="true" aria-expanded="false" aria-controls="spec-menu">
                            <span>Select specializations</span>
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <ul id="spec-menu" class="absolute left-0 right-0 z-10 mt-1 hidden max-h-60 overflow-y-auto rounded-md bg-shell p-1 shadow-xl" role="group"></ul>
                    </div>
                    <ul id="spec-pills" class="mt-3 flex flex-wrap gap-2" aria-live="polite"></ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Work schedule -->
    <section class="rounded-lg bg-card p-5 xl:order-last xl:col-span-2" aria-labelledby="sched-title">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h3 id="sched-title" class="text-lg font-extrabold uppercase tracking-tight">Work Schedule</h3>
            <div class="flex rounded-md bg-shell p-1" role="tablist">
                <button type="button" role="tab" data-day="today" aria-selected="true" class="day-tab rounded px-3 py-1.5 text-xs font-bold uppercase tracking-wider">Today</button>
                <button type="button" role="tab" data-day="tomorrow" aria-selected="false" class="day-tab rounded px-3 py-1.5 text-xs font-bold uppercase tracking-wider">Tomorrow</button>
            </div>
        </div>
        <ol id="timeline" class="relative space-y-3"></ol>
        <div id="empty-schedule" class="hidden flex-col items-center rounded-lg bg-shell px-6 py-10 text-center">
            <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-card text-neon">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/></svg>
            </span>
            <p class="text-base font-extrabold uppercase tracking-tight">No workouts booked</p>
            <p class="mt-1 max-w-xs text-sm text-mono/60">Your calendar is open. Add availability so clients can book you.</p>
            <button id="create-slot-btn" type="button" class="mt-5 rounded-md bg-neon px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-shell transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Create available slot</button>
        </div>
    </section>

    <!-- Clients Widget -->
    <section class="rounded-lg bg-card p-5 xl:col-span-5 xl:row-start-2" aria-labelledby="clients-title">
        <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h3 id="clients-title" class="text-lg font-extrabold uppercase tracking-tight">My Clients <span id="clients-count" class="ml-1 text-sm font-semibold text-mono/50"></span></h3>
            <div class="flex flex-col gap-2 sm:flex-row">
                <label class="relative block">
                    <span class="sr-only">Search clients</span>
                    <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mono/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input id="client-search" type="search" placeholder="Search clients" class="w-full rounded-md bg-shell py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-mono/40 focus:outline-none focus:ring-2 focus:ring-neon sm:w-56" />
                </label>
                <label class="block">
                    <span class="sr-only">Sort clients</span>
                    <select id="client-sort" class="w-full rounded-md bg-shell px-3 py-2.5 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-neon sm:w-36">
                        <option value="recent">Recent</option>
                        <option value="az">A-Z</option>
                        <option value="workouts">Most workouts</option>
                    </select>
                </label>
            </div>
        </div>
        <div id="clients-grid" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
        <p id="clients-empty" class="hidden rounded-lg bg-shell p-8 text-center text-sm text-mono/60">No clients match your search.</p>
    </section>
</div>

<!-- Create slot modal -->
<div id="modal-slot" class="modal fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="slot-title">
    <div class="modal-overlay absolute inset-0 bg-black/90"></div>
    <div class="relative w-full max-w-md transform-gpu rounded-lg bg-card p-6 shadow-2xl">
        <button type="button" data-close class="absolute right-3 top-3 rounded-md p-2 text-mono/60 hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <h3 id="slot-title" class="text-2xl font-black uppercase tracking-tighter">Create <span class="text-neon">slot</span></h3>
        <p class="mt-1 text-sm text-mono/60">Open a time window clients can book.</p>
        <form id="slot-form" class="mt-5 space-y-4">
            <div>
                <label for="slot-date" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">Date</label>
                <input id="slot-date" type="date" required class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="slot-start" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">Start time</label>
                    <input id="slot-start" type="time" required class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
                <div>
                    <label for="slot-end" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">End time</label>
                    <input id="slot-end" type="time" required class="w-full rounded-md bg-shell px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon" />
                </div>
            </div>
            <div>
                <label for="slot-type" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-mono/50">Workout type</label>
                <select id="slot-type" class="w-full rounded-md bg-shell px-3 py-2.5 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-neon">
                    <option>Strength</option><option>Boxing</option><option>Yoga</option><option>Cardio</option>
                </select>
            </div>
            <p id="slot-error" class="hidden text-sm font-semibold text-[#FF5252]" role="alert"></p>
            <button type="submit" class="w-full rounded-md bg-neon py-3.5 text-sm font-extrabold uppercase tracking-widest text-shell transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Save Slot</button>
        </form>
    </div>
</div>

<!-- Cancel workout modal -->
<div id="modal-cancel" class="modal fixed inset-0 z-[100] hidden items-center justify-center p-4" role="alertdialog" aria-modal="true" aria-labelledby="cancel-title">
    <div class="modal-overlay absolute inset-0 bg-black/90"></div>
    <div class="relative w-full max-w-sm transform-gpu rounded-lg bg-card p-6 shadow-2xl">
        <button type="button" data-close class="absolute right-3 top-3 rounded-md p-2 text-mono/60 hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#FF5252]/15 text-[#FF5252]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
        </span>
        <h3 id="cancel-title" class="text-2xl font-black uppercase tracking-tighter">Cancel workout</h3>
        <p class="mt-2 text-sm text-mono/70">Are you sure you want to cancel this session? The client will be notified.</p>
        <p id="cancel-summary" class="mt-3 rounded-md bg-shell px-3 py-2 text-xs font-bold text-mono"></p>
        <div class="mt-6 flex gap-3">
            <button type="button" data-close class="flex-1 rounded-md border border-white/20 py-3 text-xs font-extrabold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">Keep</button>
            <button type="button" id="cancel-confirm" class="flex-1 rounded-md bg-[#FF5252] py-3 text-xs font-extrabold uppercase tracking-widest text-white transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Confirm Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var $ = function (id) { return document.getElementById(id); };

            /* ---------- Inline editing ---------- */
            var penSvg = '<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';
            document.querySelectorAll('.editable').forEach(function (box) {
                var textEl = box.querySelector('.editable-text'), btn = box.querySelector('.edit-btn');
                if(!textEl || !btn) return;
                var multi = box.dataset.multiline === 'true';
                btn.addEventListener('click', function () {
                    if (box.querySelector('.editor')) return;
                    var input = document.createElement(multi ? 'textarea' : 'input');
                    input.className = 'editor w-full rounded-md bg-shell px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-neon';
                    if (multi) input.rows = 4; else input.type = 'text';
                    input.value = textEl.textContent;
                    textEl.classList.add('hidden');
                    textEl.parentNode.insertBefore(input, textEl);
                    btn.innerHTML = '<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
                    btn.classList.add('text-neon');
                    input.focus();
                    var done = false;
                    function save() {
                        if (done) return; done = true;
                        var v = input.value.trim();
                        if (v) textEl.textContent = v;
                        input.remove(); textEl.classList.remove('hidden');
                        btn.innerHTML = penSvg; btn.classList.remove('text-neon');
                    }
                    btn.addEventListener('click', save, { once: true });
                    input.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape') { input.value = textEl.textContent; save(); }
                        if (e.key === 'Enter' && (!multi || e.ctrlKey || e.metaKey)) { e.preventDefault(); save(); }
                    });
                });
            });

            /* ---------- Specializations ---------- */
            var SPECS = ['CrossFit', 'Pilates', 'Yoga', 'Strength', 'HIIT', 'Boxing', 'Mobility', 'Nutrition'];
            var selected = { CrossFit: true, Strength: true };
            var trigger = $('spec-trigger'), menu = $('spec-menu'), pills = $('spec-pills');
            if (menu && trigger && pills) {
                menu.innerHTML = SPECS.map(function (s, i) {
                    return '<li><label class="flex cursor-pointer items-center gap-3 rounded px-3 py-2 text-sm font-medium text-mono hover:bg-card">' +
                        '<input type="checkbox" value="' + s + '" class="h-4 w-4 shrink-0 cursor-pointer accent-[#AAFF00]"' + (selected[s] ? ' checked' : '') + ' />' + s + '</label></li>';
                }).join('');
                function renderPills() {
                    var keys = SPECS.filter(function (s) { return selected[s]; });
                    pills.innerHTML = keys.length ? keys.map(function (s) {
                        return '<li class="inline-flex items-center gap-1.5 rounded-full border border-neon bg-shell py-1 pl-3 pr-1.5 text-xs font-bold uppercase tracking-wider text-neon">' + s +
                            '<button type="button" data-remove="' + s + '" class="flex h-4 w-4 items-center justify-center rounded-full hover:bg-neon hover:text-shell"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button></li>';
                    }).join('') : '<li class="text-xs text-mono/50">None selected</li>';
                    trigger.firstElementChild.textContent = keys.length ? keys.length + ' selected' : 'Select specializations';
                }
                function setMenu(open) { menu.classList.toggle('hidden', !open); trigger.setAttribute('aria-expanded', String(open)); }
                trigger.addEventListener('click', function () { setMenu(menu.classList.contains('hidden')); });
                menu.addEventListener('change', function (e) { if (e.target.type === 'checkbox') { selected[e.target.value] = e.target.checked; renderPills(); } });
                pills.addEventListener('click', function (e) {
                    var b = e.target.closest('[data-remove]'); if (!b) return;
                    selected[b.dataset.remove] = false;
                    var cb = menu.querySelector('input[value="' + b.dataset.remove + '"]'); if (cb) cb.checked = false;
                    renderPills();
                });
                document.addEventListener('click', function (e) { if (!$('spec-wrap').contains(e.target)) setMenu(false); });
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });
                renderPills();
            }

            /* ---------- Clients Grid ---------- */
            var CLIENTS = [
                { name: 'Emma Wilson', workouts: 12, recent: 1, data: [82, 81, 80.5, 79.8, 79, 78.4, 77.9] },
                { name: 'Liam Carter', workouts: 24, recent: 2, data: [92, 92.5, 93, 93.4, 94, 94.2, 95] },
                { name: 'Sofia Rossi', workouts: 8, recent: 3, data: [64, 63.5, 63.8, 63, 62.6, 62.4, 62] },
                { name: 'Noah Kim', workouts: 17, recent: 4, data: [78, 77, 77.5, 76, 75.4, 75, 74.2] },
                { name: 'Ava Johnson', workouts: 5, recent: 5, data: [70, 70.2, 69.8, 69.5, 69.9, 70.1, 70.2] },
                { name: 'Lucas Meyer', workouts: 31, recent: 6, data: [88, 87, 86.2, 85.5, 85, 84.1, 83.6] }
            ];
            var colors = ['#7D51FE', '#AAFF00', '#7D51FE', '#AAFF00', '#7D51FE', '#AAFF00'];
            function trendColor(delta) { return delta > 0.5 ? '#AAFF00' : delta < -0.5 ? '#FF5252' : '#FFD93D'; }
            function spark(data) {
                var w = 220, h = 90, left = 30, right = 6, top = 8, bottom = 8;
                var min = Math.min.apply(null, data), max = Math.max.apply(null, data);
                var range = (max - min) || 1, base = data[0], delta = data[data.length - 1] - base, color = trendColor(delta);
                var plotW = w - left - right, plotH = h - top - bottom;
                function xAt(i) { return left + i * plotW / (data.length - 1); }
                function yAt(v) { return top + plotH - ((v - min) / range) * plotH; }
                var grid = '';
                [0, 0.5, 1].forEach(function (t) {
                    var v = min + range * (1 - t), y = top + plotH * t, rel = v - base;
                    var label = (rel > 0.05 ? '+' : rel < -0.05 ? '-' : '') + Math.abs(rel).toFixed(1) + ' kg';
                    grid += '<line x1="' + left + '" y1="' + y.toFixed(1) + '" x2="' + (w - right) + '" y2="' + y.toFixed(1) + '" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"/>' +
                            '<text x="' + (left - 4) + '" y="' + (y + 2.5).toFixed(1) + '" text-anchor="end" font-size="7" fill="#ffffff" fill-opacity="0.4">' + label + '</text>';
                });
                data.forEach(function (_, i) { grid += '<line x1="' + xAt(i).toFixed(1) + '" y1="' + top + '" x2="' + xAt(i).toFixed(1) + '" y2="' + (h - bottom) + '" stroke="#ffffff" stroke-opacity="0.05" stroke-width="1"/>'; });
                var pts = data.map(function (v, i) { return xAt(i).toFixed(1) + ',' + yAt(v).toFixed(1); });
                return '<svg viewBox="0 0 ' + w + ' ' + h + '" class="block h-auto w-full">' + grid +
                    '<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + color + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
                    '<circle cx="' + xAt(data.length - 1).toFixed(1) + '" cy="' + yAt(data[data.length - 1]).toFixed(1) + '" r="3" fill="' + color + '"/></svg>';
            }
            function initials(n) { return n.split(' ').map(function (x) { return x[0]; }).join('').slice(0, 2); }
            
            var searchInput = $('client-search'), sortSelect = $('client-sort'), countEl = $('clients-count'), emptyEl = $('clients-empty'), gridEl = $('clients-grid');
            if (gridEl) {
                function renderClients() {
                    var q = searchInput ? searchInput.value.trim().toLowerCase() : '';
                    var sort = sortSelect ? sortSelect.value : 'recent';
                    var list = CLIENTS.filter(function (c) { return c.name.toLowerCase().indexOf(q) !== -1; });
                    list.sort(function (a, b) {
                        if (sort === 'az') return a.name.localeCompare(b.name);
                        if (sort === 'workouts') return b.workouts - a.workouts;
                        return a.recent - b.recent;
                    });
                    if (countEl) countEl.textContent = '(' + list.length + ')';
                    if (emptyEl) emptyEl.classList.toggle('hidden', list.length > 0);
                    gridEl.innerHTML = list.map(function (c) {
                        var idx = CLIENTS.indexOf(c), delta = (c.data[c.data.length - 1] - c.data[0]).toFixed(1);
                        return '<article class="flex flex-col gap-4 rounded-lg bg-shell p-4 transition-transform duration-200 hover:-translate-y-0.5">' +
                            '<div class="flex items-center gap-3"><div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-sm font-extrabold ' + (colors[idx] === '#AAFF00' ? 'bg-neon text-shell' : 'bg-violet text-white') + '">' + initials(c.name) + '</div>' +
                            '<div class="min-w-0"><h4 class="truncate text-base font-extrabold tracking-tight">' + c.name + '</h4><p class="text-xs text-mono/50">Weight ' + (delta > 0 ? '+' : '') + delta + ' kg / 7 wks</p></div></div>' +
                            '<div class="rounded-md bg-card px-3 py-2">' + spark(c.data) + '</div>' +
                            '<div class="flex items-center justify-between"><p class="text-sm text-mono">Workouts attended: <span class="font-extrabold text-neon">' + c.workouts + '</span></p>' +
                            '<button type="button" class="flex h-10 w-10 items-center justify-center rounded-md bg-card text-white transition-colors hover:bg-violet"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg></button></div></article>';
                    }).join('');
                }
                if (searchInput) searchInput.addEventListener('input', renderClients);
                if (sortSelect) sortSelect.addEventListener('change', renderClients);
                renderClients();
            }

            /* ---------- Modals & Schedule ---------- */
            var openModalEl = null;
            function openModal(id) {
                openModalEl = $(id); if(!openModalEl) return;
                openModalEl.classList.remove('hidden'); openModalEl.classList.add('flex'); document.body.style.overflow = 'hidden';
            }
            function closeModal() {
                if (!openModalEl) return;
                openModalEl.classList.add('hidden'); openModalEl.classList.remove('flex'); document.body.style.overflow = ''; openModalEl = null;
            }
            document.querySelectorAll('.modal').forEach(function (m) {
                m.querySelector('.modal-overlay').addEventListener('click', closeModal);
                m.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
            });
            
            var icons = { strength: '<path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11"/>', yoga: '<circle cx="12" cy="5" r="2"/><path d="M12 7v6m-6 2 6-2 6 2M8 21l4-8 4 8"/>', cardio: '<path d="M3 12h4l3-8 4 16 3-8h4"/>', boxing: '<path d="M7 11V7a3 3 0 0 1 6 0v1h3a3 3 0 0 1 3 3v4a6 6 0 0 1-6 6h-2a6 6 0 0 1-6-6v-2a2 2 0 0 1 2-2Z"/>' };
            var SCHEDULE = {
                today: [{ time: '09:00 AM', client: 'Emma Wilson', type: 'Strength', icon: 'strength' }, { time: '11:30 AM', client: 'Liam Carter', type: 'Boxing', icon: 'boxing' }, { time: '02:00 PM', client: 'Sofia Rossi', type: 'Yoga', icon: 'yoga' }, { time: '05:30 PM', client: 'Noah Kim', type: 'Cardio', icon: 'cardio' }],
                tomorrow: []
            };
            var currentDay = 'today';
            function renderSchedule(day) {
                currentDay = day; var items = SCHEDULE[day]; var tl = $('timeline'), empty = $('empty-schedule'); if(!tl || !empty) return;
                tl.classList.toggle('hidden', !items.length); empty.classList.toggle('hidden', !!items.length); empty.classList.toggle('flex', !items.length);
                tl.innerHTML = items.map(function (s, i) {
                    return '<li class="flex gap-3"><div class="flex w-20 shrink-0 flex-col items-end pt-3"><span class="text-xs font-extrabold text-neon">' + s.time + '</span></div>' +
                        '<button type="button" data-idx="' + i + '" class="slot-btn group relative flex flex-1 items-center gap-3 rounded-lg bg-shell p-3 pl-4 text-left transition-colors hover:bg-black focus:outline-none" style="box-shadow: inset 3px 0 0 ' + (i % 2 ? '#7D51FE' : '#AAFF00') + '">' +
                        '<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-card text-neon"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + icons[s.icon] + '</svg></span>' +
                        '<div class="min-w-0 flex-1"><p class="truncate text-sm font-extrabold">' + s.client + '</p><p class="text-xs text-mono/60">' + s.type + ' session</p></div>' +
                        '<span class="ml-auto text-[11px] font-bold uppercase tracking-wider text-mono/40 transition-colors group-hover:text-[#FF5252]">Cancel</span></button></li>';
                }).join('');
                document.querySelectorAll('.day-tab').forEach(function (t) {
                    var on = t.dataset.day === day; t.setAttribute('aria-selected', String(on));
                    t.className = 'day-tab rounded px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition-colors ' + (on ? 'bg-neon text-shell' : 'text-mono hover:text-neon');
                });
            }
            document.querySelectorAll('.day-tab').forEach(function (t) { t.addEventListener('click', function () { renderSchedule(t.dataset.day); }); });
            renderSchedule('today');

            function to12h(hhmm) { var p = hhmm.split(':'), h = +p[0], m = p[1], suffix = h >= 12 ? 'PM' : 'AM'; return (('0' + ((h % 12) || 12)).slice(-2)) + ':' + m + ' ' + suffix; }
            function toMins(l) { var m = l.match(/(\d+):(\d+) (AM|PM)/); return ((+m[1] % 12) + (m[3] === 'PM' ? 12 : 0)) * 60 + +m[2]; }
            function todayISO() { var d = new Date(); return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
            
            if($('create-slot-btn')) $('create-slot-btn').addEventListener('click', function () { $('slot-error').classList.add('hidden'); $('slot-date').min = todayISO(); openModal('modal-slot'); });
            if($('slot-form')) $('slot-form').addEventListener('submit', function (e) {
                e.preventDefault(); var start = $('slot-start').value, end = $('slot-end').value, type = $('slot-type').value, err = $('slot-error');
                if (end <= start) { err.textContent = 'End time must be after the start time.'; err.classList.remove('hidden'); return; }
                var day = $('slot-date').value === todayISO() ? 'today' : 'tomorrow', iconKey = { Strength: 'strength', Boxing: 'boxing', Yoga: 'yoga', Cardio: 'cardio' }[type];
                SCHEDULE[day].push({ time: to12h(start), client: 'Available slot', type: type, icon: iconKey });
                SCHEDULE[day].sort(function (a, b) { return toMins(a.time) - toMins(b.time); });
                closeModal(); $('slot-form').reset(); renderSchedule(day);
            });

            var pending = null;
            if($('timeline')) $('timeline').addEventListener('click', function (e) {
                var btn = e.target.closest('.slot-btn'); if (!btn) return;
                var item = SCHEDULE[currentDay][+btn.dataset.idx];
                pending = { day: currentDay, index: +btn.dataset.idx };
                $('cancel-summary').textContent = item.time + ' - ' + item.client + ' (' + item.type + ')';
                openModal('modal-cancel');
            });
            if($('cancel-confirm')) $('cancel-confirm').addEventListener('click', function () {
                if (!pending) return; SCHEDULE[pending.day].splice(pending.index, 1);
                pending = null; closeModal(); renderSchedule(currentDay);
            });
        })();
    </script>
}