@model List<SportLab.Models.WorkoutSlot>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var upcoming = Model.Where(s => s.StartTime >= DateTime.Now && s.Status != "Cancelled").OrderBy(s => s.StartTime).ToList();
    var history = Model.Where(s => s.StartTime < DateTime.Now || s.Status == "Cancelled").OrderByDescending(s => s.StartTime).ToList();
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-4xl">

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Client Area</p>
                <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">My Bookings</h1>
                <p class="mt-1 text-sm text-white/50">Your upcoming and past training sessions.</p>
            </div>
            <a asp-controller="Schedule" asp-action="Index" class="rounded-md bg-neon px-4 py-2.5 text-xs font-extrabold uppercase tracking-widest text-black transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neon/30">
                Book a Session
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-neon/30 bg-neon/10 px-4 py-3 text-sm font-semibold text-neon">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm font-semibold text-red-400">
                @TempData["ErrorMessage"]
            </div>
        }

        <h2 class="mb-4 text-xs font-extrabold uppercase tracking-widest text-white/40">Upcoming (@upcoming.Count)</h2>

        @if (!upcoming.Any())
        {
            <div class="mb-10 rounded-lg border border-dashed border-white/10 p-8 text-center text-sm text-white/30">
                You have no upcoming sessions.
                <a asp-controller="Schedule" asp-action="Index" class="text-neon hover:underline">Browse the schedule</a>
            </div>
        }
        else
        {
            <div class="mb-10 space-y-3">
                @foreach (var slot in upcoming)
                {
                    <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                        <div class="flex items-center gap-4">
                            <div class="rounded-md bg-neon/10 px-3 py-2 text-center">
                                <p class="text-[10px] font-extrabold uppercase tracking-widest text-neon/70">@slot.StartTime.ToString("MMM")</p>
                                <p class="text-xl font-black text-neon">@slot.StartTime.ToString("dd")</p>
                            </div>
                            <div>
                                <p class="font-black uppercase tracking-tight">@(slot.ActivityName ?? "Workout")</p>
                                <p class="text-xs text-white/50">@slot.StartTime.ToString("dddd, HH:mm") – @slot.EndTime.ToString("HH:mm")</p>
                                <p class="mt-1 text-xs text-white/40">Trainer: @(slot.Trainer?.Name ?? "To be confirmed")</p>
                            </div>
                        </div>
                        <form asp-action="CancelBooking" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@slot.Id" />
                            <button type="submit" class="rounded-md bg-red-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-red-400 transition-colors hover:bg-red-500/20">
                                Cancel
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        @if (history.Any())
        {
            <h2 class="mb-4 text-xs font-extrabold uppercase tracking-widest text-white/40">History (@history.Count)</h2>
            <div class="space-y-3">
                @foreach (var slot in history)
                {
                    <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-white/10 bg-[#161616] p-4 opacity-70">
                        <div>
                            <p class="font-bold uppercase tracking-tight">@(slot.ActivityName ?? "Workout")</p>
                            <p class="text-xs text-white/50">@slot.StartTime.ToString("dd.MM.yyyy HH:mm") – @slot.EndTime.ToString("HH:mm") · @(slot.Trainer?.Name ?? "Trainer")</p>
                        </div>
                        <span class="rounded-md bg-white/10 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest text-white/60">@slot.Status</span>
                    </div>
                }
            </div>
        }

    </div>
</div>
