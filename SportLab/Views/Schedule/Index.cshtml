                        <div>
                            <div class="small fw-bold">Elena Rostova</div>
                            <div class="text-muted" style="font-size: 0.75rem;">FRC® & Yoga Lead</div>
                        </div>
                        <div class="ms-auto text-end">
                            <span class="badge bg-success-subtle text-success">8 spots left</span>
