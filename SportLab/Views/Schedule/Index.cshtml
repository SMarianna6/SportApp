<!-- Booking Confirmation Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Confirm Workout Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 bg-light rounded-3 mb-3">
                    <h5 id="bookClassTitle" class="fw-bold mb-1 text-primary"></h5>
                    <div class="text-muted small mb-1"><i class="bi bi-clock me-1"></i> <span id="bookClassTime"></span></div>
                    <div class="text-muted small mb-1"><i class="bi bi-person me-1"></i> Coach: <span id="bookClassCoach"></span></div>
                    <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i> Location: <span id="bookClassRoom"></span></div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Member Name</label>
                    <input type="text" class="form-control" value="Member #10842 (Alex Smith)" readonly />
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="smsReminder" checked>
                    <label class="form-check-label small text-muted" for="smsReminder">
                        Send SMS & calendar reminder 2 hours prior
                    </label>
                </div>
                <button type="button" class="btn btn-primary w-100 rounded-pill py-2" onclick="confirmBooking()">
                    Confirm Reservation
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentDay = 'Mon';
    let currentCat = 'all';

    function filterClasses() {
        const items = document.querySelectorAll('.schedule-item');
        items.forEach(item => {
            const days = item.getAttribute('data-day');
            const cat = item.getAttribute('data-cat');

            const matchDay = days.includes(currentDay);
            const matchCat = (currentCat === 'all' || cat === currentCat);

            if (matchDay && matchCat) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    document.querySelectorAll('.day-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentDay = tab.getAttribute('data-day');
            filterClasses();
        });
    });

    document.querySelectorAll('.cat-filter').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.cat-filter').forEach(b => {
                b.classList.remove('active', 'btn-dark');
                b.classList.add('btn-outline-dark');
            });
            btn.classList.add('active', 'btn-dark');
            btn.classList.remove('btn-outline-dark');
            currentCat = btn.getAttribute('data-cat');
            filterClasses();
        });
    });

    function bookSession(title, time, coach, room) {
        document.getElementById('bookClassTitle').innerText = title;
        document.getElementById('bookClassTime').innerText = time;
        document.getElementById('bookClassCoach').innerText = coach;
        document.getElementById('bookClassRoom').innerText = room;
        const modal = new bootstrap.Modal(document.getElementById('bookingModal'));
        modal.show();
    }

    function confirmBooking() {
        alert('✅ Workout spot confirmed! Added to your schedule in Profile.');
        const modalEl = document.getElementById('bookingModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    }

    // initial run
    filterClasses();
</script>
