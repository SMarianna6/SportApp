@{
    ViewData["Title"] = "Class & Workout Schedule";
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Club Timetable</span>
            <h1 class="display-5 fw-bold mb-1">Group Classes & Open Slots</h1>
            <p class="text-muted">Reserve your spot in high-energy group workouts or open gym coaching sessions.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Profile" asp-action="Client" class="btn btn-outline-dark rounded-pill px-3">
                <i class="bi bi-calendar-check me-1"></i> My Bookings
            </a>
        </div>
    </div>

    <!-- Day Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 p-2 mb-4 bg-light">
        <ul class="nav nav-pills nav-fill gap-2" id="dayTabs">
            <li class="nav-item">
                <button class="nav-link active rounded-pill fw-semibold py-2 day-tab" data-day="Mon">Mon <span class="d-none d-md-inline">Oct 12</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Tue">Tue <span class="d-none d-md-inline">Oct 13</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Wed">Wed <span class="d-none d-md-inline">Oct 14</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Thu">Thu <span class="d-none d-md-inline">Oct 15</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Fri">Fri <span class="d-none d-md-inline">Oct 16</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Sat">Sat <span class="d-none d-md-inline">Oct 17</span></button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-semibold py-2 day-tab" data-day="Sun">Sun <span class="d-none d-md-inline">Oct 18</span></button>
            </li>
        </ul>
    </div>

    <!-- Category Filters -->
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
        <span class="text-muted small fw-semibold me-2"><i class="bi bi-funnel me-1"></i>Filter by:</span>
        <button class="btn btn-sm btn-dark rounded-pill px-3 cat-filter active" data-cat="all">All Classes</button>
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3 cat-filter" data-cat="crossfit">CrossFit & HIIT</button>
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3 cat-filter" data-cat="strength">Strength & Power</button>
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3 cat-filter" data-cat="yoga">Yoga & Mobility</button>
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3 cat-filter" data-cat="combat">Boxing & Combat</button>
    </div>

    <!-- Class Grid -->
    <div class="row g-4" id="scheduleList">
        <!-- Item 1 -->
        <div class="col-lg-4 col-md-6 schedule-item" data-day="Mon Wed Fri" data-cat="crossfit">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-clock me-1"></i> 08:00 - 09:00</span>
                    <span class="badge bg-white text-primary">CrossFit Zone</span>
                </div>
                <div class="card-body p-4 d-flex flex-column">
