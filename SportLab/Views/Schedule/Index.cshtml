                        </div>
                    </div>

                    <div class="mt-auto">
                        <button class="btn btn-dark w-100 rounded-pill py-2" onclick="bookSession('Morning Metabolic Blast', '08:00 - 09:00', 'Sarah Jenkins', 'CrossFit Zone')">
                            Book Workout
                        </button>
