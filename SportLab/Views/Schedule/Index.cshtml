                </div>
            </div>
        </div>

        <!-- Item 4 -->
        <div class="col-lg-4 col-md-6 schedule-item" data-day="Tue Thu Sat" data-cat="combat">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white p-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-clock me-1"></i> 17:30 - 18:45</span>
