@using System.Text.Json
@model IEnumerable<SportLab.Models.WorkoutSlot>

@{
    ViewData["Title"] = "Workout Schedule";

    var currentUserId = int.TryParse(
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
        out var parsedUserId
    ) ? parsedUserId : (int?)null;

    bool isClient  = User.IsInRole(SportLab.Models.Roles.Client);
    bool isTrainer = User.IsInRole(SportLab.Models.Roles.Trainer);
    bool isAdmin   = User.IsAdmin();

    var today     = DateTime.Today;
    int diffDays  = ((int)today.DayOfWeek + 6) % 7;
    var weekStart = today.AddDays(-diffDays);

    var weekDates = Enumerable.Range(0, 7)
        .Select(i => weekStart.AddDays(i))
        .ToArray();

    var scheduleData = Model.Select(slot => new
    {
        id            = slot.Id,
        day           = ((int)slot.StartTime.DayOfWeek + 6) % 7,
        hour          = slot.StartTime.Hour,
        timeStart     = slot.StartTime.ToString("HH:mm"),
        timeEnd       = slot.EndTime.ToString("HH:mm"),
        startDateTime = slot.StartTime.ToString("o"),
        category      = slot.ActivityName ?? "HIIT",
        trainer       = slot.Trainer?.Name ?? "TBA",
        difficulty    = 2,
        capacity      = slot.Capacity,
        booked        = slot.Bookings.Count,
        status        = slot.Status,
        isBooked      = currentUserId.HasValue &&
                       slot.Bookings.Any(b => b.UserId == currentUserId.Value)
    }).ToList();
}

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Training Schedule | Sport HUB</title>
    <meta name="description" content="Browse and book weekly gym classes by trainer and category." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&display=swap" rel="stylesheet" />

    <style>
        .slot .capacity-label {
            opacity: 0;
            transform: translateY(4px);
            transition: all .3s ease;
        }

        .slot:hover .capacity-label,
        .slot:focus-visible .capacity-label {
            opacity: 1;
            transform: translateY(0);
        }

        .slot.is-full {
            filter: grayscale(1);
            cursor: not-allowed;
        }

        .slot.is-past {
            opacity: 0.4;
            cursor: not-allowed;
        }

        body.touch .slot .capacity-label {
            opacity: 1;
            transform: none;
        }

        body.modal-open {
            overflow: hidden;
        }

        .slot-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            pointer-events: none;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity .3s, transform .3s;
        }

        .slot-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .slot-toast.success { background: #DCFCE7; color: #166534; }
        .slot-toast.error   { background: #FEE2E2; color: #991B1B; }
    </style>
</head>

<body class="bg-mono-100 font-sans text-ink-900 antialiased">

    <header class="bg-ink-900 text-white">
        <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-14">
            <p class="mb-3 inline-flex items-center gap-2 rounded-md bg-neon px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-ink-900">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />
                </svg>
                Week schedule
            </p>
            <h1 class="text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-7xl md:text-8xl">
                Train <span class="text-neon">Harder.</span><br />Book Faster.
            </h1>
            <p class="mt-4 max-w-xl text-base font-normal text-white/60">
                Pick a class, check the room, lock in your spot.
            </p>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-5 rounded-md border border-green-500/30 bg-green-100 px-4 py-3 text-sm font-semibold text-green-900">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-5 rounded-md border border-red-500/30 bg-red-100 px-4 py-3 text-sm font-semibold text-red-900">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- FILTERS -->
        <section aria-label="Filters" class="mb-6 flex flex-col gap-3 rounded-lg bg-mono-200 p-4 shadow-sm sm:flex-row sm:items-end">
            <div class="flex-1">
                <label for="filter-trainer" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-ink-700">Trainer</label>
                <select id="filter-trainer" class="w-full rounded-md border border-ink-900/15 bg-mono-100 px-3 py-2.5 text-sm font-medium focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/30"></select>
            </div>
            <div class="flex-1">
                <label for="filter-category" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-ink-700">Category</label>
                <select id="filter-category" class="w-full rounded-md border border-ink-900/15 bg-mono-100 px-3 py-2.5 text-sm font-medium focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/30"></select>
            </div>
            <button id="reset-filters" type="button" class="rounded-md bg-ink-900 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-violet focus:outline-none focus:ring-2 focus:ring-violet focus:ring-offset-2">Reset filters</button>
        </section>

        <!-- LEGEND -->
        <ul id="legend" class="mb-6 flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium text-ink-700" aria-label="Category legend"></ul>

        <!-- DESKTOP GRID -->
        <section id="schedule-grid" class="hidden overflow-x-auto rounded-lg bg-mono-200 p-3 shadow-sm md:block" aria-label="Weekly schedule"></section>

        <!-- MOBILE LIST -->
        <section id="schedule-list" class="space-y-8 md:hidden" aria-label="Weekly schedule by day"></section>

        <p id="empty-state" class="hidden rounded-lg bg-mono-200 p-10 text-center text-sm font-medium text-ink-700">No classes match your filters.</p>
    </main>

    <!-- BOOKING MODAL -->
    <div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div id="modal-backdrop" class="absolute inset-0 bg-ink-900/60 backdrop-blur-sm"></div>
        <div class="relative w-full max-w-md overflow-hidden rounded-lg bg-mono-200 shadow-2xl">
            <div id="modal-accent" class="h-2 w-full bg-neon"></div>
            <button id="modal-close" type="button" aria-label="Close" class="absolute right-3 top-5 rounded-md p-2 text-ink-700 transition-colors hover:bg-mono-100 focus:outline-none focus:ring-2 focus:ring-violet">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
            <div class="p-6 sm:p-8">
                <p id="modal-category-chip" class="mb-3 inline-block rounded-md px-2.5 py-1 text-xs font-bold uppercase tracking-widest"></p>
                <h2 id="modal-title" class="text-4xl font-black uppercase tracking-tighter"></h2>
                <dl class="mt-6 grid grid-cols-2 gap-3 text-sm">
                    <div class="rounded-md bg-mono-100 p-3">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-700/70">Day</dt>
                        <dd id="modal-day" class="mt-0.5 font-bold"></dd>
                    </div>
                    <div class="rounded-md bg-mono-100 p-3">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-700/70">Time</dt>
                        <dd id="modal-time" class="mt-0.5 font-bold"></dd>
                    </div>
                    <div class="rounded-md bg-mono-100 p-3">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-700/70">Trainer</dt>
                        <dd id="modal-trainer" class="mt-0.5 font-bold"></dd>
                    </div>
                    <div class="rounded-md bg-mono-100 p-3">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-700/70">Intensity</dt>
                        <dd id="modal-difficulty" class="mt-0.5 flex items-center gap-0.5 font-bold"></dd>
                    </div>
                </dl>
                <div class="mt-5">
                    <div class="mb-1.5 flex justify-between text-xs font-semibold text-ink-700">
                        <span>Availability</span>
                        <span id="modal-spots"></span>
                    </div>
                    <div class="h-2 overflow-hidden rounded-full bg-mono-100">
                        <div id="modal-bar" class="h-full rounded-full transition-all duration-500"></div>
                    </div>
                </div>

                <button id="confirm-booking" type="button" class="mt-7 w-full rounded-md bg-neon py-4 text-lg font-black uppercase tracking-wider text-ink-900 shadow-lg shadow-neon/30 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-ink-900 focus:ring-offset-2 active:translate-y-0 hidden">Confirm Booking</button>
                <button id="cancel-booking" type="button" class="mt-3 hidden w-full rounded-md border border-red-500 py-3 text-sm font-bold uppercase tracking-wider text-red-700 transition-colors hover:bg-red-100">Cancel Booking</button>
                <p id="modal-login-hint" class="mt-5 hidden rounded-md bg-ink-900/5 px-3 py-3 text-center text-sm text-ink-700">
                    <a href="/Account/Login?ReturnUrl=%2FSchedule" class="font-bold underline hover:text-violet">Sign in</a> as a Client to book this class.
                </p>
                <p id="modal-success" class="mt-4 hidden rounded-md bg-deep/15 px-3 py-2 text-center text-sm font-semibold text-ink-900" role="status"></p>
            </div>
        </div>
    </div>

    <div id="slot-toast" class="slot-toast" role="status" aria-live="polite"></div>

    @Html.AntiForgeryToken()

    <script>
        (function () {
            'use strict';

            var DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

            // FIX 1: Store today string directly to avoid Razor parse errors
            var TODAY_STR = '@today.ToString("yyyy-MM-dd")';
            var WEEK_DATES = @Html.Raw(JsonSerializer.Serialize(weekDates.Select(d => d.ToString("yyyy-MM-dd")).ToArray()));

            var HOURS = [];
            for (var h = 8; h <= 20; h++) { HOURS.push(h); }

            var CATEGORIES = {
                HIIT:     { bg: '#FBEFE6', fg: '#8A4B1E' },
                Pilates:  { bg: '#F6EAF2', fg: '#7A3A64' },
                Yoga:     { bg: '#E8F3EC', fg: '#2F6B45' },
                Strength: { bg: '#E9EEF8', fg: '#33508A' },
                Cycling:  { bg: '#FAF4DC', fg: '#7A6410' },
                Boxing:   { bg: '#F7E7E7', fg: '#8A3333' }
            };

            var SLOTS = @Html.Raw(JsonSerializer.Serialize(scheduleData));

            var isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            var isClient        = @(isClient ? "true" : "false");
            var isTrainer       = @(isTrainer ? "true" : "false");
            var isAdmin         = @(isAdmin ? "true" : "false");
            var canBook         = isClient;

            var TRAINERS = Array.from(new Set(SLOTS.map(function (s) { return s.trainer; })));

            var $ = function (id) { return document.getElementById(id); };

            var els = {
                trainer:  $('filter-trainer'),
                category: $('filter-category'),
                reset:    $('reset-filters'),
                grid:     $('schedule-grid'),
                list:     $('schedule-list'),
                empty:    $('empty-state'),
                legend:   $('legend'),
                modal:    $('modal'),
                backdrop: $('modal-backdrop'),
                close:    $('modal-close'),
                confirm:  $('confirm-booking'),
                cancel:   $('cancel-booking'),
                loginHint:$('modal-login-hint'),
                success:  $('modal-success'),
                toast:    $('slot-toast')
            };

            var activeSlot = null;
            var lastFocus  = null;

            function pad(n) { return (n < 10 ? '0' : '') + n; }
            function hourLabel(hour) { return pad(hour) + ':00'; }
            function timeLabel(slot) { return slot.timeStart + ' – ' + slot.timeEnd; }
            function left(slot) { return Math.max(0, slot.capacity - slot.booked); }
            function isFull(slot) { return left(slot) <= 0; }
            function isPast(slot) { return new Date(slot.startDateTime) <= new Date(); }
            function isUnavailable(slot) {
                return slot.status === 'Cancelled' || slot.status === 'Completed' || isPast(slot);
            }
            function ratio(slot) { return slot.capacity > 0 ? slot.booked / slot.capacity : 0; }

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, function (c) {
                    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
                });
            }

            function barColor(slot) {
                var r = ratio(slot);
                if (r >= 1)    return '#E57373';
                if (r >= 0.85) return '#EF9A9A';
                if (r >= 0.6)  return '#F2C94C';
                return '#7AB800';
            }

            function fireIcons(level, size) {
                var out = '';
                for (var i = 1; i <= 3; i++) {
                    out += '<svg class="' + size + '" viewBox="0 0 24 24" ' +
                        'fill="' + (i <= level ? 'currentColor' : 'none') + '" ' +
                        'stroke="currentColor" stroke-width="2" stroke-linejoin="round" ' +
                        'style="opacity:' + (i <= level ? 1 : 0.25) + '" aria-hidden="true">' +
                        '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>';
                }
                return '<span class="inline-flex" role="img" aria-label="Intensity ' + level + ' of 3">' + out + '</span>';
            }

            function showToast(message, type) {
                var t = els.toast;
                t.textContent = message;
                t.className = 'slot-toast ' + (type || 'success');
                t.classList.add('show');
                setTimeout(function () { t.classList.remove('show'); }, 3500);
            }

            function slotCard(s, showTime) {
                var c = CATEGORIES[s.category] || { bg: '#E2E8F0', fg: '#0F172A' };
                var full        = isFull(s);
                var alreadyBooked = s.isBooked;
                var past        = isPast(s);
                var unavailable = isUnavailable(s);

                var statusText = alreadyBooked
                    ? 'Already booked'
                    : s.status === 'Completed'
                        ? 'Completed'
                        : past
                            ? 'Session started'
                            : full
                                ? 'Fully booked'
                                : left(s) + '/' + s.capacity + ' spots left';

                var el = document.createElement('button');
                el.type = 'button';
                el.className =
                    'slot group relative flex w-full flex-col justify-between gap-2 overflow-hidden rounded-md p-2.5 text-left transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet ' +
                    (unavailable
                        ? 'is-past opacity-50 cursor-not-allowed'
                        : full && !alreadyBooked
                            ? 'is-full opacity-40 cursor-not-allowed'
                            : 'cursor-pointer hover:-translate-y-1 hover:shadow-lg');

                el.style.backgroundColor = c.bg;
                el.style.color = c.fg;
                el.setAttribute('aria-label', s.category + ' with ' + s.trainer + ', ' + DAYS[s.day] + ' ' + timeLabel(s) + ', ' + statusText);

                el.innerHTML =
                    '<div>' +
                        '<div class="flex items-start justify-between gap-1">' +
                            '<span class="text-sm font-extrabold uppercase leading-tight tracking-tight">' + escapeHtml(s.category) + '</span>' +
                            fireIcons(s.difficulty, 'h-3 w-3') +
                        '</div>' +
                        (showTime ? '<p class="mt-0.5 text-xs font-bold opacity-70">' + timeLabel(s) + '</p>' : '') +
                        '<p class="mt-0.5 text-xs font-medium opacity-75">' + escapeHtml(s.trainer) + '</p>' +
                    '</div>' +
                    '<div>' +
                        '<p class="capacity-label mb-1 text-[11px] font-bold">' + statusText + '</p>' +
                        '<div class="h-1.5 w-full overflow-hidden rounded-full bg-black/10">' +
                            '<div class="h-full rounded-full transition-all duration-500" style="width:' + Math.min(100, ratio(s) * 100) + '%;background:' + barColor(s) + '"></div>' +
                        '</div>' +
                    '</div>';

                el.addEventListener('click', function () { openModal(s, el); });
                return el;
            }

            function filtered() {
                var trainer  = els.trainer.value;
                var category = els.category.value;
                return SLOTS.filter(function (s) {
                    return (!trainer || s.trainer === trainer) && (!category || s.category === category);
                });
            }

            function render() {
                var slots = filtered();
                els.empty.classList.toggle('hidden', slots.length > 0);

                var grid = document.createElement('div');
                grid.className = 'grid min-w-[880px] gap-1.5';
                grid.style.gridTemplateColumns = '64px repeat(7, minmax(0, 1fr))';

                grid.appendChild(document.createElement('div'));

                // Render Day Headers with Dates
                DAYS.forEach(function (day, i) {
                    var date = new Date(WEEK_DATES[i] + 'T00:00:00');
                    var dateStr = pad(date.getDate()) + '.' + pad(date.getMonth() + 1);
                    var isToday = WEEK_DATES[i] === TODAY_STR; // FIX 2

                    var head = document.createElement('div');
                    head.className = 'rounded-md px-2 py-2 text-center text-xs font-extrabold uppercase tracking-widest ' + (isToday ? 'bg-neon text-ink-900' : 'bg-ink-900 text-white');
                    head.innerHTML = '<div>' + day.slice(0, 3) + '</div><div class="mt-0.5 text-[10px] font-semibold opacity-70">' + dateStr + '</div>';
                    grid.appendChild(head);
                });

                HOURS.forEach(function (hour) {
                    var label = document.createElement('div');
                    label.className = 'pt-2 pr-2 text-right text-xs font-bold text-ink-700/70';
                    label.textContent = hourLabel(hour);
                    grid.appendChild(label);

                    DAYS.forEach(function (_, dayIndex) {
                        var cell = document.createElement('div');
                        cell.className = 'min-h-[92px] rounded-md bg-mono-100/70 p-1';

                        var matching = slots.filter(function (s) { return s.day === dayIndex && s.hour === hour; }).sort(function (a, b) { return a.timeStart.localeCompare(b.timeStart); });

                        if (matching.length > 0) {
                            cell.className = 'min-h-[92px] flex flex-col gap-1 rounded-md bg-mono-100/70 p-1';
                            matching.forEach(function (slot) {
                                var card = slotCard(slot, false);
                                card.classList.add('flex-1');
                                cell.appendChild(card);
                            });
                        }
                        grid.appendChild(cell);
                    });
                });

                els.grid.innerHTML = '';
                els.grid.appendChild(grid);

                els.list.innerHTML = '';
                DAYS.forEach(function (day, dayIndex) {
                    var daySlots = slots.filter(function (s) { return s.day === dayIndex; }).sort(function (a, b) { return a.timeStart.localeCompare(b.timeStart); });
                    if (daySlots.length === 0) return;

                    var wrap    = document.createElement('div');
                    var date    = new Date(WEEK_DATES[dayIndex] + 'T00:00:00');
                    var dateStr = pad(date.getDate()) + '.' + pad(date.getMonth() + 1);

                    var heading = document.createElement('h2');
                    heading.className = 'mb-3 flex items-center gap-3 text-2xl font-black uppercase tracking-tighter';
                    heading.innerHTML = '<span class="h-2.5 w-2.5 rounded-sm bg-neon ring-2 ring-ink-900"></span>' + day + ' <span class="text-sm font-semibold text-ink-700/60">' + dateStr + '</span>';

                    var stack = document.createElement('div');
                    stack.className = 'grid gap-2.5 sm:grid-cols-2';
                    daySlots.forEach(function (s) { stack.appendChild(slotCard(s, true)); });

                    wrap.appendChild(heading);
                    wrap.appendChild(stack);
                    els.list.appendChild(wrap);
                });
            }

            function initFilters() {
                els.trainer.innerHTML = '<option value="">All trainers</option>' + TRAINERS.map(function (t) { return '<option value="' + escapeHtml(t) + '">' + escapeHtml(t) + '</option>'; }).join('');
                var allCategories = [];
                SLOTS.forEach(function (s) { if (allCategories.indexOf(s.category) === -1) allCategories.push(s.category); });
                els.category.innerHTML = '<option value="">All categories</option>' + allCategories.map(function (c) { return '<option value="' + escapeHtml(c) + '">' + escapeHtml(c) + '</option>'; }).join('');

                els.legend.innerHTML = Object.keys(CATEGORIES).map(function (cat) {
                    return '<li class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style="background:' + CATEGORIES[cat].bg + ';box-shadow:inset 0 0 0 1.5px ' + CATEGORIES[cat].fg + '55"></span>' + cat + '</li>';
                }).join('') +
                '<li class="ml-auto hidden items-center gap-3 sm:inline-flex">' +
                    '<span class="inline-flex items-center gap-1"><i class="h-2 w-4 rounded-full" style="background:#7AB800"></i>Open</span>' +
                    '<span class="inline-flex items-center gap-1"><i class="h-2 w-4 rounded-full" style="background:#F2C94C"></i>Filling</span>' +
                    '<span class="inline-flex items-center gap-1"><i class="h-2 w-4 rounded-full" style="background:#E57373"></i>Almost full</span>' +
                '</li>';

                els.trainer.addEventListener('change', render);
                els.category.addEventListener('change', render);
                els.reset.addEventListener('click', function () {
                    els.trainer.value = '';
                    els.category.value = '';
                    render();
                });
            }

            function openModal(s, trigger) {
                activeSlot = s;
                lastFocus  = trigger;

                var c = CATEGORIES[s.category] || { bg: '#E2E8F0', fg: '#0F172A' };

                $('modal-title').textContent = s.category;

                var chip = $('modal-category-chip');
                chip.textContent = 'Group class';
                chip.style.background = c.bg;
                chip.style.color = c.fg;

                $('modal-day').textContent     = DAYS[s.day];
                $('modal-time').textContent    = timeLabel(s);
                $('modal-trainer').textContent = s.trainer;
                $('modal-difficulty').innerHTML = fireIcons(s.difficulty, 'h-4 w-4');
                $('modal-spots').textContent   = s.booked + '/' + s.capacity + ' spots booked';

                var bar = $('modal-bar');
                bar.style.width = '0%';
                bar.style.background = barColor(s);
                requestAnimationFrame(function () { bar.style.width = Math.min(100, ratio(s) * 100) + '%'; });

                els.success.classList.add('hidden');
                els.success.textContent = '';

                var unavailable = isUnavailable(s);
                var full = isFull(s);

                var showConfirm = canBook && !s.isBooked && !unavailable && !full;
                var showCancel  = canBook && s.isBooked && !unavailable;
                var showLogin   = !isAuthenticated && !unavailable;

                els.confirm.classList.toggle('hidden', !showConfirm);
                els.cancel.classList.toggle('hidden', !showCancel);
                els.loginHint.classList.toggle('hidden', !showLogin);

                els.confirm.disabled = false;
                els.confirm.textContent = 'Confirm Booking';
                els.cancel.disabled = false;
                els.cancel.textContent = 'Cancel Booking';

                if ((isTrainer || isAdmin) && !isClient) {
                    els.confirm.classList.add('hidden');
                    els.cancel.classList.add('hidden');
                }

                els.modal.classList.remove('hidden');
                els.modal.classList.add('flex');
                document.body.classList.add('modal-open');

                if (!els.confirm.classList.contains('hidden')) els.confirm.focus();
                else if (!els.cancel.classList.contains('hidden')) els.cancel.focus();
                else els.close.focus();
            }

            function closeModal() {
                els.modal.classList.add('hidden');
                els.modal.classList.remove('flex');
                document.body.classList.remove('modal-open');
                if (lastFocus) lastFocus.focus();
                activeSlot = null;
            }

            function getToken() {
                var inp = document.querySelector('input[name="__RequestVerificationToken"]');
                return inp ? inp.value : '';
            }

            els.confirm.addEventListener('click', async function () {
                if (!activeSlot) return;

                els.confirm.disabled = true;
                els.confirm.textContent = 'Booking...';

                var body = new URLSearchParams();
                body.append('id', activeSlot.id);
                body.append('__RequestVerificationToken', getToken());

                try {
                    var response = await fetch('/Schedule/BookJson', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    });

                    var result = await response.json();

                    if (!response.ok || !result.success) {
                        els.success.textContent = result.message || 'Booking failed.';
                        els.success.classList.remove('hidden');
                        els.success.style.color = '#991B1B';
                        els.confirm.disabled = false;
                        els.confirm.textContent = 'Confirm Booking';
                        return;
                    }

                    var slot = SLOTS.find(function (s) { return s.id === activeSlot.id; });
                    if (slot) {
                        slot.booked   = result.booked;
                        slot.status   = result.status;
                        slot.isBooked = true;
                    }

                    closeModal();
                    render();
                    showToast('Workout booked successfully!', 'success');

                } catch (err) {
                    els.confirm.disabled = false;
                    els.confirm.textContent = 'Try again';
                    els.success.textContent = 'Could not book this session. Please try again.';
                    els.success.classList.remove('hidden');
                }
            });

            els.cancel.addEventListener('click', async function () {
                if (!activeSlot) return;

                els.cancel.disabled = true;
                els.cancel.textContent = 'Cancelling...';

                var body = new URLSearchParams();
                body.append('id', activeSlot.id);
                body.append('__RequestVerificationToken', getToken());

                try {
                    var response = await fetch('/Schedule/CancelBookingJson', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    });

                    var result = await response.json();

                    if (!response.ok || !result.success) {
                        els.success.textContent = result.message || 'Could not cancel booking.';
                        els.success.classList.remove('hidden');
                        els.success.style.color = '#991B1B';
                        els.cancel.disabled = false;
                        els.cancel.textContent = 'Cancel Booking';
                        return;
                    }

                    var slot = SLOTS.find(function (s) { return s.id === activeSlot.id; });
                    if (slot) {
                        slot.booked   = result.booked;
                        slot.status   = result.status;
                        slot.isBooked = false;
                    }

                    closeModal();
                    render();
                    showToast('Your booking has been cancelled.', 'success');

                } catch (err) {
                    els.cancel.disabled = false;
                    els.cancel.textContent = 'Cancel Booking';
                    els.success.textContent = 'Could not cancel your booking. Please try again.';
                    els.success.classList.remove('hidden');
                }
            });

            els.close.addEventListener('click', closeModal);
            els.backdrop.addEventListener('click', closeModal);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !els.modal.classList.contains('hidden')) { closeModal(); }
            });

            if (window.matchMedia('(hover: none)').matches) { document.body.classList.add('touch'); }

            initFilters();
            render();
        })();
    </script>
</body>