@model SportLab.Models.Order

@{
    ViewData["Title"] = "Order Confirmed - SportLab";
    var customerName = ViewBag.CustomerName as string ?? "SportLab Customer";
    var deliveryMethod = ViewBag.DeliveryMethod as string ?? "Pickup at SportLab Front Desk";
    var deliveryAddress = ViewBag.DeliveryAddress as string ?? "SportLab Gym Central Reception";
    var paymentMethod = ViewBag.PaymentMethod as string ?? "Card";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                <!-- Success Icon & Header -->
                <div class="display-3 text-success mb-3">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Thank You for Your Order!</h1>
                <p class="lead text-muted mb-4">
                    Your order <strong>#@Model.Id</strong> has been successfully placed and confirmed.
                </p>

                <!-- Order Receipt Card -->
                <div class="card border rounded-4 text-start p-4 mb-4 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <div>
                            <span class="text-muted small d-block">Order Number:</span>
                            <h4 class="fw-bold mb-0">#@Model.Id</h4>
                        </div>
                        <div>
                            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                                <i class="bi bi-circle-fill me-1 small"></i> @Model.Status
                            </span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Customer:</span>
                            <strong>@customerName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Order Date:</span>
                            <strong>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Delivery:</span>
                            <span>@deliveryMethod</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Destination:</span>
                            <span>@deliveryAddress</span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-uppercase small text-muted mb-2 pt-2 border-top">Ordered Products:</h6>
                    <div class="order-items-list mb-3">
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between py-1 border-bottom text-muted small">
                                <span>@(detail.Product?.Name ?? "SportLab Product")</span>
                                <span class="fw-semibold text-dark">@(detail.Product?.Price.ToString("N0") ?? "0") ₴</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline pt-2">
                        <span class="fs-5 fw-bold">Total Amount:</span>
                        <span class="fs-3 fw-extrabold text-primary">@Model.TotalAmount.ToString("N0") ₴</span>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-bag me-1"></i> Continue Shopping
                    </a>
                    <a asp-controller="Profile" asp-action="Client" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="bi bi-person me-1"></i> My Profile & Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
