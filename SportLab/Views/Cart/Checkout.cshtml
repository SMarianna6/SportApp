@model SportLab.Controllers.CheckoutViewModel

@{
    ViewData["Title"] = "Order Checkout - SportLab";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

<div class="container my-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none">Cart</a></li>
            <li class="breadcrumb-item active" aria-current="page">Checkout</li>
        </ol>
    </nav>

    <h1 class="h3 fw-bold mb-4">Complete Your Order</h1>

    <div class="row g-5">
        <div class="col-lg-7">
            <form asp-action="Checkout" method="post" id="checkoutForm">
                @Html.AntiForgeryToken()

                <!-- 1. Contact Details -->
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle">1</span> Contact Details
                    </h5>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Alexander Smith" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+380 (97) 123-45-67" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="client@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Delivery Options -->
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle">2</span> Delivery Options
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <div class="form-check p-3 border rounded-3 mb-2 delivery-option-tile">
                                <input class="form-check-input ms-0 me-3" type="radio" name="DeliveryMethod" id="delivPickup" value="pickup" checked />
                                <label class="form-check-label w-100 cursor-pointer" for="delivPickup">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Self-Pickup at SportLab Front Desk</strong>
                                            <div class="text-muted small">123 Fitness Avenue, Khmelnytskyi (Ready today)</div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success">Free</span>
                                    </div>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded-3 mb-2 delivery-option-tile">
                                <input class="form-check-input ms-0 me-3" type="radio" name="DeliveryMethod" id="delivCourier" value="courier" />
                                <label class="form-check-label w-100 cursor-pointer" for="delivCourier">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Courier Doorstep Delivery</strong>
                                            <div class="text-muted small">Direct delivery to your home or office address</div>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary">Free</span>
                                    </div>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded-3 delivery-option-tile">
                                <input class="form-check-input ms-0 me-3" type="radio" name="DeliveryMethod" id="delivPost" value="post" />
                                <label class="form-check-label w-100 cursor-pointer" for="delivPost">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Nova Poshta / Parcel Locker</strong>
                                            <div class="text-muted small">Delivery to your nearest post branch or automated locker</div>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary">Free</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div id="addressSection" class="mt-3" style="display: none;">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label asp-for="City" class="form-label fw-semibold small">City / Town</label>
                                <input asp-for="City" class="form-control" placeholder="Khmelnytskyi" />
                            </div>
                            <div class="col-md-7">
                                <label asp-for="Address" class="form-label fw-semibold small">Street Address / Post Branch #</label>
                                <input asp-for="Address" class="form-control" placeholder="e.g. Branch #12 or 45 Soborna St, Apt 22" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Notes" class="form-label fw-semibold small">Delivery Notes (Optional)</label>
                                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Gate code, convenient delivery time, etc."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Payment Method -->
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle">3</span> Payment Method
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <div class="form-check p-3 border rounded-3 mb-2 delivery-option-tile">
                                <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="payCard" value="card" checked />
                                <label class="form-check-label w-100 cursor-pointer" for="payCard">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong><i class="bi bi-credit-card-2-front text-primary me-2"></i>Credit / Debit Card</strong>
                                            <div class="text-muted small">Pay securely with your bank card</div>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary">Online Payment</span>
                                    </div>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded-3 delivery-option-tile">
                                <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="payCash" value="cash" />
                                <label class="form-check-label w-100 cursor-pointer" for="payCash">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong><i class="bi bi-cash-stack text-success me-2"></i>Cash on Delivery / Pickup</strong>
                                            <div class="text-muted small">Pay when you receive your order</div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success">Pay Later</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Card Details Box (Toggles automatically) -->
                    <div id="cardDetailsSection" class="mt-3 p-3 border rounded-3 bg-light">
                        <h6 class="fw-bold small mb-2"><i class="bi bi-credit-card me-1"></i> Card Details (Simulation)</h6>
                        <div class="row g-2">
                            <div class="col-12">
                                <input type="text" id="cardNumberInput" class="form-control form-control-sm" placeholder="4141 4141 4141 4141" maxlength="19" required />
                            </div>
                            <div class="col-6">
                                <input type="text" id="cardExpiryInput" class="form-control form-control-sm" placeholder="MM/YY" maxlength="5" required />
                            </div>
                            <div class="col-6">
                                <input type="password" id="cardCvvInput" class="form-control form-control-sm" placeholder="CVV" maxlength="3" required />
                            </div>
                        </div>
                    </div>

                    <!-- Terms Checkbox -->
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="termsCheck" />
                        <label class="form-check-label text-muted small" for="termsCheck">
                            I confirm that the entered order information is correct and agree to SportLab store terms.
                        </label>
                    </div>

                    <div id="termsError" class="text-danger small mt-1" style="display: none;">
                        You must agree to the terms before placing an order.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold w-100 shadow-sm" id="btnPlaceOrder">
                    <i class="bi bi-check2-circle me-1"></i> Place Order Now
                </button>
            </form>
        </div>

        <!-- Right Column: Order Summary Sidebar -->
        <div class="col-lg-5">
            <div class="bg-white p-4 rounded-4 border shadow-sm sticky-top" style="top: 2rem;">
                <h5 class="fw-bold mb-3">Items in Order (@Model.CartItems.Sum(i => i.Quantity))</h5>

                <div class="order-items-list mb-3" style="max-height: 320px; overflow-y: auto;">
                    @foreach (var item in Model.CartItems)
                    {
                        var photo = string.IsNullOrWhiteSpace(item.PhotoUrl)
                        ? "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=100&h=100&fit=crop"
                        : item.PhotoUrl;

                        <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                            <img src="@photo" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                            <div class="flex-grow-1">
                                <h6 class="mb-0 fw-bold small">@item.ProductName</h6>
                                <span class="text-muted small">Qty: @item.Quantity × @item.UnitPrice.ToString("N0") ₴</span>
                            </div>
                            <span class="fw-bold">@item.Subtotal.ToString("N0") ₴</span>
                        </div>
                    }
                </div>

                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold">@Model.Subtotal.ToString("N0") ₴</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Shipping & Handling:</span>
                        <span class="text-success fw-semibold">Free</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fs-5 fw-bold">Total:</span>
                        <span class="fs-3 fw-extrabold text-primary">@Model.Total.ToString("N0") ₴</span>
                    </div>
                </div>

                <div class="p-3 bg-primary-subtle text-primary rounded-3 small">
                    <i class="bi bi-shield-check fs-5 me-1 align-middle"></i>
                    <strong>SportLab Guarantee:</strong> Track your order in real-time or pick it up at the gym front desk today.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // 1. Payment Method & Card Details Toggle
            const radioPayCard = document.getElementById("payCard");
            const radioPayCash = document.getElementById("payCash");
            const cardDetailsSection = document.getElementById("cardDetailsSection");

            const cardNumberInput = document.getElementById("cardNumberInput");
            const cardExpiryInput = document.getElementById("cardExpiryInput");
            const cardCvvInput = document.getElementById("cardCvvInput");

            function togglePayment() {
                if (radioPayCard && radioPayCard.checked) {
                    cardDetailsSection.style.display = "block";
                    if (cardNumberInput) cardNumberInput.required = true;
                    if (cardExpiryInput) cardExpiryInput.required = true;
                    if (cardCvvInput) cardCvvInput.required = true;
                } else {
                    cardDetailsSection.style.display = "none";
                    if (cardNumberInput) cardNumberInput.required = false;
                    if (cardExpiryInput) cardExpiryInput.required = false;
                    if (cardCvvInput) cardCvvInput.required = false;
                }
            }

            if (radioPayCard && radioPayCash) {
                radioPayCard.addEventListener("change", togglePayment);
                radioPayCash.addEventListener("change", togglePayment);
                togglePayment();
            }

            // 2. Delivery Address Toggle
            const radioPickup = document.getElementById("delivPickup");
            const radioCourier = document.getElementById("delivCourier");
            const radioPost = document.getElementById("delivPost");
            const addressSection = document.getElementById("addressSection");
            const cityInput = document.getElementById("City");
            const addressInput = document.getElementById("Address");

            function toggleAddress() {
                if (radioPickup && radioPickup.checked) {
                    addressSection.style.display = "none";
                    if (cityInput) cityInput.required = false;
                    if (addressInput) addressInput.required = false;
                } else {
                    addressSection.style.display = "block";
                    if (cityInput) cityInput.required = true;
                    if (addressInput) addressInput.required = true;
                }
            }

            if (radioPickup && radioCourier && radioPost) {
                radioPickup.addEventListener("change", toggleAddress);
                radioCourier.addEventListener("change", toggleAddress);
                radioPost.addEventListener("change", toggleAddress);
                toggleAddress();
            }

            // 3. Terms & Conditions Validation
            const form = document.getElementById("checkoutForm");
            const termsCheck = document.getElementById("termsCheck");
            const termsError = document.getElementById("termsError");

            if (form && termsCheck) {
                form.addEventListener("submit", function (e) {
                    if (!termsCheck.checked) {
                        e.preventDefault();
                        if (termsError) termsError.style.display = "block";
                        termsCheck.focus();
                    } else {
                        if (termsError) termsError.style.display = "none";
                    }
                });

                termsCheck.addEventListener("change", function () {
                    if (termsCheck.checked && termsError) {
                        termsError.style.display = "none";
                    }
                });
            }
        });
    </script>
}
