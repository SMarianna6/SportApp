@model List<SportLab.Models.WorkoutSlot>
@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var today = DateTime.Today;
    var todaySlots = Model.Where(s => s.StartTime.Date == today).ToList();
    var upcomingSlots = Model.Where(s => s.StartTime.Date > today).ToList();
    var trainerName = ViewBag.TrainerName as string ?? "Trainer";
}

@section Styles {
<style>
    .slot-card { transition: transform .2s ease, box-shadow .2s ease; }
    .slot-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(170,255,0,.12); }
</style>
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-6xl">

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Trainer Panel</p>
                <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">@trainerName</h1>
                <p class="mt-1 text-sm text-white/50">@ViewBag.TrainerEmail</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a asp-action="MyClients" class="rounded-md border border-white/20 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">
                    My Clients
                </a>
                <a asp-action="CreateSlot" class="rounded-md bg-neon px-4 py-2.5 text-xs font-extrabold uppercase tracking-widest text-black transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neon/30">
                    + New Slot
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-neon/30 bg-neon/10 px-4 py-3 text-sm font-semibold text-neon">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm font-semibold text-red-400">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="mb-10">
            <div class="mb-4 flex items-center gap-3">
                <span class="rounded-md bg-neon px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-widest text-black">Today</span>
                <span class="text-sm text-white/40">@today.ToString("dddd, MMMM d")</span>
            </div>

            @if (!todaySlots.Any())
            {
                <div class="rounded-lg border border-dashed border-white/10 p-8 text-center text-sm text-white/30">
                    No sessions scheduled for today.
                </div>
            }
            else
            {
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var slot in todaySlots)
                    {
                        <div class="slot-card rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <p class="text-lg font-black uppercase tracking-tight">@(slot.ActivityName ?? "Unnamed")</p>
                                    <p class="mt-1 text-xs text-white/50">@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</p>
                                </div>
                                <span class="rounded-md px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest
                                    @(slot.Status == "Available" ? "bg-neon/20 text-neon" :
                                      slot.Status == "Booked" ? "bg-violet/20 text-violet" :
                                      slot.Status == "Completed" ? "bg-green-500/20 text-green-400" :
                                      "bg-red-500/20 text-red-400")">
                                    @slot.Status
                                </span>
                            </div>

                            @if (slot.User != null)
                            {
                                <div class="mt-3 flex items-center gap-2 rounded-md bg-white/5 px-3 py-2">
                                    <svg class="h-4 w-4 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                                    <span class="text-xs font-semibold text-white/70">@slot.User.Name</span>
                                </div>
                            }

                            @if (slot.Status == "Available" || slot.Status == "Booked")
                            {
                                <div class="mt-4 flex gap-2">
                                    @if (slot.Status == "Booked")
                                    {
                                        <form asp-action="CompleteSlot" method="post" class="flex-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@slot.Id" />
                                            <button type="submit" class="w-full rounded-md bg-green-500/20 py-2 text-xs font-bold uppercase tracking-widest text-green-400 transition-colors hover:bg-green-500/30">Complete</button>
                                        </form>
                                    }
                                    <form asp-action="CancelSlot" method="post" class="flex-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <button type="submit" class="w-full rounded-md bg-red-500/10 py-2 text-xs font-bold uppercase tracking-widest text-red-400 transition-colors hover:bg-red-500/20">Cancel</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <div class="mb-4 flex items-center gap-3">
                <span class="rounded-md bg-white/10 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-widest text-white/60">Upcoming</span>
                <span class="text-sm text-white/40">Next sessions</span>
            </div>

            @if (!upcomingSlots.Any())
            {
                <div class="rounded-lg border border-dashed border-white/10 p-8 text-center text-sm text-white/30">
                    No upcoming sessions. <a asp-action="CreateSlot" class="text-neon hover:underline">Create one?</a>
                </div>
            }
            else
            {
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var slot in upcomingSlots)
                    {
                        <div class="slot-card rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <p class="text-sm text-white/40">@slot.StartTime.ToString("MMM d")</p>
                                    <p class="text-lg font-black uppercase tracking-tight">@(slot.ActivityName ?? "Unnamed")</p>
                                    <p class="mt-1 text-xs text-white/50">@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</p>
                                </div>
                                <span class="rounded-md px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest
                                    @(slot.Status == "Available" ? "bg-neon/20 text-neon" :
                                      slot.Status == "Booked" ? "bg-violet/20 text-violet" :
                                      slot.Status == "Completed" ? "bg-green-500/20 text-green-400" :
                                      "bg-red-500/20 text-red-400")">
                                    @slot.Status
                                </span>
                            </div>

                            @if (slot.User != null)
                            {
                                <div class="mt-3 flex items-center gap-2 rounded-md bg-white/5 px-3 py-2">
                                    <svg class="h-4 w-4 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                                    <span class="text-xs font-semibold text-white/70">@slot.User.Name</span>
                                </div>
                            }

                            @if (slot.Status != "Completed" && slot.Status != "Cancelled")
                            {
                                <div class="mt-4 flex gap-2">
                                    <form asp-action="CancelSlot" method="post" class="flex-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <button type="submit" class="w-full rounded-md bg-red-500/10 py-2 text-xs font-bold uppercase tracking-widest text-red-400 transition-colors hover:bg-red-500/20">Cancel</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
