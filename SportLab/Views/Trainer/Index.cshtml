@model IEnumerable<SportLab.Models.User>
@{
    ViewData["Title"] = "Our Trainers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Meet Our Trainers</h2>
            <p class="text-muted mb-0">Certified fitness coaches ready to guide you toward your personal goals.</p>
        </div>
        <div>
            <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-primary">
                View Schedule
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-dark filter-btn active" onclick="filterTrainers('all', this)">All Specialties</button>
        <button class="btn btn-sm btn-outline-dark filter-btn" onclick="filterTrainers('strength', this)">Strength & Bodybuilding</button>
        <button class="btn btn-sm btn-outline-dark filter-btn" onclick="filterTrainers('functional', this)">CrossFit & Functional</button>
        <button class="btn btn-sm btn-outline-dark filter-btn" onclick="filterTrainers('yoga', this)">Yoga & Mobility</button>
        <button class="btn btn-sm btn-outline-dark filter-btn" onclick="filterTrainers('combat', this)">Combat & Boxing</button>
    </div>

    <div class="row g-4" id="trainersList">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <h5>No trainers available at the moment.</h5>
            </div>
        }
        else
        {
            @foreach (var trainer in Model)
            {
                var profile = trainer.TrainerProfile;
                
                var specs = !string.IsNullOrWhiteSpace(profile?.Specializations) 
                    ? profile.Specializations.Split(',').Select(s => s.Trim()).ToList() 
                    : new List<string> { "Coach" };
                    
                var firstSpec = specs.First();
                var allSpecs = string.Join(", ", specs);

                var dataSpecialty = "functional"; // Default
                if (specs.Any(s => s.Contains("Strength", StringComparison.OrdinalIgnoreCase))) dataSpecialty = "strength";
                if (specs.Any(s => s.Contains("Yoga", StringComparison.OrdinalIgnoreCase) || s.Contains("Mobility", StringComparison.OrdinalIgnoreCase))) dataSpecialty = "yoga";
                if (specs.Any(s => s.Contains("Boxing", StringComparison.OrdinalIgnoreCase) || s.Contains("Combat", StringComparison.OrdinalIgnoreCase))) dataSpecialty = "combat";

                var badgeColor = dataSpecialty == "strength" ? "bg-dark" :
                                 dataSpecialty == "yoga" ? "bg-success" :
                                 dataSpecialty == "combat" ? "bg-danger" :
                                 "bg-primary";

                var photoUrl = !string.IsNullOrWhiteSpace(profile?.PhotoUrl) 
                    ? profile.PhotoUrl 
                    : (trainer.AvatarUrl ?? "https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=600&auto=format&fit=crop&q=80");

                <div class="col-md-4 trainer-item" data-specialty="@dataSpecialty">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@photoUrl" 
                             class="card-img-top object-fit-cover" 
                             alt="@trainer.Name" 
                             style="height: 280px;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title fw-bold mb-0">@trainer.Name</h5>
                                <span class="badge @badgeColor">@firstSpec</span>
                            </div>
                            <h6 class="card-subtitle text-muted mb-3 small">@allSpecs</h6>
                            <p class="card-text text-muted small line-clamp-3">
                                @(profile?.About ?? "Dedicated fitness professional ready to help you achieve your goals.")
                            </p>
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark btn-sm flex-fill">Schedule</a>
                                
                                <form asp-controller="Trainer" asp-action="BookTrainer" method="post" class="flex-fill m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="trainerId" value="@trainer.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm w-100">Book Session</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterTrainers(specialty, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('active', 'btn-dark');
                b.classList.add('btn-outline-dark');
            });
            btn.classList.add('active', 'btn-dark');
            btn.classList.remove('btn-outline-dark');

            const items = document.querySelectorAll('.trainer-item');
            items.forEach(item => {
                if (specialty === 'all' || item.getAttribute('data-specialty') === specialty) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
}