@{
    ViewData["Title"] = "Our Trainers";
}

<div class="container mt-4">
    <h2 class="mb-4">Meet Our Trainers</h2>
    <p class="text-muted mb-5">Choose a specialist who perfectly matches your fitness goals and start your journey today.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?w=500&auto=format&fit=crop&q=80" class="card-img-top" alt="Iryna Boyko" style="height: 300px; object-fit: cover; object-position: top;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Iryna Boyko</h5>
                    <h6 class="card-subtitle mb-3 text-primary">Powerlifting & Bodybuilding</h6>
                    <p class="card-text text-muted">A true powerhouse. Iryna specializes in heavy lifting, muscle hypertrophy, and competitive powerlifting. She destroys stereotypes and builds real strength.</p>
                    <div class="mt-auto">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100">View Schedule</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?w=500&auto=format&fit=crop&q=80" class="card-img-top" alt="Maksym Kovalchuk" style="height: 300px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Maksym Kovalchuk</h5>
                    <h6 class="card-subtitle mb-3 text-primary">CrossFit & Weightlifting</h6>
                    <p class="card-text text-muted">Expert in high-intensity functional training and powerlifting. Ready to push your limits and build real strength.</p>
                    <div class="mt-auto">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100">View Schedule</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?w=500&auto=format&fit=crop&q=80" class="card-img-top" alt="Oksana Melnyk" style="height: 300px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Oksana Melnyk</h5>
                    <h6 class="card-subtitle mb-3 text-primary">Yoga & Stretching</h6>
                    <p class="card-text text-muted">Focuses on flexibility, mindfulness, and core stability. Helps you find balance between mind and body.</p>
                    <div class="mt-auto">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100">View Schedule</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1579758629938-03607ccdbaba?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="card-img-top" alt="Oleksandr Shevchenko" style="height: 300px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Oleksandr Shevchenko</h5>
                    <h6 class="card-subtitle mb-3 text-primary">Strength & Conditioning</h6>
                    <p class="card-text text-muted">Develops personalized strength routines. Perfect for muscle gain, toning, and athletic conditioning.</p>
                    <div class="mt-auto">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100">View Schedule</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1548690312-e3b507d8c110?w=500&auto=format&fit=crop&q=80" class="card-img-top" alt="Mariia Tkachenko" style="height: 300px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Mariia Tkachenko</h5>
                    <h6 class="card-subtitle mb-3 text-primary">Cardio & Group Classes</h6>
                    <p class="card-text text-muted">Energetic and motivating. Leads dynamic group sessions designed to burn calories and boost endurance.</p>
                    <div class="mt-auto">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-dark w-100">View Schedule</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>