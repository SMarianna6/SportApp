@model List<SportLab.Models.User>
@{
    ViewData["Title"] = "My Clients";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-4xl">

        <div class="mb-8">
            <a asp-action="Dashboard" class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-white/40 transition-colors hover:text-neon">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Back to Dashboard
            </a>
            <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Trainer Panel</p>
            <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">My Clients</h1>
            <p class="mt-1 text-sm text-white/50">Clients with active bookings</p>
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-lg border border-dashed border-white/10 p-12 text-center">
                <svg class="mx-auto mb-4 h-12 w-12 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                <p class="text-sm font-semibold text-white/40">No clients with active bookings yet.</p>
            </div>
        }
        else
        {
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var client in Model)
                {
                    <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-neon/20 text-neon">
                                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                            </div>
                            <div>
                                <p class="font-black uppercase tracking-tight">@(client.Name ?? "Unknown")</p>
                                <p class="text-xs text-white/50">@client.Email</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
