@model SportLab.Models.Tariff

@{
    ViewData["Title"] = "Підтвердження придбання абонемента";
    var startDate = (DateTime)(ViewBag.StartDate ?? DateTime.Today);
    var endDate = (DateTime)(ViewBag.EndDate ?? DateTime.Today.AddDays(Model.Duration > 0 ? Model.Duration : 30));
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/tariffs.css" asp-append-version="true" />

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Головна</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tariff" asp-action="Index" class="text-decoration-none">Тарифи</a></li>
            <li class="breadcrumb-item active" aria-current="page">Підтвердження придбання</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left Column: Checkout & Customer Form -->
        <div class="col-lg-7">
            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="tariff-icon-wrapper mb-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-1">Оформлення абонемента</h2>
                        <p class="text-muted small mb-0">Введіть дані для активації вашої клубної картки</p>
                    </div>
                </div>

                <form asp-action="ConfirmPurchase" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tariffId" value="@Model.Id" />

                    <h5 class="fw-bold mb-3 small text-uppercase text-muted">1. Контактні дані власника</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label for="customerName" class="form-label fw-semibold small">Прізвище, Ім'я та По батькові <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                                <input type="text" class="form-control" id="customerName" name="customerName" placeholder="Іваненко Петро Олексійович" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="customerPhone" class="form-label fw-semibold small">Номер телефону <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-telephone text-muted"></i></span>
                                <input type="tel" class="form-control" id="customerPhone" name="customerPhone" placeholder="+380 (97) 000-00-00" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="customerEmail" class="form-label fw-semibold small">Email (для електронного квитка) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" class="form-control" id="customerEmail" name="customerEmail" placeholder="petro@example.com" required />
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 small text-uppercase text-muted">2. Параметри активації</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="startDate" class="form-label fw-semibold small">Дата початку дії <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-calendar-check text-muted"></i></span>
                                <input type="date" class="form-control" id="startDate" name="startDate" value="@startDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <span class="form-text text-muted small">Ви можете обрати старт сьогодні або у зручний для вас день.</span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Термін дії</label>
                            <div class="p-2 px-3 bg-light rounded border text-muted small">
                                <strong class="text-dark">@Model.Duration днів</strong> (до <span id="summaryEndDate">@endDate.ToString("dd.MM.yyyy")</span>)
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 small text-uppercase text-muted">3. Спосіб оплати</h5>
                    <div class="payment-method-selector mb-4">
                        <div class="payment-method-card active" data-method="card">
                            <i class="bi bi-credit-card-2-front text-primary"></i>
                            <span>Банківська картка</span>
                        </div>
                        <div class="payment-method-card" data-method="applepay">
                            <i class="bi bi-apple text-dark"></i>
                            <span>Apple / Google Pay</span>
                        </div>
                        <div class="payment-method-card" data-method="desk">
                            <i class="bi bi-cash-stack text-success"></i>
                            <span>На рецепції</span>
                        </div>
                    </div>
                    <input type="hidden" name="paymentMethod" id="pagePaymentMethod" value="card" />

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="pageAgree" checked required />
                        <label class="form-check-label small text-muted" for="pageAgree">
                            Я ознайомлений(а) та погоджуюсь з <a href="#" class="text-primary text-decoration-none">правилами клубу SportLab</a> та обробкою персональних даних.
                        </label>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-3 align-items-center">
                        <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold w-100 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Підтвердити придбання та сплатити
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-pill w-100 w-sm-auto">
                            Повернутися
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Column: Order Summary & Tariff Details -->
        <div class="col-lg-5">
            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm sticky-top" style="top: 2rem;">
                <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase mb-2">@Model.Type</span>
                <h3 class="fw-bold mb-1">@Model.Name</h3>
                <div class="text-muted small mb-4">
                    <i class="bi bi-clock-history me-1 text-primary"></i> Термін: <strong>@Model.Duration днів</strong>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Вартість абонемента:</span>
                        <span class="fw-bold">@Model.Price.ToString("N0") ₴</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">ПДВ / Комісія:</span>
                        <span class="text-success fw-semibold">0 ₴ (включено)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ввідний інструктаж:</span>
                        <span class="badge bg-success-subtle text-success">Безкоштовно</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-bold fs-5">Разом до сплати:</span>
                        <span class="fw-bold fs-3 text-primary">@Model.Price.ToString("N0") ₴</span>
                    </div>
                </div>

                <h6 class="fw-bold text-uppercase small text-muted mb-3">Включені послуги та бонуси:</h6>
                <ul class="tariff-features-list mb-4">
                    @{
                        var services = (Model.Description ?? "")
                            .Split(new[] { "\r\n", "\r", "\n", ";" }, StringSplitOptions.RemoveEmptyEntries)
                            .Select(s => s.Trim())
                            .Where(s => !string.IsNullOrWhiteSpace(s));

                        if (!services.Any())
                        {
                            <li class="tariff-feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Безлімітне відвідування залу</span>
                            </li>
                            <li class="tariff-feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Доступ до душових та роздягалень</span>
                            </li>
                        }
                        else
                        {
                            foreach (var s in services)
                            {
                                <li class="tariff-feature-item">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>@s</span>
                                </li>
                            }
                        }
                    }
                </ul>

                <div class="d-flex align-items-center gap-3 p-3 bg-success-subtle rounded-3 text-success">
                    <i class="bi bi-shield-check fs-2"></i>
                    <div class="small">
                        <strong>Гарантія безпеки</strong><br>
                        Миттєва генерація цифрової картки в особистому кабінеті відразу після оформлення.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Payment methods selector
        const cards = document.querySelectorAll(".payment-method-card");
        const methodInput = document.getElementById("pagePaymentMethod");

        cards.forEach(card => {
            card.addEventListener("click", function () {
                cards.forEach(c => c.classList.remove("active"));
                this.classList.add("active");
                methodInput.value = this.getAttribute("data-method");
            });
        });

        // Date recalculation
        const startDateInput = document.getElementById("startDate");
        const summaryEndDate = document.getElementById("summaryEndDate");
        const duration = @Model.Duration;

        startDateInput.addEventListener("change", function () {
            if (!this.value) return;
            const start = new Date(this.value);
            const end = new Date(start);
            end.setDate(end.getDate() + duration);

            const day = String(end.getDate()).padStart(2, '0');
            const month = String(end.getMonth() + 1).padStart(2, '0');
            const year = end.getFullYear();

            summaryEndDate.textContent = `${day}.${month}.${year}`;
        });
    });
</script>
}
