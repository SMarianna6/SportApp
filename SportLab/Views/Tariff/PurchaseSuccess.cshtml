@model SportLab.Models.Subscription

@{
    ViewData["Title"] = "Абонемент успішно активовано!";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/tariffs.css" asp-append-version="true" />

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                <div class="display-3 text-success mb-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Абонемент успішно оформлено!</h1>
                <p class="lead text-muted mb-4">
                    Дякуємо за довіру до <strong>SportLab</strong>. Вашу клубну картку активовано в системі.
                </p>

                <!-- Digital Membership Pass -->
                <div class="digital-membership-pass text-start mx-auto mb-4" style="max-width: 520px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge bg-warning text-dark fw-bold text-uppercase px-2 py-1">Клубна Картка #@Model.Id</span>
                            <h3 class="fw-bold mb-0 mt-1 text-white">@(Model.Tariff?.Name ?? "Абонемент SportLab")</h3>
                        </div>
                        <div class="pass-chip"></div>
                    </div>

                    <div class="my-3">
                        <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-circle-fill me-1 small"></i> Статус: АКТИВНИЙ
                        </span>
                    </div>

                    <div class="row align-items-end mt-4">
                        <div class="col-8">
                            <span class="text-white-50 small d-block">Власник картки:</span>
                            <h5 class="fw-bold mb-2 text-white">@(Model.User?.Name ?? "Клієнт SportLab")</h5>
                            <span class="text-white-50 small d-block">Період дії:</span>
                            <span class="small fw-semibold text-white">
                                @Model.StartDate.ToString("dd.MM.yyyy") — @Model.EndDate.ToString("dd.MM.yyyy")
                            </span>
                        </div>
                        <div class="col-4 text-end">
                            <div class="pass-qr-box">
                                <i class="bi bi-qr-code text-dark fs-2"></i>
                            </div>
                            <span class="text-white-50 small d-block mt-1">SportPass ID</span>
                        </div>
                    </div>
                </div>

                <!-- Next steps checklist -->
                <div class="p-3 bg-light rounded-3 text-start mx-auto mb-4 border" style="max-width: 520px;">
                    <h6 class="fw-bold mb-2"><i class="bi bi-info-circle text-primary me-2"></i>Що робити далі:</h6>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-1">✓ Покажіть QR-код вашої картки адміністратору при першому візиті.</li>
                        <li class="mb-1">✓ Запишіться на безкоштовний ввідний інструктаж у розкладі занять.</li>
                        <li>✓ Слідкуйте за розкладом та бронюйте тренування онлайн.</li>
                    </ul>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Schedule" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i> Перейти до розкладу
                    </a>
                    <a asp-controller="Profile" asp-action="Client" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-person me-1"></i> Особистий кабінет
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        Каталог тарифів
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
