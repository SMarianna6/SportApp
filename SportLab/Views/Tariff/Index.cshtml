            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Category Filtering
        const filterPills = document.querySelectorAll(".filter-pill");
        const cards = document.querySelectorAll(".tariff-card-col");
        const emptyState = document.getElementById("filterEmptyState");

        filterPills.forEach(pill => {
            pill.addEventListener("click", function () {
                filterPills.forEach(p => p.classList.remove("active"));
                this.classList.add("active");

                const selectedFilter = this.getAttribute("data-filter").toLowerCase();
                let visibleCount = 0;

                cards.forEach(card => {
                    const rawCategories = card.getAttribute("data-categories") || "";
                    const categoriesList = rawCategories.toLowerCase().split(/\s+/);

                    if (selectedFilter === "all" || categoriesList.includes(selectedFilter)) {
                        card.style.display = "";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }
                });

                if (emptyState) {
                    if (visibleCount === 0) {
                        emptyState.classList.remove("d-none");
                    } else {
                        emptyState.classList.add("d-none");
                    }
                }
            });
        });

        // 2. Date Calculation Helper
        const startDateInput = document.getElementById("subscriptionStartDate");
        const calculatedEndDateSpan = document.getElementById("modalCalculatedEndDate");
        const durationInput = document.getElementById("formDurationDays");

        function updateEndDate() {
            if (!startDateInput.value) return;
            const start = new Date(startDateInput.value);
            const days = parseInt(durationInput.value) || 30;
            const end = new Date(start);
            end.setDate(end.getDate() + days);

            const day = String(end.getDate()).padStart(2, '0');
            const month = String(end.getMonth() + 1).padStart(2, '0');
            const year = end.getFullYear();

            calculatedEndDateSpan.textContent = `${day}.${month}.${year}`;
        }

        const todayStr = new Date().toISOString().split('T')[0];
        startDateInput.value = todayStr;
        startDateInput.min = todayStr;
        startDateInput.addEventListener("change", updateEndDate);

        // 3. Open Modal & Populate Data
        const purchaseModalElement = document.getElementById('quickPurchaseModal');
        const purchaseModal = new bootstrap.Modal(purchaseModalElement);
        const modalFormContainer = document.getElementById("modalFormContainer");
        const modalSuccessContainer = document.getElementById("modalSuccessContainer");
        const modalAlert = document.getElementById("modalAlert");

        document.querySelectorAll(".btn-open-modal").forEach(button => {
            button.addEventListener("click", function () {
                const id = this.getAttribute("data-tariff-id");
                const name = this.getAttribute("data-tariff-name");
                const price = this.getAttribute("data-tariff-price");
                const duration = this.getAttribute("data-tariff-duration");
                const type = this.getAttribute("data-tariff-type");

                document.getElementById("formTariffId").value = id;
                document.getElementById("formDurationDays").value = duration;
                document.getElementById("modalTariffName").textContent = name;
                document.getElementById("modalTariffPrice").textContent = price;
                document.getElementById("modalTariffDuration").textContent = duration;
                document.getElementById("modalTariffBadge").textContent = type || "Membership";

                modalFormContainer.classList.remove("d-none");
                modalSuccessContainer.classList.add("d-none");
                modalAlert.classList.add("d-none");

                updateEndDate();
                purchaseModal.show();
            });
        });

        // 4. Payment Method Card Selection
        const paymentCards = document.querySelectorAll(".payment-method-card");
        const selectedPaymentMethodInput = document.getElementById("selectedPaymentMethod");

        paymentCards.forEach(card => {
            card.addEventListener("click", function () {
                paymentCards.forEach(c => c.classList.remove("active"));
                this.classList.add("active");
                selectedPaymentMethodInput.value = this.getAttribute("data-method");
            });
        });

        // 5. AJAX Quick Purchase Form Submission
        const quickForm = document.getElementById("quickPurchaseForm");
        const submitBtn = document.getElementById("btnSubmitPurchase");
        const submitSpinner = document.getElementById("submitSpinner");

        quickForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            modalAlert.classList.add("d-none");
            submitBtn.disabled = true;
            submitSpinner.classList.remove("d-none");

            const payload = {
                tariffId: parseInt(document.getElementById("formTariffId").value),
                fullName: document.getElementById("customerFullName").value,
                phone: document.getElementById("customerPhone").value,
                email: document.getElementById("customerEmail").value,
                startDate: document.getElementById("subscriptionStartDate").value,
                paymentMethod: selectedPaymentMethodInput.value
            };

            try {
                const response = await fetch('/Tariff/QuickPurchase', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById("passTariffName").textContent = data.tariffName;
                    document.getElementById("passUserName").textContent = data.userName;
                    document.getElementById("passDates").textContent = `${data.startDate} — ${data.endDate}`;
                    document.getElementById("successMessageText").textContent = data.message;

                    modalFormContainer.classList.add("d-none");
                    modalSuccessContainer.classList.remove("d-none");
                } else {
                    modalAlert.textContent = data.message || "Failed to complete purchase.";
                    modalAlert.classList.remove("d-none");
                }
            } catch (err) {
                modalAlert.textContent = "Unable to connect to the server. Please try again.";
                modalAlert.classList.remove("d-none");
            } finally {
                submitBtn.disabled = false;
                submitSpinner.classList.add("d-none");
            }
        });
    });
</script>
}
