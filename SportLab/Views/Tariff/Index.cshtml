@model IEnumerable<SportLab.Models.Tariff>

@{
    ViewData["Title"] = "Тарифи та Абонементи";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/tariffs.css" asp-append-version="true" />

<div class="container my-4">
    <!-- Hero Header -->
    <div class="tariffs-hero text-center text-md-start">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge-hero mb-3">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Преміум фітнес-простір
                </span>
                <h1 class="display-5 fw-bold mb-3 text-white">Тарифи та Клубні Картки</h1>
                <p class="lead text-light mb-0" style="opacity: 0.9;">
                    Оберіть комфортний формат занять для досягнення ваших спортивних цілей. Сучасне обладнання, професійні тренери та бездоганний сервіс.
                </p>
            </div>
            <div class="col-lg-4 text-center text-md-end mt-4 mt-lg-0">
                <a asp-action="Create" class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Додати новий тариф
                </a>
            </div>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="tariffs-filter-container">
        <button type="button" class="filter-pill active" data-filter="all">
            <i class="bi bi-grid-fill me-1"></i> Всі абонементи
        </button>
        <button type="button" class="filter-pill" data-filter="популярний">
            <i class="bi bi-star-fill text-warning me-1"></i> Популярні
        </button>
        <button type="button" class="filter-pill" data-filter="базовий">
            <i class="bi bi-check2-circle me-1"></i> Базові
        </button>
        <button type="button" class="filter-pill" data-filter="преміум">
            <i class="bi bi-gem me-1"></i> Преміум / Річні
        </button>
        <button type="button" class="filter-pill" data-filter="студентський">
            <i class="bi bi-mortarboard-fill me-1"></i> Студентські
        </button>
    </div>

    <!-- Tariffs Cards Grid -->
    <div class="row g-4" id="tariffsGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-light rounded-4 border">
                    <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                    <h4 class="fw-bold">Наразі немає доданих тарифів</h4>
                    <p class="text-muted">Створіть перший тариф або перезавантажте сторінку для автозаповнення.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Створити тариф</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var typeLower = (item.Type ?? "").ToLower();
                var isFeatured = typeLower.Contains("популяр") || typeLower.Contains("хіт") || typeLower.Contains("про");
                var isVip = typeLower.Contains("преміум") || typeLower.Contains("vip") || item.Price >= 5000;
                var isStudent = typeLower.Contains("студент");

                string iconClass = "bi-fire";
                if (isVip) iconClass = "bi-gem";
                else if (isFeatured) iconClass = "bi-lightning-charge-fill";
                else if (isStudent) iconClass = "bi-mortarboard-fill";

                string cardModifier = isFeatured ? "featured" : (isVip ? "vip" : "");

                <div class="col-lg-4 col-md-6 tariff-card-col" data-category="@typeLower">
                    <div class="tariff-card @cardModifier">
                        @if (isFeatured)
                        {
                            <div class="ribbon-featured">Хіт продажу</div>
                        }

                        <!-- Card Header -->
                        <div class="tariff-card-header">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="tariff-icon-wrapper">
                                    <i class="bi @iconClass"></i>
                                </div>
                                <span class="tariff-badge-type">@item.Type</span>
                            </div>

                            <h3 class="tariff-title">@item.Name</h3>

                            <div class="tariff-price-block">
                                <span class="tariff-currency">₴</span>
                                <span class="tariff-amount">@item.Price.ToString("N0")</span>
                                <span class="tariff-period">/ @(item.Duration >= 365 ? "рік" : $"{item.Duration} дн.")</span>
                            </div>

                            <div class="tariff-duration-chip">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>Термін дії: <strong>@item.Duration днів</strong></span>
                            </div>
                        </div>

                        <!-- Card Body (Included Services) -->
                        <div class="tariff-card-body">
                            <div class="tariff-features-title">У вартість включено:</div>
                            <ul class="tariff-features-list">
                                @{
                                    var features = (item.Description ?? "")
                                        .Split(new[] { "\r\n", "\r", "\n", ";" }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(f => f.Trim())
                                        .Where(f => !string.IsNullOrWhiteSpace(f));

                                    if (!features.Any())
                                    {
                                        <li class="tariff-feature-item">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Повний доступ до кардіо та силової зони</span>
                                        </li>
                                        <li class="tariff-feature-item">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Комфортні роздягальні та душові</span>
                                        </li>
                                    }
                                    else
                                    {
                                        foreach (var feature in features)
                                        {
                                            <li class="tariff-feature-item">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>@feature</span>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>

                        <!-- Card Footer & Actions -->
                        <div class="tariff-card-footer">
                            <button type="button" 
                                    class="btn-buy-tariff btn-open-modal"
                                    data-tariff-id="@item.Id"
                                    data-tariff-name="@item.Name"
                                    data-tariff-price="@item.Price.ToString("N0")"
                                    data-tariff-duration="@item.Duration"
                                    data-tariff-type="@item.Type">
                                <i class="bi bi-bag-check-fill"></i> Швидке придбання
                            </button>

                            <a asp-action="ConfirmPurchase" asp-route-id="@item.Id" class="btn-detail-tariff">
                                <i class="bi bi-shield-check me-1"></i> Оформити з гарантією
                            </a>

                            <!-- Admin Controls -->
                            <div class="admin-tariff-actions">
                                <span class="text-muted small me-auto align-self-center"><i class="bi bi-gear"></i> Управління:</span>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Редагувати</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Ви впевнені, що бажаєте видалити цей тариф?')">Видалити</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Additional Trust Banner -->
    <div class="row mt-5 g-4">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-primary fs-1 mb-2"><i class="bi bi-shield-fill-check"></i></div>
                <h5 class="fw-bold">100% Безпечна оплата</h5>
                <p class="text-muted small mb-0">Миттєва активація абонемента після підтвердження замовлення.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-success fs-1 mb-2"><i class="bi bi-snow2"></i></div>
                <h5 class="fw-bold">Безкоштовна заморозка</h5>
                <p class="text-muted small mb-0">Можливість призупинити дію картки на час відпустки або хвороби.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-danger fs-1 mb-2"><i class="bi bi-person-check-fill"></i></div>
                <h5 class="fw-bold">Ввідний інструктаж</h5>
                <p class="text-muted small mb-0">Перше тренування з тренером та біоімпедансний аналіз тіла у подарунок.</p>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     Modal: Quick Purchase Confirmation (Модальне вікно придбання абонемента)
     ========================================================================== -->
<div class="modal fade" id="quickPurchaseModal" tabindex="-1" aria-labelledby="quickPurchaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header modal-tariff-header">
                <div>
                    <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase mb-1" id="modalTariffBadge">Абонемент</span>
                    <h4 class="modal-title fw-bold text-white mb-0" id="quickPurchaseModalLabel">Оформлення абонемента</h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body: Form State -->
            <div class="modal-body p-4" id="modalFormContainer">
                <!-- Tariff Summary Banner -->
                <div class="modal-tariff-summary">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <span class="text-muted small d-block">Обраний план:</span>
                            <h4 class="fw-bold text-dark mb-1" id="modalTariffName">-</h4>
                            <div class="text-muted small">
                                <i class="bi bi-clock-history text-primary me-1"></i> Термін: <strong id="modalTariffDuration">-</strong> днів
                                <span class="mx-2">•</span>
                                <i class="bi bi-calendar-check text-success me-1"></i> Діятиме до: <strong id="modalCalculatedEndDate">-</strong>
                            </div>
                        </div>
                        <div class="col-md-5 text-md-end mt-3 mt-md-0">
                            <span class="text-muted small d-block">До сплати:</span>
                            <div class="fs-2 fw-bold text-primary">
                                <span id="modalTariffPrice">-</span> <span class="fs-4">₴</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Purchase Form -->
                <form id="quickPurchaseForm">
                    <input type="hidden" id="formTariffId" name="tariffId" value="" />
                    <input type="hidden" id="formDurationDays" value="30" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="customerFullName" class="form-label fw-semibold small">Прізвище та Ім'я клієнта <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                                <input type="text" class="form-control" id="customerFullName" placeholder="Олександр Петренко" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="customerPhone" class="form-label fw-semibold small">Номер телефону <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-telephone text-muted"></i></span>
                                <input type="tel" class="form-control" id="customerPhone" placeholder="+380 (97) 123-45-67" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="customerEmail" class="form-label fw-semibold small">Email (для отримання картки) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" class="form-control" id="customerEmail" placeholder="client@example.com" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="subscriptionStartDate" class="form-label fw-semibold small">Дата початку дії <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-muted"></i></span>
                                <input type="date" class="form-control" id="subscriptionStartDate" required />
                            </div>
                        </div>

                        <!-- Payment Method Options -->
                        <div class="col-12 mt-3">
                            <label class="form-label fw-semibold small">Оберіть спосіб оплати</label>
                            <div class="payment-method-selector">
                                <div class="payment-method-card active" data-method="card">
                                    <i class="bi bi-credit-card-2-front text-primary"></i>
                                    <span>Банківська картка</span>
                                </div>
                                <div class="payment-method-card" data-method="applepay">
                                    <i class="bi bi-apple text-dark"></i>
                                    <span>Apple / Google Pay</span>
                                </div>
                                <div class="payment-method-card" data-method="desk">
                                    <i class="bi bi-cash-stack text-success"></i>
                                    <span>На рецепції</span>
                                </div>
                            </div>
                            <input type="hidden" id="selectedPaymentMethod" value="card" />
                        </div>

                        <!-- Terms Checkbox -->
                        <div class="col-12 mt-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" checked required />
                                <label class="form-check-label small text-muted" for="agreeTerms">
                                    Я погоджуюсь із правилами відвідування фітнес-клубу та публічною офертою SportLab
                                </label>
                            </div>
                        </div>
                    </div>

                    <div id="modalAlert" class="alert alert-danger d-none mt-3" role="alert"></div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Скасувати</button>
                        <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm" id="btnSubmitPurchase">
                            <span class="spinner-border spinner-border-sm d-none me-2" id="submitSpinner" role="status" aria-hidden="true"></span>
                            <span id="submitBtnText"><i class="bi bi-check2-circle me-1"></i> Підтвердити та активувати</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Modal Body: Success State -->
            <div class="modal-body p-4 d-none text-center" id="modalSuccessContainer">
                <div class="py-4">
                    <div class="display-3 text-success mb-3">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Вітаємо у команді SportLab!</h3>
                    <p class="text-muted mb-4" id="successMessageText">Ваш абонемент успішно активовано.</p>

                    <!-- Digital Pass Card Preview -->
                    <div class="digital-membership-pass text-start mx-auto mb-4" style="max-width: 460px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="badge bg-warning text-dark fw-bold text-uppercase px-2 py-1">Клубна Картка</span>
                                <h4 class="fw-bold mb-0 mt-1" id="passTariffName">Безліміт Про</h4>
                            </div>
                            <div class="pass-chip"></div>
                        </div>
                        <div class="row align-items-end mt-4">
                            <div class="col-8">
                                <span class="text-white-50 small d-block">Власник картки:</span>
                                <h5 class="fw-bold mb-2 text-white" id="passUserName">Олександр Петренко</h5>
                                <span class="text-white-50 small d-block">Період дії:</span>
                                <span class="small fw-semibold text-white" id="passDates">21.10.2026 — 20.11.2026</span>
                            </div>
                            <div class="col-4 text-end">
                                <div class="pass-qr-box">
                                    <i class="bi bi-qr-code text-dark fs-2"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Profile" asp-action="Client" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-person-circle me-1"></i> В особистий кабінет
                        </a>
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            Закрити
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ----------------------------------------------------
        // 1. Category Filtering
        // ----------------------------------------------------
        const filterPills = document.querySelectorAll(".filter-pill");
        const cards = document.querySelectorAll(".tariff-card-col");

        filterPills.forEach(pill => {
            pill.addEventListener("click", function () {
                filterPills.forEach(p => p.classList.remove("active"));
                this.classList.add("active");

                const filter = this.getAttribute("data-filter").toLowerCase();

                cards.forEach(card => {
                    const category = (card.getAttribute("data-category") || "").toLowerCase();
                    if (filter === "all" || category.includes(filter)) {
                        card.style.display = "";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });

        // ----------------------------------------------------
        // 2. Date Calculation Helper
        // ----------------------------------------------------
        const startDateInput = document.getElementById("subscriptionStartDate");
        const calculatedEndDateSpan = document.getElementById("modalCalculatedEndDate");
        const durationInput = document.getElementById("formDurationDays");

        function updateEndDate() {
            if (!startDateInput.value) return;
            const start = new Date(startDateInput.value);
            const days = parseInt(durationInput.value) || 30;
            const end = new Date(start);
            end.setDate(end.getDate() + days);

            const day = String(end.getDate()).padStart(2, '0');
            const month = String(end.getMonth() + 1).padStart(2, '0');
            const year = end.getFullYear();

            calculatedEndDateSpan.textContent = `${day}.${month}.${year}`;
        }

        // Set default start date to today
        const todayStr = new Date().toISOString().split('T')[0];
        startDateInput.value = todayStr;
        startDateInput.min = todayStr;
        startDateInput.addEventListener("change", updateEndDate);

        // ----------------------------------------------------
        // 3. Open Modal & Populate Data
        // ----------------------------------------------------
        const purchaseModalElement = document.getElementById('quickPurchaseModal');
        const purchaseModal = new bootstrap.Modal(purchaseModalElement);
        const modalFormContainer = document.getElementById("modalFormContainer");
        const modalSuccessContainer = document.getElementById("modalSuccessContainer");
        const modalAlert = document.getElementById("modalAlert");

        document.querySelectorAll(".btn-open-modal").forEach(button => {
            button.addEventListener("click", function () {
                const id = this.getAttribute("data-tariff-id");
                const name = this.getAttribute("data-tariff-name");
                const price = this.getAttribute("data-tariff-price");
                const duration = this.getAttribute("data-tariff-duration");
                const type = this.getAttribute("data-tariff-type");

                document.getElementById("formTariffId").value = id;
                document.getElementById("formDurationDays").value = duration;
                document.getElementById("modalTariffName").textContent = name;
                document.getElementById("modalTariffPrice").textContent = price;
                document.getElementById("modalTariffDuration").textContent = duration;
                document.getElementById("modalTariffBadge").textContent = type || "Абонемент";

                // Reset view states
                modalFormContainer.classList.remove("d-none");
                modalSuccessContainer.classList.add("d-none");
                modalAlert.classList.add("d-none");

                updateEndDate();
                purchaseModal.show();
            });
        });

        // ----------------------------------------------------
        // 4. Payment Method Card Selection
        // ----------------------------------------------------
        const paymentCards = document.querySelectorAll(".payment-method-card");
        const selectedPaymentMethodInput = document.getElementById("selectedPaymentMethod");

        paymentCards.forEach(card => {
            card.addEventListener("click", function () {
                paymentCards.forEach(c => c.classList.remove("active"));
                this.classList.add("active");
                selectedPaymentMethodInput.value = this.getAttribute("data-method");
            });
        });

        // ----------------------------------------------------
        // 5. AJAX Quick Purchase Form Submission
        // ----------------------------------------------------
        const quickForm = document.getElementById("quickPurchaseForm");
        const submitBtn = document.getElementById("btnSubmitPurchase");
        const submitSpinner = document.getElementById("submitSpinner");
        const submitBtnText = document.getElementById("submitBtnText");

        quickForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            modalAlert.classList.add("d-none");
            submitBtn.disabled = true;
            submitSpinner.classList.remove("d-none");

            const payload = {
                tariffId: parseInt(document.getElementById("formTariffId").value),
                fullName: document.getElementById("customerFullName").value,
                phone: document.getElementById("customerPhone").value,
                email: document.getElementById("customerEmail").value,
                startDate: document.getElementById("subscriptionStartDate").value,
                paymentMethod: selectedPaymentMethodInput.value
            };

            try {
                const response = await fetch('/Tariff/QuickPurchase', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    // Populate success card
                    document.getElementById("passTariffName").textContent = data.tariffName;
                    document.getElementById("passUserName").textContent = data.userName;
                    document.getElementById("passDates").textContent = `${data.startDate} — ${data.endDate}`;
                    document.getElementById("successMessageText").textContent = data.message;

                    modalFormContainer.classList.add("d-none");
                    modalSuccessContainer.classList.remove("d-none");
                } else {
                    modalAlert.textContent = data.message || "Помилка при оформленні абонемента.";
                    modalAlert.classList.remove("d-none");
                }
            } catch (err) {
                modalAlert.textContent = "Не вдалося з'єднатися із сервером. Спробуйте пізніше.";
                modalAlert.classList.remove("d-none");
            } finally {
                submitBtn.disabled = false;
                submitSpinner.classList.add("d-none");
            }
        });
    });
</script>
}