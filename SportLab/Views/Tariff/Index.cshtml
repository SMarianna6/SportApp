@model IEnumerable<SportLab.Models.Tariff>

@{
    ViewData["Title"] = "Tariffs";
}

<div class="container mt-4">
    <h2>List of Tariffs</h2>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">New Tariff</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Duration</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>@item.Duration</td>
                    <td>@item.Type</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
