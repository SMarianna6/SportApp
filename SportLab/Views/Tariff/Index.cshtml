<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/tariffs.css" asp-append-version="true" />

<div class="container my-4">
    <!-- Hero Header -->
    <div class="tariffs-hero text-center text-md-start">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge-hero mb-3">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Premium Fitness Experience
                </span>
                <h1 class="display-5 fw-bold mb-3 text-white">Memberships & Club Passes</h1>
                <p class="lead text-light mb-0" style="opacity: 0.9;">
                    Choose the perfect workout plan tailored to your fitness goals. Top-tier equipment, certified trainers, and world-class service.
                </p>
            </div>
            <div class="col-lg-4 text-center text-md-end mt-4 mt-lg-0">
                <a asp-action="Create" class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add New Plan
                </a>
            </div>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="tariffs-filter-container">
        <button type="button" class="filter-pill active" data-filter="all">
            <i class="bi bi-grid-fill me-1"></i> All Plans
        </button>
        <button type="button" class="filter-pill" data-filter="popular">
            <i class="bi bi-star-fill text-warning me-1"></i> Popular
        </button>
        <button type="button" class="filter-pill" data-filter="basic">
            <i class="bi bi-check2-circle me-1"></i> Basic
        </button>
        <button type="button" class="filter-pill" data-filter="premium">
            <i class="bi bi-gem me-1"></i> Premium / Annual
        </button>
        <button type="button" class="filter-pill" data-filter="student">
            <i class="bi bi-mortarboard-fill me-1"></i> Student
        </button>
    </div>

    <!-- Tariffs Cards Grid -->
    <div class="row g-4" id="tariffsGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-light rounded-4 border">
                    <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                    <h4 class="fw-bold">No Membership Plans Found</h4>
                    <p class="text-muted">Create a new plan or reload the page to load default options.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Create Plan</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var fullSearchText = $"{(item.Type ?? "")} {(item.Name ?? "")} {(item.Description ?? "")}".ToLowerInvariant();
                var cardCategories = new List<string> { "all" };

                // Student detection (Ukrainian & English keywords)
                if (fullSearchText.Contains("студент") || fullSearchText.Contains("student") || fullSearchText.Contains("учен") || fullSearchText.Contains("youth"))
                {
                    cardCategories.Add("student");
                }

                // Basic detection (Ukrainian & English keywords or lower price tier)
                if (fullSearchText.Contains("базов") || fullSearchText.Contains("basic") || fullSearchText.Contains("стандарт") || fullSearchText.Contains("standard") || fullSearchText.Contains("start") || fullSearchText.Contains("старт") || (item.Price < 1000 && !cardCategories.Contains("student")))
                {
                    cardCategories.Add("basic");
                }

                // Popular / Pro detection
                if (fullSearchText.Contains("популяр") || fullSearchText.Contains("popular") || fullSearchText.Contains("про") || fullSearchText.Contains("pro") || fullSearchText.Contains("хіт") || fullSearchText.Contains("hit") || fullSearchText.Contains("безліміт") || fullSearchText.Contains("unlimited"))
                {
                    cardCategories.Add("popular");
                }

                // Premium / VIP / Elite / Annual detection
                if (fullSearchText.Contains("преміум") || fullSearchText.Contains("premium") || fullSearchText.Contains("vip") || fullSearchText.Contains("elite") || fullSearchText.Contains("еліт") || fullSearchText.Contains("річн") || fullSearchText.Contains("annual") || fullSearchText.Contains("year") || item.Price >= 3000 || item.Duration >= 180)
                {
                    cardCategories.Add("premium");
                }

                // Fallback: ensure every card is categorized
                if (cardCategories.Count == 1)
                {
                    cardCategories.Add("basic");
                }

                var isStudent = cardCategories.Contains("student");
                var isFeatured = cardCategories.Contains("popular");
                var isVip = cardCategories.Contains("premium");

                string iconClass = "bi-fire";
                if (isVip) iconClass = "bi-gem";
                else if (isFeatured) iconClass = "bi-lightning-charge-fill";
                else if (isStudent) iconClass = "bi-mortarboard-fill";

                string cardModifier = isFeatured ? "featured" : (isVip ? "vip" : (isStudent ? "student" : ""));
                string categoriesAttr = string.Join(" ", cardCategories);

                string badgeLabel = isStudent ? "Student" : (isVip ? "Premium" : (isFeatured ? "Best Seller" : (item.Type ?? "Plan")));

                <div class="col-lg-4 col-md-6 tariff-card-col" data-categories="@categoriesAttr">
                    <div class="tariff-card @cardModifier">
                        @if (isFeatured)
                        {
                            <div class="ribbon-featured">Best Seller</div>
                        }

                        <!-- Card Header -->
                        <div class="tariff-card-header">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="tariff-icon-wrapper">
                                    <i class="bi @iconClass"></i>
                                </div>
                                <span class="tariff-badge-type">@badgeLabel</span>
                            </div>

                            <h3 class="tariff-title">@item.Name</h3>

                            <div class="tariff-price-block">
                                <span class="tariff-currency">₴</span>
                                <span class="tariff-amount">@item.Price.ToString("N0")</span>
                                <span class="tariff-period">/ @(item.Duration >= 365 ? "year" : $"{item.Duration} days")</span>
                            </div>

                            <div class="tariff-duration-chip">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>Duration: <strong>@item.Duration days</strong></span>
                            </div>
                        </div>

                        <!-- Card Body (Included Services) -->
                        <div class="tariff-card-body">
                            <div class="tariff-features-title">Included in this plan:</div>
                            <ul class="tariff-features-list">
                                @{
                                    var features = (item.Description ?? "")
                                        .Split(new[] { "\r\n", "\r", "\n", ";" }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(f => f.Trim())
                                        .Where(f => !string.IsNullOrWhiteSpace(f));

                                    if (!features.Any())
                                    {
                                        <li class="tariff-feature-item">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Full gym & cardio area access</span>
                                        </li>
                                        <li class="tariff-feature-item">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Locker rooms & shower facilities</span>
                                        </li>
                                    }
                                    else
                                    {
                                        foreach (var feature in features)
                                        {
                                            <li class="tariff-feature-item">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>@feature</span>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>

                        <!-- Card Footer & Actions -->
                        <div class="tariff-card-footer">
                            <button type="button" 
                                    class="btn-buy-tariff btn-open-modal"
                                    data-tariff-id="@item.Id"
                                    data-tariff-name="@item.Name"
                                    data-tariff-price="@item.Price.ToString("N0")"
                                    data-tariff-duration="@item.Duration"
                                    data-tariff-type="@badgeLabel">
                                <i class="bi bi-bag-check-fill"></i> Quick Purchase
                            </button>

                            <a asp-action="ConfirmPurchase" asp-route-id="@item.Id" class="btn-detail-tariff">
                                <i class="bi bi-shield-check me-1"></i> Order with Guarantee
                            </a>

                            <!-- Admin Controls -->
                            <div class="admin-tariff-actions">
                                <span class="text-muted small me-auto align-self-center"><i class="bi bi-gear"></i> Manage:</span>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this membership?')">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Empty Filter State -->
            <div class="col-12 text-center py-4 d-none" id="filterEmptyState">
                <div class="p-4 bg-white rounded-4 border shadow-sm">
                    <i class="bi bi-funnel text-primary fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark">No plans found in this category</h5>
                    <p class="text-muted small mb-3">Try choosing another category or view all available memberships.</p>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 py-2 fw-semibold" onclick="document.querySelector('[data-filter=all]').click();">
                        <i class="bi bi-grid-fill me-1"></i> View All Plans
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Trust Badges -->
    <div class="row mt-5 g-4">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-primary fs-1 mb-2"><i class="bi bi-shield-fill-check"></i></div>
                <h5 class="fw-bold">100% Secure Checkout</h5>
                <p class="text-muted small mb-0">Instant digital pass activation right after payment confirmation.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-success fs-1 mb-2"><i class="bi bi-snow2"></i></div>
                <h5 class="fw-bold">Complimentary Freeze</h5>
                <p class="text-muted small mb-0">Pause your membership anytime during vacation or illness.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <div class="text-danger fs-1 mb-2"><i class="bi bi-person-check-fill"></i></div>
                <h5 class="fw-bold">Introductory Session</h5>
                <p class="text-muted small mb-0">Complimentary first training session and body composition analysis included.</p>
            </div>
        </div>
    </div>
</div>

