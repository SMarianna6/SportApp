@model IEnumerable<SportLab.Models.Tariff>

@{
    ViewData["Title"] = "Tariffs & Memberships";
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Club Memberships</span>
            <h1 class="display-5 fw-bold mb-1">Choose Your Fitness Journey</h1>
            <p class="text-muted">Flexible plans tailored for everyday enthusiasts, seasoned athletes, and students.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> New Tariff
            </a>
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="toggleTableView()">
                <i class="bi bi-table me-1"></i> Toggle Table View
            </button>
        </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="row g-4 align-items-stretch mb-5" id="pricingCardsView">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var isPopular = item.Name.Contains("Pro", StringComparison.OrdinalIgnoreCase);
                var isElite = item.Name.Contains("Elite", StringComparison.OrdinalIgnoreCase);
                
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 border-0 rounded-4 shadow-sm position-relative overflow-hidden @(isPopular ? "border border-2 border-primary shadow" : "")">
                        @if (isPopular)
                        {
                            <div class="bg-primary text-white text-center py-1 small fw-bold text-uppercase tracking-wider">
                                Most Popular
                            </div>
                        }
                        else if (isElite)
                        {
                            <div class="bg-dark text-white text-center py-1 small fw-bold text-uppercase tracking-wider">
                                VIP & All-Inclusive
                            </div>
                        }

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill small">@item.Type</span>
                                <h3 class="fw-bold mt-2 mb-1">@item.Name</h3>
                                <p class="text-muted small">@item.Description</p>
                            </div>

                            <div class="my-3">
                                <span class="display-5 fw-bold text-dark">$@item.Price.ToString("0.##")</span>
                                <span class="text-muted">/ @(item.Duration >= 30 ? (item.Duration / 30) + " mo" : item.Duration + " days")</span>
                            </div>

                            <ul class="list-unstyled small text-muted my-3 flex-grow-1">
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success"></i> Full gym zone access
                                </li>
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success"></i> Locker & shower amenities
                                </li>
                                <li class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success"></i> Duration: @item.Duration days
                                </li>
                                @if (isPopular || isElite)
                                {
                                    <li class="mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i> Group fitness classes
                                    </li>
                                    <li class="mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i> 24/7 Unlimited access
                                    </li>
                                }
                                @if (isElite)
                                {
                                    <li class="mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i> Spa, sauna & pool passes
                                    </li>
                                    <li class="mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i> 5 Personal training sessions
                                    </li>
                                }
                            </ul>

                            <div class="mt-auto pt-3 border-top">
                                <button type="button" class="btn @(isPopular ? "btn-primary" : "btn-dark") w-100 rounded-pill py-2 mb-2" onclick="selectPlan('@item.Name', '@item.Price')">
                                    Select @item.Name
                                </button>
                                <div class="d-flex justify-content-between text-muted small px-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none text-muted">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none text-danger" onclick="return confirm('Delete this tariff?')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted lead">No active tariffs found in database.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill">Create the First Tariff</a>
            </div>
        }
    </div>

    <!-- Administrative Table View (Toggleable) -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-5" id="tariffTableView" style="display: none;">
        <h4 class="fw-bold mb-3">Management Table View</h4>
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Duration (Days)</th>
                        <th>Type</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td>@item.Description</td>
                                <td>$@item.Price.ToString("0.##")</td>
                                <td>@item.Duration</td>
                                <td><span class="badge bg-secondary">@item.Type</span></td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm rounded-pill px-3">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm rounded-pill px-3" onclick="return confirm('Are you sure you want to delete this?')">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Membership Benefits Section -->
    <div class="card border-0 bg-light rounded-4 p-4 p-md-5 my-5">
        <h3 class="fw-bold mb-4 text-center">Every Membership Includes</h3>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-shield-check"></i></div>
                <h6 class="fw-bold">Free Fitness Assessment</h6>
                <p class="small text-muted mb-0">Introductory 1-on-1 body composition test and fitness orientation.</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-phone"></i></div>
                <h6 class="fw-bold">Mobile App Check-in</h6>
                <p class="small text-muted mb-0">Contactless QR club pass directly in your smartphone profile.</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-droplet"></i></div>
                <h6 class="fw-bold">Purified Water Bar</h6>
                <p class="small text-muted mb-0">Unlimited cold and ambient filtered hydration stations.</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-pause-circle"></i></div>
                <h6 class="fw-bold">Freeze Days</h6>
                <p class="small text-muted mb-0">Pause your plan up to 30 days when traveling or recovering.</p>
            </div>
        </div>
    </div>
</div>

<!-- Plan Modal -->
<div class="modal fade" id="planModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="planModalTitle">Membership Selected</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="display-6 text-primary mb-3"><i class="bi bi-check-circle"></i></div>
                <h4 id="modalPlanName" class="fw-bold mb-1"></h4>
                <p class="text-muted mb-4">Total due today: <strong id="modalPlanPrice" class="text-dark"></strong></p>
                <div class="mb-3 text-start">
                    <label class="form-label small fw-semibold">Cardholder Name</label>
                    <input type="text" class="form-control rounded-3" value="Alex Smith" />
                </div>
                <div class="mb-4 text-start">
                    <label class="form-label small fw-semibold">Card Number</label>
                    <input type="text" class="form-control rounded-3" value="•••• •••• •••• 4242" />
                </div>
                <button type="button" class="btn btn-primary w-100 rounded-pill py-2" onclick="confirmPayment()">
                    Confirm & Activate Membership
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleTableView() {
        const tableView = document.getElementById('tariffTableView');
        tableView.style.display = tableView.style.display === 'none' ? 'block' : 'none';
    }

    function selectPlan(name, price) {
        document.getElementById('modalPlanName').innerText = name + ' Membership';
        document.getElementById('modalPlanPrice').innerText = '$' + price;
        const modal = new bootstrap.Modal(document.getElementById('planModal'));
        modal.show();
    }

    function confirmPayment() {
        alert('🎉 Membership successfully activated! Welcome to SportLab!');
        const modalEl = document.getElementById('planModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
        window.location.href = '/Profile/Client';
    }
</script>
