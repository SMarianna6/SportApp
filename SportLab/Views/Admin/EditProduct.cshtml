@model SportLab.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">
    <h2>Edit Product</h2>
    <hr />
    <form asp-action="EditProduct">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Stock</label>
            <input asp-for="StockQuantity" class="form-control" type="number" step="1" min="0" required />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
