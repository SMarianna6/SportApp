@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SportLab.SharedResource> SharedLocalizer

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = Localizer["DashboardTitle"];
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page" data-sh-page="dashboard">
    <div class="sh-head">
        <div>
            <h1 class="sh-title">@Localizer["DashboardHeader"]</h1>
            <p class="sh-sub">@Localizer["DashboardSubHeader"]</p>
        </div>
    </div>

    <div class="sh-stats" id="sh-stats"></div>

    <div class="sh-dash-grid">
        <div class="sh-card sh-chart-card">
            <div class="sh-chart-head">
                <h2 class="sh-h2">@Localizer["PlatformGrowthHeader"]</h2>
                <div class="sh-chart-controls">
                    <button type="button" class="sh-select-btn sh-n"><span class="sh-dot sh-dot-n"></span>@Localizer["RevenueBtn"] <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                    <button type="button" class="sh-select-btn sh-v"><span class="sh-dot sh-dot-v"></span>@Localizer["NewUsersBtn"] <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                    <button type="button" class="sh-select-btn sh-dim">2026 <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                </div>
            </div>
            <div class="sh-chart-wrap">
                <svg id="sh-chart" class="sh-chart-svg" role="img" aria-label="@Localizer["ChartAriaLabel"]"></svg>
                <div id="sh-tooltip" class="sh-tooltip" hidden></div>
            </div>
        </div>

        <div class="sh-card sh-events-card">
            <h2 class="sh-h2">@Localizer["RecentEventsHeader"]</h2>
            <ul class="sh-events" id="sh-events"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.ADMIN_DASH_LOC = {
            months: @Html.Raw(Json.Serialize(new[] {
                Localizer["MonthJan"].Value,
                Localizer["MonthFeb"].Value,
                Localizer["MonthMar"].Value,
                Localizer["MonthApr"].Value,
                Localizer["MonthMay"].Value,
                Localizer["MonthJun"].Value,
                Localizer["MonthJul"].Value,
                Localizer["MonthAug"].Value,
                Localizer["MonthSep"].Value,
                Localizer["MonthOct"].Value,
                Localizer["MonthNov"].Value,
                Localizer["MonthDec"].Value
            })),
            tooltipRevenue: @Html.Raw(Json.Serialize(Localizer["TooltipRevenue"].Value)),
            tooltipNewUsers: @Html.Raw(Json.Serialize(Localizer["TooltipNewUsers"].Value)),
            statRevenue: @Html.Raw(Json.Serialize(Localizer["Metric.Revenue"].Value)),
            statActiveMembers: @Html.Raw(Json.Serialize(Localizer["Metric.ActiveMembers"].Value)),
            statClassBookings: @Html.Raw(Json.Serialize(Localizer["Metric.ClassBookings"].Value)),
            statShopSales: @Html.Raw(Json.Serialize(Localizer["Metric.ShopSales"].Value)),
            loadFailed: @Html.Raw(Json.Serialize(Localizer["LoadFailedError"].Value))
        };
    </script>
    <script src="~/js/admin/sh-common.js" asp-append-version="true"></script>
    <script src="~/js/admin/sh-dashboard.js" asp-append-version="true"></script>
}
