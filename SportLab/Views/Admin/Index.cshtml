@model SportLab.Models.AdminPanelData

@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <h2>List of Users</h2>
    <p>
        <a asp-action="CreateUser" class="btn btn-primary">New User</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Users)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Role</td>
                    <td>
                        @(item.IsBlocked ? "Blocked" : "Active")
                    </td>
                    <td class="col-actions">
                        @if (item.IsBlocked)
                        {
                            <form asp-action="ToggleBlockUser" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-success btn-sm">Unblock</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="ToggleBlockUser" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Block</button>
                            </form>
                        }
                        <a asp-action="EditUser" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="DeleteUser" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="mt-5">List of Tariffs</h2>
    <p>
        <a asp-action="CreateTariff" class="btn btn-primary">New Tariff</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Duration</th>
                <th>Type</th>
                <th class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Tariffs)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>@item.Duration</td>
                    <td>@item.Type</td>
                    <td class="col-actions">
                        <a asp-action="EditTariff" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="DeleteTariff" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this tariff?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="mt-5">List of Products</h2>
    <p>
        <a asp-action="CreateProduct" class="btn btn-primary">New Product</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock Quantity</th>
                <th class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>@item.StockQuantity</td>
                    <td class="col-actions">
                        <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="DeleteProduct" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>