@{
    ViewData["Title"] = "Gym Administration Panel";
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-2 rounded-pill mb-2">Staff & Management</span>
            <h1 class="display-5 fw-bold mb-1">Club Administration Hub</h1>
            <p class="text-muted">Real-time gym capacity, revenue metrics, turnstile entry control, and catalog management.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tariff" asp-action="Create" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i> New Membership
            </a>
            <a asp-controller="Profile" asp-action="Trainer" class="btn btn-dark rounded-pill px-3">
                <i class="bi bi-person-badge me-1"></i> Trainer View
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-primary text-white h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-white-50 small">Current In-Club Athletes</span>
                        <h2 class="display-6 fw-bold my-2" id="liveOccupancy">42 / 120</h2>
                        <span class="badge bg-white text-primary">35% Facility Capacity</span>
                    </div>
                    <div class="fs-1 text-white-50"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Today's Revenue</span>
                        <h2 class="display-6 fw-bold my-2 text-dark">$1,480.00</h2>
                        <span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-up-right"></i> +12% vs last week</span>
                    </div>
                    <div class="fs-1 text-success"><i class="bi bi-currency-dollar"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Active Subscriptions</span>
                        <h2 class="display-6 fw-bold my-2 text-dark">384</h2>
                        <span class="badge bg-primary-subtle text-primary">94.2% Renewal Rate</span>
                    </div>
                    <div class="fs-1 text-primary"><i class="bi bi-card-checklist"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Turnstile Scans Today</span>
                        <h2 class="display-6 fw-bold my-2 text-dark">168</h2>
                        <span class="badge bg-info-subtle text-info">Peak: 18:30 - 20:00</span>
                    </div>
                    <div class="fs-1 text-info"><i class="bi bi-qr-code-scan"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Quick Links -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Live Turnstile & Member Check-in Log</h5>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="simulateCheckIn()">
                        <i class="bi bi-plus-lg me-1"></i> Scan Test Card
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="text-muted small">
                            <tr>
                                <th>Timestamp</th>
                                <th>Member</th>
                                <th>Card Type</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="turnstileLog">
                            <tr>
                                <td class="small text-muted">10:48:12 AM</td>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary p-1 px-2 fw-semibold small">AS</div>
                                        <span>Alex Smith (#10842)</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-dark">Pro (3 Mo)</span></td>
                                <td><span class="badge bg-success">Access Granted</span></td>
                                <td class="text-end"><button class="btn btn-sm btn-link text-muted p-0" onclick="alert('Member Alex Smith details: Active until Dec 31')">Details</button></td>
                            </tr>
                            <tr>
                                <td class="small text-muted">10:45:30 AM</td>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-info-subtle text-info p-1 px-2 fw-semibold small">DK</div>
                                        <span>Daria Kovalchuk (#10799)</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-primary">Elite Annual</span></td>
                                <td><span class="badge bg-success">Access Granted</span></td>
                                <td class="text-end"><button class="btn btn-sm btn-link text-muted p-0" onclick="alert('Member Daria Kovalchuk details: VIP Locker #14')">Details</button></td>
                            </tr>
                            <tr>
                                <td class="small text-muted">10:39:05 AM</td>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-warning-subtle text-warning p-1 px-2 fw-semibold small">MB</div>
                                        <span>Maksym Bondar (#10420)</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">Basic Pass</span></td>
                                <td><span class="badge bg-danger">Expired Plan</span></td>
                                <td class="text-end"><a asp-controller="Tariff" asp-action="Index" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill">Renew</a></td>
                            </tr>
                            <tr>
                                <td class="small text-muted">10:22:40 AM</td>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-success-subtle text-success p-1 px-2 fw-semibold small">OM</div>
                                        <span>Olena Moroz (#10901)</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-dark">Pro (3 Mo)</span></td>
                                <td><span class="badge bg-success">Access Granted</span></td>
                                <td class="text-end"><button class="btn btn-sm btn-link text-muted p-0" onclick="alert('Member Olena Moroz details: Active until Nov 15')">Details</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Fast Modules -->
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4">
                <h5 class="fw-bold mb-3">Quick Navigation</h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Tariff" asp-action="Index" class="btn btn-light text-start py-2 rounded-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-tags-fill me-2 text-primary"></i>Tariffs & Plans CRUD</span>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-light text-start py-2 rounded-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-bag-check-fill me-2 text-success"></i>Shop Inventory Catalog</span>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a asp-controller="Schedule" asp-action="Index" class="btn btn-light text-start py-2 rounded-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-calendar-week-fill me-2 text-warning"></i>Group Classes Timetable</span>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a asp-controller="Home" asp-action="Trainers" class="btn btn-light text-start py-2 rounded-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-lines-fill me-2 text-info"></i>Trainer Roster</span>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>

            <!-- Facility Health Status -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-light">
                <h6 class="fw-bold mb-3">Equipment & Zone Status</h6>
                <div class="mb-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Cardio Theater & Treadmills</span>
                        <span class="text-success fw-bold">100% Operational</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 100%;"></div>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Sauna & Thermal Recovery Spa</span>
                        <span class="text-success fw-bold">88°C Optimal</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: 90%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Smart Lockers Occupancy</span>
                        <span class="text-dark fw-bold">58 / 200 In Use</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: 29%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let scanCount = 42;
    function simulateCheckIn() {
        scanCount++;
        document.getElementById('liveOccupancy').innerText = scanCount + ' / 120';

        const names = ['Yaroslav Shevchenko', 'Kateryna Polishchuk', 'Bohdan Melnyk', 'Iryna Tkachenko'];
        const randomName = names[Math.floor(Math.random() * names.length)];
        const id = Math.floor(10000 + Math.random() * 9000);
        const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

        const tbody = document.getElementById('turnstileLog');
        const tr = document.createElement('tr');
        tr.className = 'table-success';
        tr.innerHTML = `
            <td class="small text-muted">${now}</td>
            <td class="fw-bold">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success-subtle text-success p-1 px-2 fw-semibold small">OK</div>
                    <span>${randomName} (#${id})</span>
                </div>
            </td>
            <td><span class="badge bg-dark">Pro (3 Mo)</span></td>
            <td><span class="badge bg-success">Access Granted</span></td>
            <td class="text-end"><button class="btn btn-sm btn-link text-muted p-0" onclick="alert('Member checked in.')">Details</button></td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
    }
</script>
