@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page" data-sh-page="dashboard">
    <div class="sh-head">
        <div>
            <h1 class="sh-title">Dashboard</h1>
            <p class="sh-sub">Club performance at a glance</p>
        </div>
    </div>

    <div class="sh-stats" id="sh-stats"></div>

    <div class="sh-dash-grid">
        <div class="sh-card sh-chart-card">
            <div class="sh-chart-head">
                <h2 class="sh-h2">Platform Growth</h2>
                <div class="sh-chart-controls">
                    <button type="button" class="sh-select-btn sh-n"><span class="sh-dot sh-dot-n"></span>Revenue <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                    <button type="button" class="sh-select-btn sh-v"><span class="sh-dot sh-dot-v"></span>New Users <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                    <button type="button" class="sh-select-btn sh-dim">2026 <svg class="sh-ico sh-ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                </div>
            </div>
            <div class="sh-chart-wrap">
                <svg id="sh-chart" class="sh-chart-svg" role="img" aria-label="Revenue and new users by month"></svg>
                <div id="sh-tooltip" class="sh-tooltip" hidden></div>
            </div>
        </div>

        <div class="sh-card sh-events-card">
            <h2 class="sh-h2">Recent Events</h2>
            <ul class="sh-events" id="sh-events"></ul>
        </div>
    </div>
</div>

<script src="~/js/admin/sh-common.js" asp-append-version="true"></script>
<script src="~/js/admin/sh-dashboard.js" asp-append-version="true"></script>
