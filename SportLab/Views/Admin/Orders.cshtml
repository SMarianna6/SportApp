@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Order Moderation";
}

@Html.AntiForgeryToken()

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-7xl">
        
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Admin Panel</p>
                <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">Orders</h1>
                <p class="mt-1 text-sm text-white/50">Manage and track customer orders.</p>
            </div>
            
            <div class="flex items-center gap-2">
                <label class="relative block">
                    <span class="sr-only">Search orders</span>
                    <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input id="order-search" type="search" placeholder="Search by ID or client..." class="w-full rounded-md bg-[#1a1a1a] border border-white/10 py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-white/40 focus:border-neon focus:outline-none sm:w-64" />
                </label>
            </div>
        </div>

        <div class="overflow-x-auto rounded-lg border border-white/10 bg-[#1a1a1a]">
            <table class="w-full min-w-[800px] text-left text-sm">
                <thead>
                    <tr class="border-b border-white/10 text-[11px] font-bold uppercase tracking-widest text-white/50 bg-[#222]">
                        <th scope="col" class="px-5 py-4">Order ID</th>
                        <th scope="col" class="px-5 py-4">Client</th>
                        <th scope="col" class="px-5 py-4">Date</th>
                        <th scope="col" class="px-5 py-4">Total</th>
                        <th scope="col" class="px-5 py-4">Status</th>
                        <th scope="col" class="px-5 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="orders-table-body" class="divide-y divide-white/5">
                    <tr><td colspan="6" class="p-8 text-center text-sm text-white/50 animate-pulse">Loading orders...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Order Details Modal -->
<div id="order-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true">
    <div id="modal-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-2xl transform-gpu rounded-xl border border-white/10 bg-[#1a1a1a] shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between border-b border-white/10 bg-[#222] px-6 py-4">
            <h3 class="text-xl font-black uppercase tracking-tight text-white" id="modal-title">Order Details</h3>
            <button type="button" id="modal-close" class="rounded-md p-2 text-white/50 hover:bg-white/10 hover:text-white transition-colors">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>
        
        <div class="p-6 max-h-[70vh] overflow-y-auto">
            <div class="mb-6 grid grid-cols-2 gap-4 rounded-lg bg-white/5 p-4 border border-white/5">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Client</p>
                    <p id="modal-client" class="font-bold text-white mt-1"></p>
                    <p id="modal-email" class="text-xs text-white/60"></p>
                </div>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Order Info</p>
                    <p id="modal-date" class="font-bold text-white mt-1"></p>
                    <p id="modal-total" class="text-xs text-neon font-bold"></p>
                </div>
            </div>

            <h4 class="text-sm font-bold uppercase tracking-widest text-white/70 mb-3">Items</h4>
            <div id="modal-items" class="space-y-3"></div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-10 opacity-0 rounded-lg bg-[#1a1a1a] px-5 py-3 text-sm font-bold shadow-2xl border border-white/10 transition-all duration-300 pointer-events-none">
    <span id="toast-text" class="text-white"></span>
</div>

@section Scripts {
    <script src="~/js/admin/sh-orders.js" asp-append-version="true"></script>
}