@model SportLab.Models.Plan

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Tariffs";
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page" data-sh-page="tariffs">
    <div class="sh-head">
        <div>
            <h1 class="sh-title">Tariffs</h1>
            <p class="sh-sub">Manage membership plans</p>
        </div>
        <button type="button" class="sh-btn sh-btn-primary" id="sh-tariff-add">
            <svg class="sh-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>Add Tariff
        </button>
    </div>

    <div class="sh-tariff-grid" id="sh-tariff-grid"></div>
</div>

<div class="sh-modal-backdrop" id="sh-tariff-modal" hidden>
    <div class="sh-modal" role="dialog" aria-modal="true" aria-labelledby="sh-tariff-modal-title">
        <div class="sh-modal-bar"></div>
        <div class="sh-modal-head">
            <h2 class="sh-modal-title" id="sh-tariff-modal-title">Add Tariff</h2>
            <button type="button" class="sh-modal-close" data-sh-close aria-label="Close"><svg class="sh-ico sh-ico-lg" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></button>
        </div>
        <div class="sh-modal-body">
            @* MVC integration point: post to your own controller action (add @Html.AntiForgeryToken() if needed). *@
            <form class="sh-form" id="sh-tariff-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     style="color: #ff4d4d; font-size: 14px; margin-bottom: 10px;">
                </div>

                <label class="sh-field">
                    Name
                    <div class="sh-field-body">
                        <input class="sh-input" asp-for="Name" />
                        <span asp-validation-for="Name"
                              style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </label>

                <label class="sh-field">
                    Description
                    <div class="sh-field-body">
                        <textarea class="sh-input" asp-for="Description" rows="3"></textarea>
                        <span asp-validation-for="Description"
                              style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </label>

                <div class="sh-form-grid">
                    <label class="sh-field">
                        Price
                        <div class="sh-field-body">
                            <input class="sh-input" asp-for="Price" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Price"
                                  style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                        </div>
                    </label>

                    <label class="sh-field">
                        Duration (days)
                        <div class="sh-field-body">
                            <input class="sh-input" asp-for="Duration" type="number" step="1" min="1" />
                            <span asp-validation-for="Duration"
                                  style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                        </div>
                    </label>
                </div>

                <label class="sh-field">
                    Type
                    <div class="sh-field-body">
                        <input class="sh-input" asp-for="Type"
                               placeholder="Monthly, Annual, Trial..." />
                        <span asp-validation-for="Type"
                              style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </label>

                <div class="sh-form-actions">
                    <button type="button" class="sh-btn sh-btn-ghost" data-sh-close>Cancel</button>
                    <button type="submit" class="sh-btn sh-btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/admin/sh-common.js" asp-append-version="true"></script>
<script src="~/js/admin/sh-tariffs.js" asp-append-version="true"></script>
