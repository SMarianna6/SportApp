@model SportLab.Models.WorkoutSlot
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SportLab.SharedResource> SharedLocalizer

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = Localizer["ScheduleTitle"];

    var typeLabels = new Dictionary<string, string>
    {
        ["HIIT"] = Localizer["TypeHIIT"].Value,
        ["Pilates"] = Localizer["TypePilates"].Value,
        ["Yoga"] = Localizer["TypeYoga"].Value,
        ["Strength"] = Localizer["TypeStrength"].Value,
        ["Cycling"] = Localizer["TypeCycling"].Value,
        ["Boxing"] = Localizer["TypeBoxing"].Value
    };
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page" data-sh-page="schedule">
    <div class="sh-head">
        <div>
            <h1 class="sh-title">@Localizer["ScheduleHeader"]</h1>
            <p class="sh-sub">@Localizer["ScheduleSubHeader"]</p>
        </div>
    </div>

    <div class="sh-legend" id="sh-schedule-legend" role="group" aria-label="@Localizer["FilterClassesAria"]"></div>

    <div class="sh-card sh-scroll-x">
        <div class="sh-cal" id="sh-cal"></div>
    </div>
</div>

<div class="sh-modal-backdrop" id="sh-schedule-modal" hidden>
    <div class="sh-modal" role="dialog" aria-modal="true" aria-labelledby="sh-schedule-modal-title">
        <div class="sh-modal-bar"></div>
        <div class="sh-modal-head">
            <h2 class="sh-modal-title" id="sh-schedule-modal-title">@Localizer["ModalAddClassTitle"]</h2>
            <button type="button" class="sh-modal-close" data-sh-close aria-label="@SharedLocalizer["Close"]"><svg class="sh-ico sh-ico-lg" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></button>
        </div>
        <div class="sh-modal-body">
            <form class="sh-form" id="sh-schedule-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" style="color: #ff4d4d; font-size: 14px; margin-bottom: 10px;"></div>

                <div class="sh-form-grid">
                    <label class="sh-field">
                        @Localizer["ActivityTypeLabel"]
                        <div class="sh-field-body">
                            <select class="sh-input" name="ActivityName" id="sh-schedule-type"></select>
                        </div>
                    </label>
                    <label class="sh-field">
                        @Localizer["DayLabel"]
                        <div class="sh-field-body">
                            <select class="sh-input" name="day">
                                <option value="1">@Localizer["DayMon"]</option>
                                <option value="2">@Localizer["DayTue"]</option>
                                <option value="3">@Localizer["DayWed"]</option>
                                <option value="4">@Localizer["DayThu"]</option>
                                <option value="5">@Localizer["DayFri"]</option>
                                <option value="6">@Localizer["DaySat"]</option>
                                <option value="7">@Localizer["DaySun"]</option>
                            </select>
                        </div>
                    </label>
                    <label class="sh-field">
                        @Localizer["StartTimeLabel"]
                        <div class="sh-field-body">
                            <input class="sh-input" asp-for="StartTime" type="time" min="08:00" max="20:00" step="900" />
                            <span asp-validation-for="StartTime" style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                        </div>
                    </label>
                    <label class="sh-field">
                        @Localizer["EndTimeLabel"]
                        <div class="sh-field-body">
                            <input class="sh-input" asp-for="EndTime" type="time" min="08:00" max="20:00" step="900" />
                            <span asp-validation-for="EndTime" style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                        </div>
                    </label>
                </div>

                <label class="sh-field">
                    @Localizer["CoachLabel"]
                    <div class="sh-field-body">
                        <select class="sh-input" name="coach" required>
                            <option value="" disabled selected>@Localizer["SelectTrainerPrompt"]</option>
                            @foreach (var trainer in ViewBag.Trainers)
                            {
                                <option value="@trainer.Name">@trainer.Name</option>
                            }
                        </select>
                    </div>
                </label>

                <div class="sh-form-grid">
                    <label class="sh-field">
                        @Localizer["CapacityLabel"]
                        <div class="sh-field-body">
                            <input class="sh-input" asp-for="Capacity" type="number" min="1" step="1" />
                            <span asp-validation-for="Capacity" style="color: #ff4d4d; font-size: 12px; margin-top: 4px; display: block;"></span>
                        </div>
                    </label>
                </div>

                <p class="sh-form-error" id="sh-schedule-error" role="alert" hidden></p>

                <div class="sh-form-actions sh-between">
                    <button type="button" class="sh-btn sh-btn-outline-danger" id="sh-schedule-delete" hidden>@SharedLocalizer["Delete"]</button>
                    <div class="sh-form-actions-right">
                        <button type="button" class="sh-btn sh-btn-ghost" data-sh-close>@SharedLocalizer["Close"]</button>
                        <button type="submit" class="sh-btn sh-btn-primary">@SharedLocalizer["Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.ADMIN_SCHEDULE_LOC = {
        types: @Html.Raw(Json.Serialize(typeLabels)),
        coach: @Html.Raw(Json.Serialize(Localizer["CoachTooltip"].Value)),
        booked: @Html.Raw(Json.Serialize(Localizer["BookedTooltip"].Value))
    };
</script>
<script src="~/js/admin/sh-common.js" asp-append-version="true"></script>
<script src="~/js/admin/sh-schedule.js" asp-append-version="true"></script>