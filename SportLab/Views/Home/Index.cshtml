@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Elite Fitness Club";
}

<main id="top" class="relative bg-charcoal overflow-hidden">
    <div class="pointer-events-none absolute -left-40 top-20 h-[600px] w-[600px] rounded-full bg-electric/30 blur-[150px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-40 top-[30%] h-[600px] w-[600px] rounded-full bg-violet/20 blur-[150px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-40 bottom-[20%] h-[600px] w-[600px] rounded-full bg-neon/15 blur-[150px]" aria-hidden="true"></div>

    <!-- Hero Section -->
    <section class="grid-bg relative flex min-h-[calc(100vh-64px)] flex-col pt-12">
    <div class="relative mx-auto w-full max-w-7xl flex-1 flex flex-col justify-center px-4 pb-16 sm:px-6">
        <p class="mb-6 inline-flex w-fit items-center gap-2 rounded-md border border-neon/40 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-neon">
            <span class="h-2 w-2 rounded-full bg-neon"></span> Khmelnytskyi &middot; Open 24/7
        </p>
        <h1 id="hero-title" class="max-w-5xl text-6xl font-black uppercase leading-[0.85] tracking-tighter sm:text-8xl lg:text-[8.5rem]">
            You are<br />
            <span class="outline-text">your own</span><br />
            <span class="text-neon">limit.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-mono/70 sm:text-xl">2,400 m&sup2; of elite strength equipment in the heart of Khmelnytskyi.</p>
        
        <div class="mt-10 flex flex-col gap-6 sm:flex-row sm:gap-8">
            <a href="@Url.Action("Register", "Account")" class="inline-flex items-center justify-center gap-2 rounded-md bg-neon px-8 py-4 text-sm font-extrabold uppercase tracking-widest text-charcoal transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-neon/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">
                Join Now
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="#facility" class="inline-flex items-center justify-center rounded-md border-2 border-white/30 px-8 py-4 text-sm font-extrabold uppercase tracking-widest text-white transition-all duration-300 hover:border-neon hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">See the Floor</a>
        </div>
    </div>

    <div class="mt-auto w-full border-y border-white/10 bg-dark py-4" aria-hidden="true">
        <div class="flex w-max animate-marquee marquee-track whitespace-nowrap text-xl font-black uppercase tracking-tighter text-mono/60 sm:text-2xl">
            <span class="px-6">&bull; No ego &bull; No shortcuts &bull; <span class="text-neon">24/7 members only</span> &bull; No ego &bull; No shortcuts &bull; <span class="text-violet">24/7 members only</span> &bull; No ego &bull; No shortcuts &bull; <span class="text-neon">24/7 members only</span> &bull;</span>
            <span class="px-6">&bull; No ego &bull; No shortcuts &bull; <span class="text-neon">24/7 members only</span> &bull; No ego &bull; No shortcuts &bull; <span class="text-violet">24/7 members only</span> &bull; No ego &bull; No shortcuts &bull; <span class="text-neon">24/7 members only</span> &bull;</span>
        </div>
    </div>
</section>

    <!-- Stats & Facility Carousel -->
    <section id="facility" class="relative z-10 bg-dark py-12 sm:py-16" aria-labelledby="stats-title">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <p class="mb-4 text-[10px] font-bold uppercase tracking-widest text-mono/60">01 &mdash; Infrastructure</p>
            <h2 id="stats-title" class="max-w-4xl text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-7xl lg:text-8xl">
                Engineered for <span class="text-neon">excellence.</span>
            </h2>
            
            <dl class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
                <div class="bg-dark p-8 transition-colors duration-300 hover:bg-graphite">
                    <dd class="text-6xl font-black tracking-tighter text-violet sm:text-7xl">2,400<span class="text-3xl"> m&sup2;</span></dd>
                    <dt class="mt-3 text-sm font-semibold uppercase tracking-widest text-mono/70">Training floor</dt>
                </div>
                <div class="bg-dark p-8 transition-colors duration-300 hover:bg-graphite">
                    <dd class="text-6xl font-black tracking-tighter text-violet sm:text-7xl">180+</dd>
                    <dt class="mt-3 text-sm font-semibold uppercase tracking-widest text-mono/70">Classes every week</dt>
                </div>
                <div class="bg-dark p-8 transition-colors duration-300 hover:bg-graphite">
                    <dd class="text-6xl font-black tracking-tighter text-violet sm:text-7xl">24/7</dd>
                    <dt class="mt-3 text-sm font-semibold uppercase tracking-widest text-mono/70">Member access</dt>
                </div>
                <div class="bg-dark p-8 transition-colors duration-300 hover:bg-graphite">
                    <dd class="text-6xl font-black tracking-tighter text-violet sm:text-7xl">14</dd>
                    <dt class="mt-3 text-sm font-semibold uppercase tracking-widest text-mono/70">Coaches on staff</dt>
                </div>
            </dl>

            <!-- Photo Carousel -->
            <div class="mt-16">
                <div class="flex items-end justify-between mb-6">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-mono/50">Swipe to explore</p>
                    <div class="hidden gap-2 sm:flex">
                        <button class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-neon hover:text-neon focus:outline-none" onclick="document.getElementById('facility-scroll').scrollBy({left: -400, behavior: 'smooth'})">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-neon hover:text-neon focus:outline-none" onclick="document.getElementById('facility-scroll').scrollBy({left: 400, behavior: 'smooth'})">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
                
                <style>
                    .hide-scrollbar::-webkit-scrollbar { display: none; }
                    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
                </style>
                <div id="facility-scroll" class="hide-scrollbar flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4">
                    <div class="relative aspect-[16/9] min-w-[85vw] sm:min-w-[60vw] lg:min-w-[45vw] snap-center overflow-hidden rounded-xl bg-graphite">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1470&auto=format&fit=crop" alt="Strength Floor" class="h-full w-full object-cover" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-transparent to-transparent"></div>
                        <div class="absolute bottom-6 left-6 pr-6">
                            <p class="text-2xl font-black uppercase tracking-tighter text-white">The Strength Floor</p>
                            <p class="mt-1 text-sm text-mono/70">Forty-two racks and no queue.</p>
                        </div>
                    </div>
                    <div class="relative aspect-[16/9] min-w-[85vw] sm:min-w-[60vw] lg:min-w-[45vw] snap-center overflow-hidden rounded-xl bg-graphite">
                        <img src="https://images.unsplash.com/photo-1716307043003-dbe6a5cc496e?q=80&w=1470&auto=format&fit=crop" alt="Combat Studio" class="h-full w-full object-cover" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-transparent to-transparent"></div>
                        <div class="absolute bottom-6 left-6 pr-6">
                            <p class="text-2xl font-black uppercase tracking-tighter text-white">Combat Studio</p>
                            <p class="mt-1 text-sm text-mono/70">Two rings, twelve bags, endless technique.</p>
                        </div>
                    </div>
                    <div class="relative aspect-[16/9] min-w-[85vw] sm:min-w-[60vw] lg:min-w-[45vw] snap-center overflow-hidden rounded-xl bg-graphite">
                        <img src="https://images.unsplash.com/photo-1672983666814-a0e43bd3b1b9?q=80&w=1469&auto=format&fit=crop" alt="Recovery Lab" class="h-full w-full object-cover" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-transparent to-transparent"></div>
                        <div class="absolute bottom-6 left-6 pr-6">
                            <p class="text-2xl font-black uppercase tracking-tighter text-white">Recovery Lab</p>
                            <p class="mt-1 text-sm text-mono/70">Contrast therapy and guided mobility.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trainers -->
    <section id="coaches" class="relative z-10 bg-graphite py-12 sm:py-26" aria-labelledby="coaches-title">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <p class="mb-4 text-[10px] font-bold uppercase tracking-widest text-mono/60">02 &mdash; Coaches</p>
            <h2 id="coaches-title" class="max-w-4xl text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-7xl lg:text-8xl">
                The people who count <span class="text-neon">your reps.</span>
            </h2>

            <ul class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                <!-- Card 1 -->
                <li>
                    <article class="group flex h-full flex-col overflow-hidden rounded-lg bg-charcoal transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-electric/20">
                        <div class="relative aspect-[4/5] overflow-hidden bg-dark">
                            <img src="https://images.unsplash.com/photo-1704223523303-a5ed14561b1f?q=80&w=800&auto=format&fit=crop" alt="Andrii Melnyk" class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                            <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/60 to-transparent"></div>
                            <span class="absolute left-4 top-4 rounded-md bg-electric px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-white">CrossFit</span>
                            
                            <div class="absolute bottom-0 left-0 p-6 w-full">
                                <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Andrii Melnyk</h3>
                                <p class="mt-2 text-sm leading-relaxed text-mono/70">Specializes in functional hypertrophy, speed, stamina.</p>
                            </div>
                        </div>
                        <div class="p-6 pt-0 bg-charcoal mt-auto">
                            <a href="@Url.Action("Index", "Trainer")" class="inline-flex w-full items-center justify-center rounded-md border-2 border-electric px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-white transition-colors duration-300 hover:bg-electric focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Book Session</a>
                        </div>
                    </article>
                </li>
                <!-- Card 2 -->
                <li>
                    <article class="group flex h-full flex-col overflow-hidden rounded-lg bg-charcoal transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-violet/20">
                        <div class="relative aspect-[4/5] overflow-hidden bg-dark">
                            <img src="https://images.unsplash.com/photo-1696564006617-1a85ba3a8f3e?q=80&w=800&auto=format&fit=crop" alt="Denys Kravchenko" class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                            <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/60 to-transparent"></div>
                            <span class="absolute left-4 top-4 rounded-md bg-violet px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-white">Strength</span>
                            
                            <div class="absolute bottom-0 left-0 p-6 w-full">
                                <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Denys Kravchenko</h3>
                                <p class="mt-2 text-sm leading-relaxed text-mono/70">Focuses on biomechanics, muscle mass growth.</p>
                            </div>
                        </div>
                        <div class="p-6 pt-0 bg-charcoal mt-auto">
                            <a href="@Url.Action("Index", "Trainer")" class="inline-flex w-full items-center justify-center rounded-md border-2 border-violet px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-white transition-colors duration-300 hover:bg-violet focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Book Session</a>
                        </div>
                    </article>
                </li>
                <!-- Card 3 -->
                <li>
                    <article class="group flex h-full flex-col overflow-hidden rounded-lg bg-charcoal transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-neon/20">
                        <div class="relative aspect-[4/5] overflow-hidden bg-dark">
                            <img src="https://images.unsplash.com/photo-1770026136765-2343c441b9cb?q=80&w=800&auto=format&fit=crop" alt="Tetiana Shevchenko" class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                            <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/60 to-transparent"></div>
                            <span class="absolute left-4 top-4 rounded-md bg-neon px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-charcoal">Yoga</span>
                            
                            <div class="absolute bottom-0 left-0 p-6 w-full">
                                <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Tetiana Shevchenko</h3>
                                <p class="mt-2 text-sm leading-relaxed text-mono/70">Promotes joint longevity, posture alignment.</p>
                            </div>
                        </div>
                        <div class="p-6 pt-0 bg-charcoal mt-auto">
                            <a href="@Url.Action("Index", "Trainer")" class="inline-flex w-full items-center justify-center rounded-md border-2 border-neon px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-white transition-colors duration-300 hover:bg-neon hover:text-charcoal focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Book Session</a>
                        </div>
                    </article>
                </li>
            </ul>

            <div class="mt-14 flex justify-center">
                <a href="@Url.Action("Index", "Trainer")" class="inline-flex items-center gap-3 rounded-md border-2 border-white/20 px-10 py-5 text-sm font-extrabold uppercase tracking-widest text-white transition-colors duration-300 hover:border-neon hover:text-neon focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">
                    View All Coaches
                </a>
            </div>
        </div>
    </section>

    <!-- Pricing -->
    <section id="memberships" class="relative z-10 bg-charcoal py-24 sm:py-32" aria-labelledby="pricing-title">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <p class="mb-4 text-[10px] font-bold uppercase tracking-widest text-mono/60">03 &mdash; Membership</p>
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
                <h2 id="pricing-title" class="max-w-3xl text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-7xl lg:text-8xl">
                    No contracts. <span class="text-neon">No excuses.</span>
                </h2>
                <p class="text-[10px] font-bold uppercase tracking-widest text-mono/50 md:text-right">
                    No joining fee / 16+ / Cancel anytime
                </p>
            </div>

            <ul class="mt-16 grid items-stretch gap-6 lg:grid-cols-3">
                <li>
                    <article class="flex h-full flex-col rounded-lg border border-white/15 bg-dark p-8 transition-all duration-300 hover:-translate-y-1 hover:border-white/40">
                        <h3 class="text-sm font-extrabold uppercase tracking-widest text-mono/70">Basic</h3>
                        <p class="mt-1 text-sm text-mono/60">30 days</p>
                        <p class="mt-6 text-6xl font-black tracking-tighter sm:text-7xl">&#8372;30</p>
                        <ul class="mt-8 flex-1 space-y-4 text-sm text-mono/80">
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Gym access (8 AM - 10 PM)</li>
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Free locker</li>
                        </ul>
                        <a href="@Url.Action("Register", "Account")" class="mt-10 inline-flex items-center justify-center rounded-md border-2 border-white/30 px-5 py-4 text-xs font-extrabold uppercase tracking-widest text-white transition-colors duration-300 hover:border-neon hover:text-neon">Choose Basic</a>
                    </article>
                </li>
                <li>
                    <article class="relative flex h-full flex-col rounded-lg bg-neon p-8 text-charcoal transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-neon/30 lg:-my-4 lg:py-12">
                        <span class="absolute right-6 top-6 rounded-md bg-charcoal px-3 py-1 text-[11px] font-extrabold uppercase tracking-widest text-neon">Most chosen</span>
                        <h3 class="text-sm font-extrabold uppercase tracking-widest text-charcoal/70">Pro</h3>
                        <p class="mt-1 text-sm font-medium text-charcoal/70">90 days</p>
                        <p class="mt-6 text-6xl font-black tracking-tighter sm:text-7xl">&#8372;80</p>
                        <ul class="mt-8 flex-1 space-y-4 text-sm font-semibold">
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>24/7 Gym access</li>
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Group classes</li>
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Diet plan</li>
                        </ul>
                        <a href="@Url.Action("Register", "Account")" class="mt-10 inline-flex items-center justify-center rounded-md bg-charcoal px-5 py-4 text-xs font-extrabold uppercase tracking-widest text-neon transition-colors duration-300 hover:bg-white hover:text-charcoal">Choose Pro</a>
                    </article>
                </li>
                <li>
                    <article class="flex h-full flex-col rounded-lg border-2 border-violet bg-dark p-8 shadow-[0_0_40px_rgba(125,81,254,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_60px_rgba(125,81,254,0.4)]">
                        <h3 class="text-sm font-extrabold uppercase tracking-widest text-violet">Elite</h3>
                        <p class="mt-1 text-sm text-mono/60">365 days</p>
                        <p class="mt-6 text-6xl font-black tracking-tighter sm:text-7xl">&#8372;250</p>
                        <ul class="mt-8 flex-1 space-y-4 text-sm text-mono/80">
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-violet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>24/7 Gym &amp; Spa access</li>
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-violet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>10 personal sessions</li>
                            <li class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-violet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 7"/></svg>Free parking</li>
                        </ul>
                        <a href="@Url.Action("Register", "Account")" class="mt-10 inline-flex items-center justify-center rounded-md bg-violet px-5 py-4 text-xs font-extrabold uppercase tracking-widest text-white transition-all duration-300 hover:bg-electric">Choose Elite</a>
                    </article>
                </li>
            </ul>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="relative overflow-hidden bg-gradient-to-b from-charcoal via-dark to-graphite pt-24 pb-12 sm:pt-32 sm:pb-16" aria-labelledby="cta-title">
        <div class="relative z-10 mx-auto max-w-7xl px-4 text-center sm:px-6">
            <p class="mb-4 text-[10px] font-bold uppercase tracking-widest text-mono/60">04 &mdash; Intake</p>
            <h2 id="cta-title" class="mx-auto max-w-4xl text-5xl font-black uppercase leading-[0.88] tracking-tighter sm:text-7xl lg:text-8xl">
                The first session<br />is <span class="text-neon">on us.</span>
            </h2>
            <p class="mx-auto mt-6 max-w-xl text-sm text-mono/70 sm:text-base">
                Two hours with a coach, a full induction across every floor, and a recovery slot to close it out. No card, no contract, no commitment.
            </p>
            <a href="@Url.Action("Register", "Account")" class="mt-10 inline-flex items-center gap-4 rounded-md bg-neon px-8 py-6 text-lg font-black uppercase tracking-widest text-charcoal shadow-2xl shadow-neon/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-neon/40 sm:px-12 sm:py-7 sm:text-xl">
                Claim Your First Session
                <svg class="h-6 w-6 sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
        </div>
    </section>
</main>