@{
    ViewData["Title"] = "Certified Trainers";
}

<div class="py-4">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Expert Team</span>
        <h1 class="display-5 fw-bold">Certified Coaches & Trainers</h1>
        <p class="lead text-muted mx-auto" style="max-width: 650px;">
            Work with world-class fitness professionals dedicated to helping you reach your peak performance, rehabilitation, and lifestyle goals.
        </p>
    </div>

    <!-- Filter Buttons -->
    <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap">
        <button class="btn btn-outline-dark active rounded-pill px-4 filter-btn" data-filter="all">All Specialties</button>
        <button class="btn btn-outline-dark rounded-pill px-4 filter-btn" data-filter="strength">Strength & Power</button>
        <button class="btn btn-outline-dark rounded-pill px-4 filter-btn" data-filter="crossfit">CrossFit & HIIT</button>
        <button class="btn btn-outline-dark rounded-pill px-4 filter-btn" data-filter="bodybuilding">Bodybuilding</button>
        <button class="btn btn-outline-dark rounded-pill px-4 filter-btn" data-filter="yoga">Yoga & Mobility</button>
    </div>

    <!-- Trainers Grid -->
    <div class="row g-4" id="trainersGrid">
        <!-- Trainer 1 -->
        <div class="col-lg-3 col-md-6 trainer-card" data-category="strength">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="position-relative bg-light text-center p-4">
                    <img src="https://images.unsplash.com/photo-1567013127542-490d757e51fc?w=400&auto=format&fit=crop&q=80" 
                         alt="Alex Mercer" class="rounded-circle shadow object-fit-cover" width="140" height="140">
                    <span class="position-absolute top-0 end-0 m-3 badge bg-success">Available</span>
                </div>
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold mb-1">Alex Mercer</h5>
                    <p class="text-primary small fw-semibold mb-2">Head Strength & Conditioning Coach</p>
                    <p class="card-text text-muted small mb-3">
                        Former national powerlifting champion. 8+ years coaching athletes, mastering deadlifts, squats, and bench press biomechanics.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge bg-light text-dark border">CSCS</span>
                        <span class="badge bg-light text-dark border">USAPL</span>
                        <span class="badge bg-light text-dark border">8 yrs exp</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-dark btn-sm rounded-pill">Book Session</a>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-chat me-1"></i>Message</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainer 2 -->
        <div class="col-lg-3 col-md-6 trainer-card" data-category="crossfit">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="position-relative bg-light text-center p-4">
                    <img src="https://images.unsplash.com/photo-1548690312-e3b507d8c110?w=400&auto=format&fit=crop&q=80" 
                         alt="Sarah Jenkins" class="rounded-circle shadow object-fit-cover" width="140" height="140">
                    <span class="position-absolute top-0 end-0 m-3 badge bg-primary">Popular</span>
                </div>
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold mb-1">Sarah Jenkins</h5>
                    <p class="text-primary small fw-semibold mb-2">CrossFit Level 2 & HIIT Lead</p>
                    <p class="card-text text-muted small mb-3">
                        Specializes in functional threshold training, stamina development, and high-intensity body composition transformations.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge bg-light text-dark border">CrossFit L2</span>
                        <span class="badge bg-light text-dark border">NASM-CPT</span>
                        <span class="badge bg-light text-dark border">6 yrs exp</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-dark btn-sm rounded-pill">Book Session</a>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-chat me-1"></i>Message</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainer 3 -->
        <div class="col-lg-3 col-md-6 trainer-card" data-category="bodybuilding">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="position-relative bg-light text-center p-4">
                    <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=400&auto=format&fit=crop&q=80" 
                         alt="Marcus Thorne" class="rounded-circle shadow object-fit-cover" width="140" height="140">
                    <span class="position-absolute top-0 end-0 m-3 badge bg-success">Available</span>
                </div>
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold mb-1">Marcus Thorne</h5>
                    <p class="text-primary small fw-semibold mb-2">Bodybuilding & Hypertrophy Specialist</p>
                    <p class="card-text text-muted small mb-3">
                        Expert in muscle mass building, precision nutrition macros, and physique preparation for amateurs and competitive athletes.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge bg-light text-dark border">IFBB Pro</span>
                        <span class="badge bg-light text-dark border">ISSA Master</span>
                        <span class="badge bg-light text-dark border">10 yrs exp</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-dark btn-sm rounded-pill">Book Session</a>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-chat me-1"></i>Message</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainer 4 -->
        <div class="col-lg-3 col-md-6 trainer-card" data-category="yoga">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="position-relative bg-light text-center p-4">
                    <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?w=400&auto=format&fit=crop&q=80" 
                         alt="Elena Rostova" class="rounded-circle shadow object-fit-cover" width="140" height="140">
                    <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark">VIP Coach</span>
                </div>
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold mb-1">Elena Rostova</h5>
                    <p class="text-primary small fw-semibold mb-2">Mobility, Yoga & Rehab Director</p>
                    <p class="card-text text-muted small mb-3">
                        Dedicated to joint longevity, deep core stability, and post-injury athletic recovery through breathwork and movement science.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge bg-light text-dark border">RYT-500</span>
                        <span class="badge bg-light text-dark border">FRC®</span>
                        <span class="badge bg-light text-dark border">7 yrs exp</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Schedule" asp-action="Index" class="btn btn-dark btn-sm rounded-pill">Book Session</a>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-chat me-1"></i>Message</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Join Team CTA -->
    <div class="card bg-dark text-white border-0 rounded-4 mt-5 p-4 p-md-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h3 class="fw-bold mb-2">Want to Join SportLab Coaching Team?</h3>
                <p class="text-white-50 mb-0">We are constantly seeking certified fitness professionals with a passion for client results.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Chat" asp-action="Index" class="btn btn-light rounded-pill px-4 fw-semibold">Apply as Coach</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.filter-btn').forEach(button => {
        button.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active', 'btn-dark'));
            button.classList.add('active', 'btn-dark');

            const filter = button.getAttribute('data-filter');
            const cards = document.querySelectorAll('.trainer-card');

            cards.forEach(card => {
                if (filter === 'all' || card.getAttribute('data-category') === filter) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
