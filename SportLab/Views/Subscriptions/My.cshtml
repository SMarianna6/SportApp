@model List<SportLab.Models.Subscription>
@{
    ViewData["Title"] = "My Memberships";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-4xl">

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Client Area</p>
                <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">My Memberships</h1>
                <p class="mt-1 text-sm text-white/50">Your active and previous gym memberships.</p>
            </div>
            <a asp-controller="Tariff" asp-action="Index" class="rounded-md bg-neon px-4 py-2.5 text-xs font-extrabold uppercase tracking-widest text-black transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neon/30">
                Buy a Membership
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-lg border border-dashed border-white/10 p-12 text-center">
                <svg class="mx-auto mb-4 h-12 w-12 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
                <p class="text-sm font-semibold text-white/40">You have not purchased a membership yet.</p>
                <a asp-controller="Tariff" asp-action="Index" class="mt-4 inline-block text-xs font-bold uppercase tracking-widest text-neon hover:underline">View tariffs</a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var subscription in Model)
                {
                    var expired = subscription.EndDate.Date < DateTime.Today;
                    var isActive = subscription.IsActive && !expired;

                    <div class="rounded-lg border @(isActive ? "border-neon/40 bg-neon/5" : "border-white/10 bg-[#1a1a1a]") p-5">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="font-black uppercase tracking-tight">@(subscription.Plan?.Name ?? "Membership")</p>
                                <p class="text-xs text-white/50">@(subscription.Plan?.Type ?? "Plan") · @(subscription.Plan?.Description)</p>
                            </div>
                            <span class="rounded-md px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest @(isActive ? "bg-neon/20 text-neon" : "bg-white/10 text-white/50")">
                                @(isActive ? "Active" : expired ? "Expired" : "Inactive")
                            </span>
                        </div>

                        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Start date</p>
                                <p class="font-semibold">@subscription.StartDate.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">End date</p>
                                <p class="font-semibold">@subscription.EndDate.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Price</p>
                                <p class="font-semibold">@(subscription.Plan?.Price.ToString("0.00") ?? "—") UAH</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
