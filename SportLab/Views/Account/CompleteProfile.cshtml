@{
    ViewData["Title"] = "Complete Your Profile";
    Layout = null;
}
@model SportLab.Models.User

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/page.css" asp-append-version="true" />
</head>
<body class="bg-black text-light m-0 p-0">

    <div class="container-fluid d-flex align-items-center justify-content-center min-vh-100" style="background-color: #121212;">
        <div class="w-100" style="max-width: 420px;">

            <div class="card p-4 rounded-4 shadow-lg text-light" style="background-color: #1e1e1e; border: 1px solid #2d2d2d;">
                <h3 class="mb-2 text-center fw-bold text-white">WELCOME!</h3>
                <p class="text-muted text-center small mb-4">You can set up your profile details now or skip this step.</p>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label text-light small fw-semibold">Full Name</label>
                        <input type="text" name="name" class="form-control bg-dark text-light border-secondary" value="@Model.Name" placeholder="Enter your name">
                        <div class="form-text text-muted" style="font-size: 0.75rem;">If left blank, it will default to your email prefix.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light small fw-semibold">Current Weight (kg)</label>
                        <input type="number" step="0.1" name="initialWeight" class="form-control bg-dark text-light border-secondary" placeholder="e.g. 75.5" min="20" max="300">
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2 py-2 fw-bold rounded-pill shadow-sm">Save & Continue</button>
                    <a asp-controller="Profile" asp-action="Client" class="btn btn-outline-light w-100 py-2 rounded-pill">Skip for now</a>
                </form>
            </div>

        </div>
    </div>

</body>
</html>
