@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/sporthub.css" asp-append-version="true" />

<div class="sh-page sh-denied">
    <div class="sh-denied-card">
        <div class="sh-modal-bar sh-denied-bar"></div>

        <div class="sh-denied-icon" aria-hidden="true">
            <svg class="sh-ico sh-denied-lock" viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
        </div>

        <p class="sh-denied-code" aria-hidden="true">403</p>
        <h1 class="sh-denied-title">Access Denied</h1>
        <p class="sh-denied-text">
            You do not have the required permissions to view this page.
            If you believe this is a mistake, please contact support.
        </p>

        <div class="sh-denied-actions">
            <a href="/" class="sh-btn sh-btn-primary sh-denied-btn">
                <svg class="sh-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>Go Back Home
            </a>
        </div>
    </div>
</div>
