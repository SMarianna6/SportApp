@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex min-h-[70vh] items-center justify-center px-4">
    <div class="text-center">
        <p class="text-xs font-extrabold uppercase tracking-widest text-red-400">403 Forbidden</p>
        <h1 class="mt-2 text-6xl font-black uppercase tracking-tighter text-white">Access Denied</h1>
        <p class="mx-auto mt-4 max-w-sm text-sm text-white/50">
            You do not have permission to view this page.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <a asp-controller="Home" asp-action="Index" class="rounded-md bg-neon px-6 py-3 text-sm font-extrabold uppercase tracking-widest text-black transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neon/30">
                Go Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="rounded-md border border-white/20 px-6 py-3 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:border-neon hover:text-neon">
                Sign In
            </a>
        </div>
    </div>
</div>
