@model SportLab.Models.User
@{
    ViewData["Title"] = "Log in Page";
}

<link rel="stylesheet" href="~/css/page.css" asp-append-version="true" />

<div class="login-page-wrapper">
    <div class="login-card">
        <h3 class="mb-3 text-center">LOG IN</h3>

        <form method="post" autocomplete="off">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small text-center"></div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="off">
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password">
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <input type="submit" class="btn btn-primary w-100 mb-3" value="Log in">
        </form>

        <div class="text-center">
            <h5 class="fs-6 text-muted">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold text-decoration-none">Sign up</a></h5>
        </div>
    </div>
</div>