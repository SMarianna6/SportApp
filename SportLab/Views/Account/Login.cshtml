@model SportLab.Models.User
@{
    ViewData["Title"] = "Log in Page";
}

<link rel="stylesheet" href="~/css/page.css" asp-append-version="true" />

<div class="login-page-wrapper">
    <div class="login-card">
        <h3 class="mb-3 text-center">LOG IN</h3>

        <form method="post" autocomplete="off">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small text-center"></div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="off">
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password">
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <input type="submit" class="btn btn-primary w-100 mb-2" value="Log in">
        </form>

        <div class="text-center my-1">
            <span class="text-muted small">OR</span>
        </div>

        <a asp-action="ExternalLogin" asp-route-provider="Google" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2 py-2 mb-2 rounded-pill text-dark text-decoration-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            <span class="fw-semibold">Continue with Google</span>
        </a>

        <div class="text-center">
            <h5 class="fs-6 text-muted">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold text-decoration-none">Sign up</a></h5>
        </div>
    </div>
</div>