@using SportLab.Models
@{
    string userRole =
        User.IsAdmin() ? Roles.Administrator :
        User.IsInRole(Roles.Trainer) ? Roles.Trainer :
        User.IsInRole(Roles.Moderator) ? Roles.Moderator :
        Roles.Client;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportHUB</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        shell: '#141414',
                        main: '#1a1a1a',
                        surface: '#333333',
                        neon: '#AAFF00',
                        violet: '#7D51FE',
                        ink: '#F2F2F4'
                    },
                    fontFamily: {
                        sans: ['Archivo', 'ui-sans-serif', 'system-ui', '-apple-system', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <style>
        html { color-scheme: dark; }
        * { scrollbar-width: thin; scrollbar-color: #444 #141414; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #141414; }
        ::-webkit-scrollbar-thumb { background: #444; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #AAFF00; }
        #sidebar { transition: transform .25s ease, width .25s ease; will-change: transform; }
        body.collapsed .nav-label, body.collapsed .brand-text { display: none; }
        body.collapsed .nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
        .nav-link[aria-current="page"] { color: #AAFF00; background: #1c1c1c; box-shadow: inset 4px 0 0 #AAFF00; }
    </style>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-main font-sans text-white antialiased">
    <!-- Mobile overlay -->
    <div id="overlay" class="fixed inset-0 z-30 hidden bg-black/70 lg:hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full transform-gpu flex-col bg-shell lg:translate-x-0" aria-label="Sidebar">
        <div class="flex h-16 shrink-0 items-center justify-between px-5">
            <a href="@Url.Action("Index", "Home")" class="flex items-center gap-2 text-xl font-black uppercase tracking-tighter">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-neon text-shell">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>
                </span>
                <span class="brand-text">Sport<span class="text-neon">HUB</span></span>
            </a>
            <button id="close-mobile" type="button" class="rounded-md p-2 text-mono hover:text-neon lg:hidden" aria-label="Close menu">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>

        <nav class="mt-4 flex-1 overflow-y-auto" aria-label="Main">
            <ul class="space-y-1">
                @if (userRole == Roles.Administrator)
                {
                    <!-- ADMIN MENU -->
                    <li>
                        <a href="@Url.Action("Index", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Dashboard">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Users", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Users">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span class="nav-label">Users</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Tariffs", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Tariffs" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Tariffs">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            <span class="nav-label">Tariffs</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Shop", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Shop" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Shop">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            <span class="nav-label">Shop</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Schedule", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Schedule">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            <span class="nav-label">Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("FAQ", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "FAQ" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="FAQ">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            <span class="nav-label">FAQ</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Moderation")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Review Moderation">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                            <span class="nav-label">Moderation</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Messages")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Messages">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                            <span class="nav-label">Messages</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Settings", "Admin")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "text-neon bg-[#1c1c1c] shadow-[inset_4px_0_0_#AAFF00]" : "")" title="Settings">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
                            <span class="nav-label">Settings</span>
                        </a>
                    </li>
                }
                else if (userRole == Roles.Trainer)
                {
                    <!-- TRAINER MENU -->
                    <li>
                        <a href="@Url.Action("Trainer", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Dashboard">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Schedule", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Schedule">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            <span class="nav-label">Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Clients", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Clients">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3.1-6.5 7-6.5s7 2.5 7 6.5M16 4.2a4 4 0 0 1 0 7.6M22 21c0-3-1.7-5-4-6"/></svg>
                            <span class="nav-label">Clients</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Messages")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Messages">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                            <span class="nav-label">Messages</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Settings", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Settings">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
                            <span class="nav-label">Settings</span>
                        </a>
                    </li>
                }
                else
                {
                    <!-- CLIENT MENU -->
                    <li>
                        <a href="@Url.Action("Client", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Dashboard">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Schedule", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Schedule">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            <span class="nav-label">Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "MetricLogs")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="My Progress">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                            <span class="nav-label">My Progress</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Messages")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Messages">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                            <span class="nav-label">Messages</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Settings", "Profile")" class="nav-link flex items-center gap-3 px-5 py-3 text-sm font-bold uppercase tracking-wider text-mono transition-colors hover:text-neon" title="Settings">
                            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
                            <span class="nav-label">Settings</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
        
        <button id="collapse-toggle" type="button" class="hidden h-12 shrink-0 items-center justify-center gap-2 text-xs font-bold uppercase tracking-widest text-mono/70 transition-colors hover:text-neon lg:flex">
            <svg id="collapse-icon" class="h-5 w-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
            <span class="nav-label">Collapse</span>
        </button>
    </aside>

    <!-- Content wrapper -->
    <div id="content" class="min-h-screen lg:pl-64" style="transition: padding-left .25s ease">
        <header class="relative z-30 flex h-16 shrink-0 items-center gap-4 border-b border-white/10 bg-shell px-4 md:px-6">
            @if (userRole == Roles.Administrator)
            {
                <div class="relative w-full max-w-md" id="global-search-container">
                    <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" id="global-search-input" autocomplete="off" placeholder="Search users, products..." class="h-10 w-full border border-white/10 bg-main pl-10 pr-3 text-sm text-ink placeholder:text-ink/40 focus:border-neon focus:outline-none" />

                    <div id="search-results" class="absolute inset-x-0 top-12 border border-white/10 bg-surface shadow-2xl hidden z-50">
                    </div>
                </div>
            }
            else
            {
                <div class="flex-1"></div>
            }

            <div class="ml-auto flex items-center gap-3">
                    <div class="relative" id="notification-wrapper">
                    <button id="notification-btn" aria-label="Notifications" class="relative p-2 text-ink/70 transition-colors hover:text-neon focus:outline-none focus:ring-2 focus:ring-neon rounded-full">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                        <span id="notification-badge" class="absolute right-1 top-1 hidden h-2.5 w-2.5 rounded-full bg-violet ring-2 ring-shell"></span>
                    </button>
                    
                    <div id="notification-dropdown" class="absolute right-0 top-full mt-2 hidden w-80 flex-col border border-white/10 bg-surface shadow-2xl z-50 rounded-lg overflow-hidden">
                        <div class="flex items-center justify-between border-b border-white/10 bg-[#222] px-4 py-3">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-ink">Notifications</h3>
                            <span id="notification-count" class="text-xs font-bold text-neon"></span>
                        </div>
                        <div id="notification-list" class="max-h-80 overflow-y-auto divide-y divide-white/5">
                            <div class="p-4 text-center text-sm text-ink/50 animate-pulse">Loading...</div>
                        </div>
                    </div>
                </div>

               <div class="relative group">
                    <button class="flex items-center gap-3 p-1 transition-colors hover:bg-white/5 focus:outline-none rounded-full lg:rounded-md">
                        @await Component.InvokeAsync("UserAvatar")
                        
                        <div class="hidden text-left sm:block pr-2">
                            <span class="block text-sm font-bold text-ink">@User.Identity?.Name?.Split('@')[0]</span>
                            <span class="block text-[11px] uppercase text-ink/50">@userRole</span>
                        </div>
                        <svg class="hidden lg:block h-4 w-4 text-ink/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
    
                    <div class="absolute right-0 top-full mt-2 hidden w-48 flex-col border border-white/10 bg-surface shadow-2xl group-focus-within:flex hover:flex z-50 rounded-lg overflow-hidden">
                        <a href="@Url.Action("Settings", userRole == Roles.Administrator ? "Admin" : "Profile")" class="flex w-full items-center gap-2 px-3 py-2.5 text-sm text-ink hover:bg-white/5 transition-colors">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
                            Settings
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 border-t border-white/10">
                            <button type="submit" class="flex w-full items-center gap-2 px-3 py-2.5 text-sm text-ink hover:bg-white/5 transition-colors text-left">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Log out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="p-4 sm:p-6">
            @RenderBody()
        </main>
    </div>

    <!-- Layout Scripts -->
    <script>
                // --- NOTIFICATION SYSTEM ---
        (function () {
            const btn = document.getElementById('notification-btn');
            const dropdown = document.getElementById('notification-dropdown');
            const list = document.getElementById('notification-list');
            const badge = document.getElementById('notification-badge');
            const countEl = document.getElementById('notification-count');
            
            if(!btn) return;

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('hidden');
                if (!dropdown.classList.contains('hidden')) {
                    loadNotifications();
                }
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            });

            async function loadNotifications() {
                try {
                    const res = await fetch('/Notification/GetNotifications');
                    const data = await res.json();
                    
                    if (data.success && data.count > 0) {
                        badge.classList.remove('hidden');
                        countEl.textContent = data.count + ' new';

                        list.innerHTML = data.items.map(item => {
                            let icon = '<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>';
                            let color = 'text-blue-400';
                            
                            if (item.type === 'workout') { 
                                icon = '<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11"/></svg>'; 
                                color = 'text-neon'; 
                            }
                            if (item.type === 'danger') { 
                                icon = '<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>'; 
                                color = 'text-[#FF5252]'; 
                            }
                            if (item.type === 'warning') { 
                                icon = '<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg>'; 
                                color = 'text-yellow-400'; 
                            }

                            return `
                                <a href="${item.url}" class="flex items-start gap-3 p-3 hover:bg-white/5 transition-colors group border-l-2 border-transparent hover:border-neon">
                                    <div class="shrink-0 mt-0.5 ${color}">${icon}</div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-bold text-white mb-0.5">${item.title}</p>
                                        <p class="text-[11px] text-ink/60 line-clamp-2">${item.text}</p>
                                    </div>
                                </a>
                            `;
                        }).join('');
                    } else {
                        badge.classList.add('hidden');
                        list.innerHTML = '<div class="p-6 text-center text-sm text-ink/40"><svg class="mx-auto h-8 w-8 mb-2 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>All caught up!</div>';
                    }
                } catch(e) {
                    console.error('Notification error', e);
                }
            }

            fetch('/Notification/GetNotifications')
                .then(res => res.json())
                .then(data => {
                    if (data.count > 0) badge.classList.remove('hidden');
                }).catch(()=>{});
        })();

        (function () {
            'use strict';
            var body = document.body;
            var $ = function (id) { return document.getElementById(id); };
            var sidebar = $('sidebar'), overlay = $('overlay'), content = $('content');
            var collapseBtn = $('collapse-toggle'), collapseIcon = $('collapse-icon');
            var desktop = window.matchMedia('(min-width: 1024px)');

            function applyCollapse(collapsed) {
                body.classList.toggle('collapsed', collapsed);
                sidebar.style.width = collapsed ? '72px' : '';
                content.style.paddingLeft = desktop.matches ? (collapsed ? '72px' : '256px') : '';
                collapseIcon.style.transform = collapsed ? 'rotate(180deg)' : '';
                if(collapseBtn) collapseBtn.setAttribute('aria-expanded', String(!collapsed));
            }
            function setMobile(open) {
                sidebar.classList.toggle('-translate-x-full', !open);
                overlay.classList.toggle('hidden', !open);
            }
            if(collapseBtn) collapseBtn.addEventListener('click', function () { applyCollapse(!body.classList.contains('collapsed')); });
            if($('open-mobile')) $('open-mobile').addEventListener('click', function () { applyCollapse(false); setMobile(true); });
            if($('close-mobile')) $('close-mobile').addEventListener('click', function () { setMobile(false); });
            if(overlay) overlay.addEventListener('click', function () { setMobile(false); });
            desktop.addEventListener('change', function () { setMobile(false); applyCollapse(body.classList.contains('collapsed') && desktop.matches); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMobile(false); });
            content.style.paddingLeft = '';
        })();
    </script>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>