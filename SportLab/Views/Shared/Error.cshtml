@model ErrorViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h1 class="text-danger">@Localizer["Heading"]</h1>
<h2 class="text-danger">@Localizer["Intro"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>
    @Localizer["DevDescPart1"] <strong>@Localizer["DevDescBold"]</strong> @Localizer["DevDescPart2"]
</p>
<p>
    <strong>@Localizer["WarningBold"]</strong>
</p>
<p>
    @Localizer["WarningText"]
</p>
