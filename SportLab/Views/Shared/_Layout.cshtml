<!-- Booking modal -->
<div id="qb-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="qb-modal-title">
  <!-- Прибрано backdrop-blur-md для продуктивності, фон зроблено темнішим bg-black/90 -->
  <div id="qb-modal-backdrop" class="animate-fade-in absolute inset-0 bg-black/90"></div>
  
  <!-- Прибрано backdrop-blur-md, залишено суцільний темний фон bg-ink -->
  <div id="qb-scroll-area" class="animate-modal-in relative max-h-[92vh] w-full max-w-lg overflow-y-auto rounded-lg border border-white/10 bg-ink shadow-2xl shadow-black/80">
    <div class="h-1.5 w-full bg-gradient-to-r from-neon via-neon to-violet"></div>
    <button id="qb-modal-close" type="button" class="absolute right-3 top-4 rounded-md p-2 text-mono/60 transition-colors hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>

    <!-- Booking view -->
    <div id="qb-view-booking" class="p-6 sm:p-8">
      <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Quick booking</p>
      <h2 id="qb-modal-title" class="mt-1 text-4xl font-black uppercase tracking-tighter">Book a Session</h2>

      <form id="qb-booking-form" class="mt-6 space-y-4" novalidate>
        <div>
          <label for="qb-type" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-mono/70">Type</label>
          <div class="relative">
            <select id="qb-type" class="w-full appearance-none rounded-md border border-white/10 bg-card px-4 py-3 pr-10 text-sm font-semibold text-white transition-colors focus:border-neon focus:outline-none focus:ring-2 focus:ring-neon/30">
              <option value="">Select type</option>
              <option>Group Class</option>
              <option>Personal Training</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="qb-date" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-mono/70">Date</label>
            <div class="relative">
              <select id="qb-date" class="w-full appearance-none rounded-md border border-white/10 bg-card px-4 py-3 pr-10 text-sm font-semibold text-white transition-colors focus:border-neon focus:outline-none focus:ring-2 focus:ring-neon/30"></select>
              <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
            </div>
          </div>
          <div>
            <label for="qb-trainer" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-mono/70">Trainer</label>
            <div class="relative">
              <select id="qb-trainer" class="w-full appearance-none rounded-md border border-white/10 bg-card px-4 py-3 pr-10 text-sm font-semibold text-white transition-colors focus:border-neon focus:outline-none focus:ring-2 focus:ring-neon/30"></select>
              <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
            </div>
          </div>
        </div>
      </form>

      <!-- Slot preview -->
      <!-- Замінено transition-all на transition-colors -->
      <div id="qb-slot-card" class="mt-6 overflow-hidden rounded-lg border border-dashed border-white/20 bg-card/60 transition-colors duration-300">
        <div class="flex items-stretch">
          <div id="qb-slot-accent" class="w-1.5 bg-white/10 transition-colors duration-300"></div>
          <div class="flex-1 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p id="qb-slot-type" class="text-2xl font-black uppercase leading-none tracking-tighter text-white/30">Your slot</p>
                <p id="qb-slot-date" class="mt-1.5 text-sm font-semibold text-mono/40">Pick a date</p>
              </div>
              <span id="qb-slot-chip" class="rounded-md bg-white/10 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-widest text-mono/50">Draft</span>
            </div>
            <div class="mt-3 flex items-center gap-2.5">
              <span id="qb-slot-avatar" class="flex h-9 w-9 items-center justify-center rounded-md bg-white/10 text-xs font-black text-mono/40">?</span>
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-mono/40">Trainer</p>
                <p id="qb-slot-trainer" class="text-sm font-bold text-mono/40">Not selected</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Subscription status -->
      <div class="mt-6">
        <div class="mb-2 flex items-end justify-between">
          <p class="text-xs font-bold uppercase tracking-wider text-mono/70">Subscription</p>
          <p id="qb-visits-label" class="text-sm font-black tracking-tight"></p>
        </div>
        <div class="h-3 overflow-hidden rounded-md bg-card">
          <div id="qb-visits-bar" class="h-full rounded-md transition-all duration-700 ease-out" style="width:0%"></div>
        </div>
        <p id="qb-visits-hint" class="mt-1.5 text-xs font-medium text-mono/50"></p>
      </div>

      <!-- Оптимізована анімація для кнопки Confirm -->
      <button id="qb-submit-btn" type="button" class="mt-5 w-full rounded-md bg-neon py-3.5 text-base font-black uppercase tracking-wider text-ink shadow-lg shadow-neon/30 transition-[transform,colors,box-shadow] duration-300 transform-gpu will-change-transform hover:-translate-y-0.5 hover:shadow-xl hover:shadow-neon/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink">
        Confirm Booking
      </button>
    </div>

    <!-- No subscription view -->
    <div id="qb-view-nosub" class="hidden p-8 text-center sm:p-10">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-lg bg-card text-violet">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h2 class="text-3xl font-black uppercase tracking-tighter">No active subscription</h2>
      <p class="mx-auto mt-2 max-w-xs text-sm text-mono/60">You need an active membership to book sessions.</p>
      <button id="qb-buy-btn" type="button" class="mt-7 w-full rounded-md bg-neon py-4 text-lg font-black uppercase tracking-wider text-ink shadow-lg shadow-neon/30 transition-[transform,colors,box-shadow] duration-300 transform-gpu will-change-transform hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Buy Membership</button>
      <button id="qb-back-btn" type="button" class="mt-3 w-full rounded-md py-3 text-xs font-bold uppercase tracking-widest text-mono/60 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-neon">Back</button>
    </div>
  </div>
</div>

<!-- Toast container (Опущено нижче) -->
<div id="toasts" class="pointer-events-none fixed bottom-4 right-4 flex w-[calc(100%-2rem)] max-w-sm flex-col gap-3 sm:bottom-6 sm:right-6" style="z-index: 9999;" aria-live="polite" aria-atomic="false"></div>
    
<footer class="bg-dark text-light py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">SportHUB</h5>
                    <p class="text-white-50 small">Your ultimate fitness destination. We provide top-tier equipment, professional trainers, and a community that pushes you to be your best.</p>
                </div>
            
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Schedule" asp-action="Index" class="text-white-50 text-decoration-none">Workout Schedule</a></li>
                        <li class="mb-2"><a asp-controller="Trainer" asp-action="Index" class="text-white-50 text-decoration-none">Our Trainers</a></li>
                        <li class="mb-2"><a asp-controller="Tariff" asp-action="Index" class="text-white-50 text-decoration-none">Memberships</a></li>
                        <li class="mb-2"><a asp-controller="Shop" asp-action="Index" class="text-white-50 text-decoration-none">Sport Shop</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none">Shopping Cart</a></li>
                        <li class="mb-2"><a asp-controller="Faq" asp-action="Index" class="text-white-50 text-decoration-none">FAQ</a></li>
                    </ul>
                </div>
            
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">Contact Us</h5>
                    <ul class="list-unstyled text-white-50 small">
                        <li class="mb-2">📍 123 Fitness Avenue, Khmelnytskyi</li>
                        <li class="mb-2">📞 +380 (382) 123-45-67</li>
                        <li class="mb-2">✉️ support@sporthub.ua</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50 small">
                &copy; 2026 - SportHUB. Built for strength.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
      (function () {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('icon-open');
        const iconClose = document.getElementById('icon-close');
        if (!toggle || !menu) return;
        function setOpen(open) {
          menu.classList.toggle('grid-rows-[1fr]', open);
          menu.classList.toggle('grid-rows-[0fr]', !open);
          menu.setAttribute('aria-hidden', String(!open));
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          iconOpen.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
        }
        toggle.addEventListener('click', function () {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
          if (e.matches) setOpen(false);
        });
      })();

      // Sync cart count badge on page load
      document.addEventListener("DOMContentLoaded", function () {
          fetch('/Cart/GetCartSummary')
              .then(r => r.json())
              .then(data => {
                  const badge = document.getElementById("navCartBadge");
                  if (badge && data && data.totalCount > 0) {
                      badge.textContent = data.totalCount;
                      badge.classList.remove("hidden");
                  }
              })
              .catch(() => {});
      });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>