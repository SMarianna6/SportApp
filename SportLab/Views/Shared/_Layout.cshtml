<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportHUB</title>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportLab.styles.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-screen bg-mono-100 font-sans text-ink-900 antialiased">
    <header id="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-[#141414]/95 font-['Archivo'] backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6" aria-label="Main navigation">
        <a asp-controller="Home" asp-action="Index" class="text-2xl font-black uppercase tracking-tighter text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#AAFF00]">
          Sport<span class="text-[#AAFF00]">HUB</span>
        </a>
        
        <ul class="hidden items-center gap-8 md:flex">
          <li><a asp-controller="Home" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Home</a></li>
          <li><a asp-controller="Schedule" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Schedule</a></li>
          <li><a asp-controller="Tariff" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Tariffs</a></li>
          <li><a asp-controller="Trainer" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Trainers</a></li>
          <li><a asp-controller="Shop" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Shop</a></li>
          <li>
            <a asp-controller="Cart" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00] inline-flex items-center gap-1.5" id="navCartLink">
              <i class="bi bi-cart3"></i> Cart
              <span id="navCartBadge" class="hidden rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold text-white">0</span>
            </a>
          </li>
          <li><a asp-controller="Review" asp-action="Index" class="text-xs font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors duration-300 hover:text-[#AAFF00]">Reviews</a></li>
        </ul>
        
        <div class="hidden items-center gap-3 md:flex">
          @if (User.Identity?.IsAuthenticated == true)
          {
              <a asp-controller="Profile" asp-action="Client" aria-label="User profile" class="ml-1 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition-colors duration-300 hover:border-[#AAFF00] hover:text-[#AAFF00]">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
              </a>
              <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                  <button type="submit" class="px-3 py-2 text-xs font-semibold uppercase tracking-widest text-white transition-colors duration-300 hover:text-[#AAFF00]">Log Out</button>
              </form>
          }
          else
          {
              <a asp-controller="Account" asp-action="Login" class="px-3 py-2 text-xs font-semibold uppercase tracking-widest text-white transition-colors duration-300 hover:text-[#AAFF00]">Sign In</a>
              <a asp-controller="Account" asp-action="Register" class="rounded-md bg-[#AAFF00] px-5 py-2.5 text-xs font-extrabold uppercase tracking-widest text-[#141414] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#AAFF00]/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Sign Up</a>
          }
        </div>
        
        <button id="nav-toggle" type="button" class="flex h-10 w-10 items-center justify-center rounded-md text-white transition-colors hover:text-[#AAFF00] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#AAFF00] md:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
          <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </nav>
      
      <div id="mobile-menu" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out md:hidden" aria-hidden="true">
        <div class="overflow-hidden">
          <ul class="border-t border-white/10 px-4 py-3 sm:px-6">
            <li><a asp-controller="Home" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Home</a></li>
            <li><a asp-controller="Schedule" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Schedule</a></li>
            <li><a asp-controller="Tariff" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Tariffs</a></li>
            <li><a asp-controller="Trainer" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Trainers</a></li>
            <li><a asp-controller="Shop" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Shop</a></li>
            <li><a asp-controller="Cart" asp-action="Index" class="block border-b border-white/5 py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Cart</a></li>
            <li><a asp-controller="Review" asp-action="Index" class="block py-3.5 text-sm font-semibold uppercase tracking-widest text-[#F2F2F4] transition-colors hover:text-[#AAFF00]">Reviews</a></li>
            
            <li class="flex flex-col gap-3 pb-3 pt-4 border-t border-white/10">
              @if (User.Identity?.IsAuthenticated == true)
              {
                  <a asp-controller="Profile" asp-action="Client" class="flex-1 rounded-md border border-white/20 py-3 text-center text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-[#AAFF00] hover:text-[#AAFF00]">User Profile</a>
                  <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                      <button type="submit" class="w-full rounded-md bg-red-600/20 border border-red-500/50 py-3 text-center text-xs font-bold uppercase tracking-widest text-red-500 transition-colors hover:bg-red-600/40">Log Out</button>
                  </form>
              }
              else
              {
                  <div class="flex gap-3">
                      <a asp-controller="Account" asp-action="Login" class="flex-1 rounded-md border border-white/20 py-3 text-center text-xs font-bold uppercase tracking-widest text-white transition-colors hover:border-[#AAFF00] hover:text-[#AAFF00]">Sign In</a>
                      <a asp-controller="Account" asp-action="Register" class="flex-1 rounded-md bg-[#AAFF00] py-3 text-center text-xs font-extrabold uppercase tracking-widest text-[#141414]">Sign Up</a>
                  </div>
              }
            </li>
          </ul>
        </div>
      </div>
    </header>
    
    <div class="flex-grow w-full">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">SportHUB</h5>
                    <p class="text-white-50 small">Your ultimate fitness destination. We provide top-tier equipment, professional trainers, and a community that pushes you to be your best.</p>
                </div>
            
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Schedule" asp-action="Index" class="text-white-50 text-decoration-none">Workout Schedule</a></li>
                        <li class="mb-2"><a asp-controller="Trainer" asp-action="Index" class="text-white-50 text-decoration-none">Our Trainers</a></li>
                        <li class="mb-2"><a asp-controller="Tariff" asp-action="Index" class="text-white-50 text-decoration-none">Memberships</a></li>
                        <li class="mb-2"><a asp-controller="Shop" asp-action="Index" class="text-white-50 text-decoration-none">Sport Shop</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none">Shopping Cart</a></li>
                        <li class="mb-2"><a asp-controller="Faq" asp-action="Index" class="text-white-50 text-decoration-none">FAQ</a></li>
                    </ul>
                </div>
            
                <div class="col-md-4">
                    <h5 class="fw-bold text-white mb-3">Contact Us</h5>
                    <ul class="list-unstyled text-white-50 small">
                        <li class="mb-2">📍 123 Fitness Avenue, Khmelnytskyi</li>
                        <li class="mb-2">📞 +380 (382) 123-45-67</li>
                        <li class="mb-2">✉️ support@sporthub.ua</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50 small">
                &copy; 2026 - SportHUB. Built for strength.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
      (function () {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('icon-open');
        const iconClose = document.getElementById('icon-close');
        if (!toggle || !menu) return;
        function setOpen(open) {
          menu.classList.toggle('grid-rows-[1fr]', open);
          menu.classList.toggle('grid-rows-[0fr]', !open);
          menu.setAttribute('aria-hidden', String(!open));
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          iconOpen.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
        }
        toggle.addEventListener('click', function () {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
          if (e.matches) setOpen(false);
        });
      })();

      // Sync cart count badge on page load
      document.addEventListener("DOMContentLoaded", function () {
          fetch('/Cart/GetCartSummary')
              .then(r => r.json())
              .then(data => {
                  const badge = document.getElementById("navCartBadge");
                  if (badge && data && data.totalCount > 0) {
                      badge.textContent = data.totalCount;
                      badge.classList.remove("hidden");
                  }
              })
              .catch(() => {});
      });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>