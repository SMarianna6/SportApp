<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportLab</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportLab.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary rounded-3 px-2 py-1 fs-6"><i class="bi bi-activity"></i></span>
                    <span>SportLab</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Schedule" asp-action="Index">Schedule</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Tariff" asp-action="Index">Tariffs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Trainers">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Shop" asp-action="Index">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Chat" asp-action="Index">
                                <i class="bi bi-chat-dots me-1 text-primary"></i>Chat
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-dark position-relative px-3" asp-area="" asp-controller="Cart" asp-action="Index" id="navCartLink">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span id="navCartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 0.7rem;">0</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1 text-primary"></i>Profile
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Client"><i class="bi bi-person me-2"></i>Client Profile</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Trainer"><i class="bi bi-person-badge me-2"></i>Trainer Dashboard</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3 rounded-pill text-white" asp-area="" asp-controller="Account" asp-action="Register">Sign Up</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container pb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 bg-light">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 - SportLab - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
            <div class="d-flex align-items-center gap-3">
                <a class="text-muted text-decoration-none small" asp-controller="Admin" asp-action="Index"><i class="bi bi-gear-fill me-1"></i>Club Admin</a>
                <a class="text-muted text-decoration-none small" asp-controller="Profile" asp-action="Trainer"><i class="bi bi-person-workspace me-1"></i>Trainer Portal</a>
                <a class="text-muted text-decoration-none small" asp-controller="Chat" asp-action="Index"><i class="bi bi-headset me-1"></i>Help Desk</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
