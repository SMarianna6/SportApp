<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - SportHUB</title>

    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Archivo', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
                    colors: { neon: '#AAFF00', charcoal: '#141414' }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light text-dark font-sans antialiased d-flex flex-column min-vh-100">

    <header class="sticky top-0 z-50 border-b border-white/10 bg-charcoal">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
            <div class="flex items-center gap-2 text-2xl font-black uppercase tracking-tighter text-white select-none">
                <span>Sport<span class="text-neon">HUB</span></span>
                <span class="text-sm font-semibold tracking-normal text-white/60">ADMIN</span>
            </div>
        </div>
    </header>

    <main class="flex-grow py-5">
        <div class="container mx-auto px-4" style="max-width: 1200px;">
            @RenderBody()
        </div>
    </main>

    <footer class="py-4 text-center bg-charcoal text-white/60 border-t border-white/10 mt-auto">
        <small>&copy; 2026 SportHUB. Admin Panel.</small>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
