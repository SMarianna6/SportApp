@model List<SportLab.Models.Review>
@{
    ViewData["Title"] = "Review Moderation";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var pending = Model.Count(r => r.ModerationStatus == "Pending");
    var published = Model.Count(r => r.ModerationStatus == "Approved" || r.ModerationStatus == "Published");
    var hidden = Model.Count(r => r.ModerationStatus == "Hidden");
}

<div class="min-h-screen bg-[#111] text-white px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-5xl">

        <div class="mb-8">
            <p class="text-xs font-extrabold uppercase tracking-widest text-neon">Moderator Panel</p>
            <h1 class="mt-1 text-4xl font-black uppercase tracking-tighter">Review Moderation</h1>
            <p class="mt-1 text-sm text-white/50">Approve, hide or delete reviews submitted by clients.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-neon/30 bg-neon/10 px-4 py-3 text-sm font-semibold text-neon">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Pending</p>
                <p class="mt-1 text-3xl font-black text-neon">@pending</p>
            </div>
            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Published</p>
                <p class="mt-1 text-3xl font-black text-green-400">@published</p>
            </div>
            <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40">Hidden</p>
                <p class="mt-1 text-3xl font-black text-red-400">@hidden</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-lg border border-dashed border-white/10 p-12 text-center">
                <svg class="mx-auto mb-4 h-12 w-12 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                <p class="text-sm font-semibold text-white/40">No reviews to moderate yet.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var review in Model)
                {
                    var statusClass =
                        review.ModerationStatus == "Pending" ? "bg-yellow-500/20 text-yellow-300" :
                        review.ModerationStatus == "Hidden" ? "bg-red-500/20 text-red-400" :
                        "bg-green-500/20 text-green-400";

                    <div class="rounded-lg border border-white/10 bg-[#1a1a1a] p-5">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="font-black uppercase tracking-tight">@(review.User?.Name ?? "Unknown client")</p>
                                <p class="text-xs text-white/40">@review.User?.Email</p>
                                <p class="mt-2 text-xs text-white/40">@review.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                            <div class="text-right">
                                <span class="rounded-md px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest @statusClass">
                                    @review.ModerationStatus
                                </span>
                                <p class="mt-2 text-sm font-bold text-yellow-300">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= review.Rating ? "" : "text-white/20")">&#9733;</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <p class="mt-4 whitespace-pre-line border-l-2 border-white/10 pl-4 text-sm text-white/70">@review.Comment</p>

                        <div class="mt-5 flex flex-wrap gap-2">
                            @if (review.ModerationStatus != "Approved" && review.ModerationStatus != "Published")
                            {
                                <form asp-action="Approve" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button type="submit" class="rounded-md bg-green-500/20 px-4 py-2 text-xs font-bold uppercase tracking-widest text-green-400 transition-colors hover:bg-green-500/30">
                                        Approve
                                    </button>
                                </form>
                            }
                            @if (review.ModerationStatus != "Hidden")
                            {
                                <form asp-action="Hide" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button type="submit" class="rounded-md bg-yellow-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-yellow-300 transition-colors hover:bg-yellow-500/20">
                                        Hide
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this review permanently?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@review.Id" />
                                <button type="submit" class="rounded-md bg-red-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-red-400 transition-colors hover:bg-red-500/20">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
